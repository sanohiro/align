fn add_one(x: i64) -> i64 = x + 1

fn main() -> i32 {
  mut builder: array_builder<i64> := array_builder()
  mut i := 0
  loop {
    builder.push(i)
    i = i + 1
    if i >= 65536 { break }
  }
  xs := builder.build()
  ys := xs.par_map(add_one)
  if ys[0] == 1 && ys[65535] == 65536 {
    return 0
  }
  return 73
}
