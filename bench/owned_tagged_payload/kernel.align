ScalarRow { n: i64 }
TaggedRow { detail: Option<string>, n: i64 }
Pair { first: string, detail: Option<string> }
Choice { Reuse, Fresh }
NativeError { code: Option<string>, message: string }
DbError { Native(NativeError), Decode(string) }
MultiError { Both(string, string), Empty }
Output { text: string, note: Option<string> }

pub fn scalar_rows(reps: i64) -> i64 {
  mut i := 0
  mut total := 0
  return loop {
    if i >= reps { break total }
    row := ScalarRow { n: i % 17 }
    total = total + row.n
    i = i + 1
  }
}

pub fn tagged_none(reps: i64) -> i64 {
  mut i := 0
  mut total := 0
  return loop {
    if i >= reps { break total }
    row := TaggedRow { detail: None, n: i % 17 }
    total = total + row.n
    i = i + 1
  }
}

pub fn tagged_some(reps: i64) -> i64 {
  mut i := 0
  mut total := 0
  return loop {
    if i >= reps { break total }
    row := TaggedRow { detail: Some("payload".clone()), n: i % 17 }
    total = total + row.n
    i = i + 1
  }
}

pub fn tagged_sparse(reps: i64) -> i64 {
  mut i := 0
  mut total := 0
  return loop {
    if i >= reps { break total }
    if i % 100 == 0 {
      row := TaggedRow { detail: Some("payload".clone()), n: i % 17 }
      total = total + row.n
    } else {
      row := TaggedRow { detail: None, n: i % 17 }
      total = total + row.n
    }
    i = i + 1
  }
}

pub fn tagged_replace(reps: i64) -> i64 {
  mut i := 0
  mut total := 0
  return loop {
    if i >= reps { break total }
    mut row := TaggedRow { detail: Some("old".clone()), n: i % 17 }
    row.detail = Some("new".clone())
    row.detail = None
    row.detail = Some("final".clone())
    total = total + row.n
    i = i + 1
  }
}

pub fn tagged_conditional_replace(reps: i64) -> i64 {
  mut i := 0
  mut total := 0
  return loop {
    if i >= reps { break total }
    mut row := TaggedRow { detail: Some("old".clone()), n: i % 17 }
    row.detail = if i % 2 == 0 { row.detail } else { Some("new".clone()) }
    total = total + row.n
    i = i + 1
  }
}

pub fn tagged_match_loop_replace(reps: i64) -> i64 {
  mut i := 0
  mut total := 0
  return loop {
    if i >= reps { break total }
    choice := if i % 2 == 0 { Choice.Reuse } else { Choice.Fresh }
    mut matched := TaggedRow { detail: Some("old".clone()), n: i % 17 }
    matched.detail = match choice {
      Reuse => matched.detail
      Fresh => Some("new".clone())
    }
    mut looped := TaggedRow { detail: Some("old".clone()), n: i % 17 }
    looped.detail = loop {
      if i % 2 == 0 { break looped.detail }
      break Some("new".clone())
    }
    total = total + matched.n
    i = i + 1
  }
}

fn fail_string() -> Result<string, Error> = Err(error(17))

fn construct_then_fail() -> Result<i64, Error> {
  pair := Pair { first: "first".clone(), detail: Some(fail_string()?) }
  return Ok(pair.first.len())
}

pub fn tagged_early_try(reps: i64) -> i64 {
  mut i := 0
  mut total := 0
  return loop {
    if i >= reps { break total }
    total = total + (construct_then_fail() else 0)
    i = i + 1
  }
}

fn fail_owned_error() -> Result<i64, string> = Err("boom".clone())

fn relay_owned_error() -> Result<i64, string> {
  result := fail_owned_error()
  value := result?
  return Ok(value)
}

pub fn tagged_move_error_try(reps: i64) -> i64 {
  mut i := 0
  mut total := 0
  return loop {
    if i >= reps { break total }
    total = total + match relay_owned_error() {
      Ok(value) => value
      Err(message) => message.len()
    }
    i = i + 1
  }
}

fn db_result(mode: i64) -> Result<i64, DbError> {
  if mode == 0 { return Ok(1) }
  if mode == 1 {
    return Err(DbError.Native(NativeError {
      code: Some("7".clone()),
      message: "native".clone(),
    }))
  }
  return Err(DbError.Decode("decode".clone()))
}

pub fn tagged_recursive_ok(reps: i64) -> i64 {
  mut i := 0
  mut total := 0
  return loop {
    if i >= reps { break total }
    total = total + match db_result(0) {
      Ok(value) => value
      Err(error) => 90
    }
    i = i + 1
  }
}

pub fn tagged_recursive_native_error(reps: i64) -> i64 {
  mut i := 0
  mut total := 0
  return loop {
    if i >= reps { break total }
    total = total + match db_result(1) {
      Ok(value) => 90
      Err(error) => match error {
        Native(native) => 3
        Decode(message) => 91
      }
    }
    i = i + 1
  }
}

pub fn tagged_recursive_decode_error(reps: i64) -> i64 {
  mut i := 0
  mut total := 0
  return loop {
    if i >= reps { break total }
    total = total + match db_result(2) {
      Ok(value) => 90
      Err(error) => match error {
        Native(native) => 91
        Decode(message) => message.len()
      }
    }
    i = i + 1
  }
}

pub fn tagged_recursive_else(reps: i64) -> i64 {
  mut i := 0
  mut total := 0
  return loop {
    if i >= reps { break total }
    value := db_result(1) else 7
    total = total + value
    i = i + 1
  }
}

fn wrap_db_error(message: string) -> DbError = DbError.Decode(message)

pub fn tagged_recursive_map_err(reps: i64) -> i64 {
  mut i := 0
  mut total := 0
  return loop {
    if i >= reps { break total }
    total = total + match fail_owned_error().map_err(wrap_db_error) {
      Ok(value) => 90
      Err(error) => match error {
        Native(native) => 91
        Decode(message) => message.len()
      }
    }
    i = i + 1
  }
}

fn nested_db_result(mode: i64) -> Result<Option<Output>, DbError> {
  if mode == 0 { return Ok(None) }
  if mode == 1 {
    return Ok(Some(Output {
      text: "row".clone(),
      note: Some("note".clone()),
    }))
  }
  if mode == 2 { return Err(DbError.Decode("decode".clone())) }
  return Err(DbError.Native(NativeError {
    code: Some("7".clone()),
    message: "native".clone(),
  }))
}

fn nested_db_score(result: Result<Option<Output>, DbError>) -> i64 = match result {
  Ok(value) => match value {
    Some(output) => output.text.len() + match output.note {
      Some(note) => note.len()
      None => 0
    }
    None => 2
  }
  Err(error) => match error {
    Native(native) => native.message.len() + match native.code {
      Some(code) => code.len()
      None => 0
    }
    Decode(message) => message.len()
  }
}

pub fn tagged_nested_none(reps: i64) -> i64 {
  mut i := 0
  mut total := 0
  return loop {
    if i >= reps { break total }
    total = total + nested_db_score(nested_db_result(0))
    i = i + 1
  }
}

pub fn tagged_nested_some(reps: i64) -> i64 {
  mut i := 0
  mut total := 0
  return loop {
    if i >= reps { break total }
    total = total + nested_db_score(nested_db_result(1))
    i = i + 1
  }
}

pub fn tagged_nested_decode(reps: i64) -> i64 {
  mut i := 0
  mut total := 0
  return loop {
    if i >= reps { break total }
    total = total + nested_db_score(nested_db_result(2))
    i = i + 1
  }
}

pub fn tagged_nested_native(reps: i64) -> i64 {
  mut i := 0
  mut total := 0
  return loop {
    if i >= reps { break total }
    total = total + nested_db_score(nested_db_result(3))
    i = i + 1
  }
}

pub fn tagged_multi_both(reps: i64) -> i64 {
  mut i := 0
  mut total := 0
  return loop {
    if i >= reps { break total }
    error := MultiError.Both("left".clone(), "right".clone())
    total = total + match error {
      Both(left, right) => left.len() + right.len()
      Empty => 90
    }
    i = i + 1
  }
}

pub fn tagged_multi_wildcard(reps: i64) -> i64 {
  mut i := 0
  mut total := 0
  return loop {
    if i >= reps { break total }
    total = total + match MultiError.Both("left".clone(), "right".clone()) {
      _ => 7
    }
    i = i + 1
  }
}

fn fail_multi_tail() -> Result<string, string> = Err("later".clone())

fn construct_multi_then_fail() -> Result<MultiError, string> {
  error := MultiError.Both("first".clone(), fail_multi_tail()?)
  return Ok(error)
}

pub fn tagged_multi_early_try(reps: i64) -> i64 {
  mut i := 0
  mut total := 0
  return loop {
    if i >= reps { break total }
    total = total + match construct_multi_then_fail() {
      Ok(error) => 90
      Err(message) => message.len()
    }
    i = i + 1
  }
}
