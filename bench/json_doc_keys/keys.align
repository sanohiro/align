import core.json
import std.fs
import std.time

fn main(args: array<str>) -> Result<(), Error> {
  if args.len() != 2 { return Err(Error.Invalid) }
  text := fs.read_file(args[1])?
  arena {
    doc := json.doc(text)?
    start := time.instant()
    keys := doc.keys()
    mut i: i64 := 0
    mut bytes: i64 := 0
    loop {
      if i >= doc.len() { break }
      key := keys[i]
      bytes = bytes + key.len()
      i = i + 1
    }
    print(bytes)
    print(time.instant() - start)
    // Outside the timed region: validate every key byte and corresponding value.
    values := doc.elems()
    if values.len() != keys.len() { return Err(Error.Invalid) }
    mut j: i64 := 0
    loop {
      if j >= keys.len() { break }
      expected := template "{j}"
      if keys[j] != expected { return Err(Error.Invalid) }
      value := values[j].as_i64() else { return Err(Error.Invalid) }
      if value != j { return Err(Error.Invalid) }
      j = j + 1
    }
  }
  return Ok(())
}
