// Benchmark kernels: compare a cheap vectorizable body and a moderately heavy body. The runtime
// uses a persistent worker pool and one generated kernel per claimed range, so the threshold probe
// can measure scheduler overhead after the whole-range specialization rather than the old
// per-element callback path.
fn cheap(x: i64) -> i64 {
  return x * 3 + 1
}

fn work(x: i64) -> i64 {
  mut a := x
  a = a * 2654435761 + 12345
  a = a * a + 7
  a = a * 40503 - 99
  return a
}

fn even(x: i64) -> bool = x % 2 == 0

pub fn pmap_cheap(s: slice<i64>) -> i64 = s.par_map(cheap).sum()
pub fn smap_cheap(s: slice<i64>) -> i64 = s.map(cheap).sum()
pub fn pmap(s: slice<i64>) -> i64 = s.par_map(work).sum()
pub fn smap(s: slice<i64>) -> i64 = s.map(work).sum()

pub fn pfilter(s: slice<i64>) -> i64 {
  out := s.where(even).par_map(cheap)
  return out.sum()
}
