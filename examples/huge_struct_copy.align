// The "huge struct copy" lint (draft.md §16): passing or returning a large struct BY VALUE copies
// the record at the call boundary. An explicit `borrow` parameter can read a bound record without
// copying it. Another data-oriented fix (draft.md §9) is to keep the struct narrow — split the
// rarely-touched ("cold") fields out — so the value on the hot path is
// small. This program stays under the lint's threshold: `Hot` is four words, copied cheaply, so it
// emits no huge-struct-copy warning. Passing or returning a Copy struct larger than 128 bytes
// by value triggers that warning. The explicit float-to-integer cast below has its own warning.

// Narrow, hot record — cheap to pass by value (well under the lint threshold).
Hot {
  x: f64,
  y: f64,
  vx: f64,
  vy: f64,
}

fn step(p: Hot) -> f64 = p.x + p.vx + (p.y + p.vy)

fn main() -> i32 {
  p := Hot { x: 1.0, y: 2.0, vx: 0.5, vy: 0.5 }
  r := step(p)
  return r as i32
}
