// Template strings (M5). `template "...{expr}..."` interpolates expressions
// (integers, floats, bool, char, or text) and builds a `str` via the runtime string builder.
// Dynamic text borrows its arena, or a frame-owned backing allocation outside an arena.
fn main() -> i32 {
  name := "align"
  score := 40
  // Holes are full expressions; literal text can directly surround a string-valued hole.
  print(template "Hello {name}, score={score + 2}, tag={name}!")
  return 0
}
