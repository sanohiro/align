module main

import std.fs

// Byte-exact file copy (std.io Slice 1): `fs.open` a reader, `fs.create` a writer, then stream
// through a fixed-window `buffer` — memory stays O(buffer), never O(file size). The output buffer is
// a visible `mut` local owned by the loop; at EOF (`read` returns 0) both handles drop.
fn copy_all(r: reader, w: writer) -> Result<(), Error> {
  mut buf := buffer(65536)
  loop {
    n := r.read(buf)?
    if n == 0 { break Ok(()) }
    w.write(buf.bytes())?
  }
}

pub fn main(args: array<str>) -> Result<(), Error> {
  r := fs.open(args[1])?
  w := fs.create(args[2])?
  copy_all(r, w)?
  return Ok(())
}
