// Structured concurrency. `spawn(fn { … })` schedules work on the worker pool and returns a
// Task<R>; `wait()` joins, and `t.get()` reads a result after the join. The spawned closures
// capture by value. Leaving the group also joins outstanding tasks before releasing their storage.
fn main() -> Result<(), Error> {
  base: i64 := 100
  task_group {
    a := spawn(fn { base + 5 })
    b := spawn(fn { base * 2 })
    wait()
    print(a.get() + b.get())   // 105 + 200 = 305
  }
  return Ok(())
}
