// A vectorized argmax over `slice<f32>` with EXACT integer indices (draft.md §9, "a mask gates
// structurally"). The float comparison produces a `mask4<f32>`, and the same mask gates both the
// `vec4<f32>` running maxima and the `vec4<i32>` running indices: a mask is one bool lane per lane
// and has no machine-level element type, so blend legality is lane count plus lane bit width.
//
// A blend needs equal lane widths, and the mask comes from a 32-bit float compare, so the index
// lanes are `i32`: every index up to 2147483647 is exact. That is 128x the `f32`-index workaround
// the old nominal mask rule forced (exact only below 2^24), and it is a real bound rather than a
// silent one — integer overflow is defined wrap in Align, so a longer slice would wrap a lane index
// negative. This function refuses such an input instead of returning a wrong answer.

fn argmax(borrow xs: slice<f32>) -> i64 {
  n := xs.len()
  if n < 4 { return 0 - 1 }
  // The last lane index this kernel can represent. `i` never exceeds `n`, so bounding `n` bounds
  // every `lane` value the loop below produces.
  if n > 2147483647 { return 0 - 1 }

  mut best: vec4<f32> := xs.load(0)
  mut best_at: vec4<i32> := [0, 1, 2, 3]
  mut lane: vec4<i32> := [0, 1, 2, 3]
  four: vec4<i32> := [4, 4, 4, 4]

  // Four lanes per step over the whole 4-element blocks.
  mut i := 4
  loop {
    if i + 4 > n { break }
    v: vec4<f32> := xs.load(i)
    lane = lane + four
    m := v > best
    best = select(m, v, best)
    // The SAME mask gates the integer index vector — the reason this spelling compiles.
    best_at = select(m, lane, best_at)
    i = i + 4
  }

  // Horizontal step: fold the four lanes down to one winner. Lane indices are constants.
  mut top := best[0]
  mut top_at := best_at[0] as i64
  if best[1] > top {
    top = best[1]
    top_at = best_at[1] as i64
  }
  if best[2] > top {
    top = best[2]
    top_at = best_at[2] as i64
  }
  if best[3] > top {
    top = best[3]
    top_at = best_at[3] as i64
  }

  // Scalar tail for the elements past the last whole block.
  mut j := i
  loop {
    if j >= n { break }
    if xs[j] > top {
      top = xs[j]
      top_at = j
    }
    j = j + 1
  }
  return top_at
}

fn main() -> Result<(), Error> {
  xs := [
    1.0 as f32, 7.0 as f32, 3.0 as f32, 2.0 as f32,
    9.0 as f32, 4.0 as f32, 5.0 as f32, 6.0 as f32,
    8.0 as f32, 0.0 as f32,
  ]
  s: slice<f32> := xs[0..10]
  print(argmax(s))
  return Ok(())
}
