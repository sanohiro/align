// JSON decode. `json.decode(input)` parses a `str`, returning Result<T, Error>.
// The target type T is inferred from the binding annotation through `?`.
// This example uses a flat struct of integer and boolean fields; json_nested.align shows nesting.
import core.json

User { id: i64, active: bool }

fn parse(s: str) -> Result<User, Error> {
  u: User := json.decode(s)?
  return Ok(u)
}

fn main() -> Result<(), Error> {
  // Field order is irrelevant and unknown keys ("x") are ignored.
  u := parse("{\"active\": true, \"x\": 9, \"id\": 42}")?
  print(u.id)            // 42
  print(json.encode(u)?)  // {"id":42,"active":true}
  return Ok(())
}
