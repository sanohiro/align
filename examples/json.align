// JSON encode. `json.encode(s)` borrows the source and returns `Result<string, Error>`.
// The successful output owns its bytes independently of the source, including inside an arena.
// Text fields are JSON-escaped; this example deliberately maps an encoding error to exit 1.
import core.json

User { id: i64, name: str, active: bool }
fn main() -> i32 {
  u := User{id: 7, name: "a\"b", active: true}
  print((json.encode(u) else { return 1 }))   // {"id":7,"name":"a\"b","active":true}
  return 0
}
