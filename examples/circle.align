// Floating-point arithmetic. Compare the result and report it through the exit code:
// 1 means the area lies between 12 and 13. `print` also accepts floating-point values.
fn area(r: f64) -> f64 = r * r * 3.14159

fn main() -> i32 {
  a := area(2.0)
  if a > 12.0 {
    if a < 13.0 {
      return 1
    }
  }
  return 0
}
