extern "C" link("sqlite3") {
  fn sqlite3_prepare_v2(database: raw, sql: raw, bytes: i32, statement_out: raw, tail_out: raw) -> i32
  fn sqlite3_bind_text(statement: raw, index: i32, value: raw, bytes: i32, destructor: raw) -> i32
  fn sqlite3_step(statement: raw) -> i32
  fn sqlite3_column_count(statement: raw) -> i32
  fn sqlite3_column_type(statement: raw, index: i32) -> i32
  fn sqlite3_column_int64(statement: raw, index: i32) -> i64
  fn sqlite3_column_text(statement: raw, index: i32) -> raw
  fn sqlite3_column_bytes(statement: raw, index: i32) -> i32
  fn sqlite3_db_readonly(database: raw, schema: raw) -> i32
  fn sqlite3_errcode(database: raw) -> i32
  fn sqlite3_extended_errcode(database: raw) -> i32
  fn sqlite3_errmsg(database: raw) -> raw
  fn sqlite3_exec(database: raw, sql: raw, callback: raw, argument: raw, error_out: raw) -> i32
}

extern "C" link("pq") {
  fn PQexecParams(
    connection: raw,
    command: raw,
    parameter_count: i32,
    parameter_types: raw,
    parameter_values: raw,
    parameter_lengths: raw,
    parameter_formats: raw,
    result_format: i32,
  ) -> raw
  fn PQresultStatus(result: raw) -> i32
  fn PQntuples(result: raw) -> i32
  fn PQnfields(result: raw) -> i32
  fn PQgetisnull(result: raw, row: i32, column: i32) -> i32
  fn PQgetvalue(result: raw, row: i32, column: i32) -> raw
  fn PQgetlength(result: raw, row: i32, column: i32) -> i32
  fn PQerrorMessage(connection: raw) -> raw
  fn PQresultErrorField(result: raw, field: i32) -> raw
  fn PQexec(connection: raw, command: raw) -> raw
  fn PQcmdStatus(result: raw) -> raw
  fn PQclear(result: raw)
}

SQLITE_OK: i32 := 0
SQLITE_INTEGER: i32 := 1
SQLITE_TEXT: i32 := 3
SQLITE_NULL: i32 := 5
SQLITE_ROW: i32 := 100
SQLITE_DONE: i32 := 101
PGRES_TUPLES_OK: i32 := 2
PGRES_COMMAND_OK: i32 := 1

// Static statement descriptors are compiler-produced Copy values. These source declarations own
// their public type surface; a constructor body is unreachable after descriptor lowering.
pub query<P, R> {}
pub command<P> {}

// One physical database connection. The internal Drop hook owns the closed SQLite/PostgreSQL
// dispatch; public code never receives its native pointer.
pub resource conn = pkg.db.internal.resource.drop_conn

// A transaction owns the same physical connection state until commit/rollback returns it or Drop
// performs fail-safe rollback and close.
pub resource tx = pkg.db.internal.resource.drop_tx

// Q4a prepared execution resources. A stmt depends on the conn/tx generation that prepared it;
// one rows value in turn depends on the current mutable statement generation.
pub resource stmt<P, R> = pkg.db.internal.resource.drop_stmt
pub resource rows<R> = pkg.db.internal.resource.drop_rows

// Private synchronous owner for one D12 native result. It is borrowed from the connection so no
// cursor can outlive or overlap a move of that connection. The drop hook finalizes/clears the
// native result and releases SQLite's connection-wide execution lease.
pub resource catalog_cursor = pkg.db.internal.resource.drop_catalog_cursor

pub exec {
  Conn(resource_ref<conn>)
  Tx(resource_ref<tx>)
}

