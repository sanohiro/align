pub fn meta_query<P, R>(
  target: exec,
  statement: query<P, R>,
  detail: MetaDetail,
  out: region,
  options: slice<MetaOption>,
) -> Result<array<QueryMeta>, Error> {
  unsafe {
    data := pkg.db.internal.descriptor.data(statement)
    if data.is_null() {
      return Err(Error.InvalidQuery(ContractError {
        query_id: None,
        item: "db.descriptor.header".clone(),
        message: "invalid static database descriptor".clone(),
      }))
    }
    version: u32 := raw.load(data, 0)
    kind: u8 := raw.load(data, 4)
    mask: u8 := raw.load(data, 5)
    reserved: u16 := raw.load(data, 6)
    tail_reserved: u32 := raw.load(data, 116)
    id_len: i64 := raw.load(data, 24)
    sqlite_len: i64 := raw.load(data, 40)
    postgres_len: i64 := raw.load(data, 56)
    q1 := pkg.db.internal.descriptor.q1_plan(statement)
    id := pkg.db.internal.descriptor.descriptor_id_pointer(statement)
    sqlite_sql := pkg.db.internal.descriptor.sqlite_sql_pointer(statement)
    postgres_sql := pkg.db.internal.descriptor.postgres_sql_pointer(statement)
    binder := pkg.db.internal.descriptor.binder(statement)
    validate_static := pkg.db.internal.descriptor.static_validator(statement)
    validate_row := pkg.db.internal.descriptor.row_validator(statement)
    decode := pkg.db.internal.descriptor.decoder(statement)
    materializer := pkg.db.internal.descriptor.meta_materializer(statement)
    parameter_resolver := pkg.db.internal.descriptor.parameter_resolver(statement)
    base_valid := version == 3 && kind == 0 && reserved == 0 && tail_reserved == 0
      && !q1.is_null()
      && !id.is_null() && id_len > 0 && !binder.is_null() && !validate_static.is_null()
      && !validate_row.is_null() && !decode.is_null() && !materializer.is_null()
      && !parameter_resolver.is_null()
    sqlite_only := mask == 1 && !sqlite_sql.is_null() && sqlite_len > 0
      && postgres_sql.is_null() && postgres_len == 0
    postgres_only := mask == 2 && sqlite_sql.is_null() && sqlite_len == 0
      && !postgres_sql.is_null() && postgres_len > 0
    portable := mask == 3 && !sqlite_sql.is_null() && sqlite_len > 0
      && !postgres_sql.is_null() && postgres_len > 0
    if !(base_valid && (sqlite_only || postgres_only || portable)) {
      return Err(Error.InvalidQuery(ContractError {
        query_id: None,
        item: "db.descriptor.header".clone(),
        message: "invalid static database descriptor".clone(),
      }))
    }

    query_id := pkg.db.internal.descriptor.descriptor_id(statement)
    mut saw_timeout := false
    mut saw_system := false
    mut option_index := 0
    loop {
      if option_index >= options.len() { break }
      match options[option_index] {
        TimeoutNs(ns) => {
          if ns <= 0 {
            return Err(Error.Unsupported(ContractError {
              query_id: Some(query_id.clone()),
              item: "db.meta.timeout_ns".clone(),
              message: "database metadata timeout must be positive".clone(),
            }))
          }
          if saw_timeout {
            return Err(Error.Unsupported(ContractError {
              query_id: Some(query_id.clone()),
              item: "db.meta.timeout_ns".clone(),
              message: "duplicate database metadata timeout".clone(),
            }))
          }
          saw_timeout = true
        }
        IncludeSystem => {
          if saw_system {
            return Err(Error.Unsupported(ContractError {
              query_id: Some(query_id.clone()),
              item: "db.meta.include_system".clone(),
              message: "duplicate include-system metadata option".clone(),
            }))
          }
          saw_system = true
        }
      }
      option_index = option_index + 1
    }
    if saw_timeout {
      return Err(Error.Unsupported(ContractError {
        query_id: Some(query_id.clone()),
        item: "db.meta.timeout_ns".clone(),
        message: "static Query metadata performs no database wait".clone(),
      }))
    }
    if saw_system {
      return Err(Error.Unsupported(ContractError {
        query_id: Some(query_id.clone()),
        item: "db.meta.include_system".clone(),
        message: "static Query metadata has no system-object scope".clone(),
      }))
    }
    connection_driver := driver_tag(target)
    mut driver: u8 := 0
    if connection_driver == 1 {
      if mask & 1 == 0 {
        return Err(Error.DriverMismatch(ContractError {
          query_id: Some(query_id.clone()),
          item: "db.descriptor.driver".clone(),
          message: "static database descriptor does not support SQLite".clone(),
        }))
      }
      driver = 0
    } else {
      if connection_driver == 2 {
        if mask & 2 == 0 {
          return Err(Error.DriverMismatch(ContractError {
            query_id: Some(query_id.clone()),
            item: "db.descriptor.driver".clone(),
            message: "static database descriptor does not support PostgreSQL".clone(),
          }))
        }
        driver = 1
      } else {
        return Err(Error.Unsupported(ContractError {
          query_id: Some(query_id.clone()),
          item: "db.meta.exec".clone(),
          message: "database metadata requires a live execution target".clone(),
        }))
      }
    }
    connection_state := match target {
      Conn(reference) => {
        candidate := resource.raw(reference)
        if pkg.db.internal.resource.transaction_active(candidate) { raw.null() } else { candidate }
      }
      Tx(reference) => {
        candidate := resource.raw(reference)
        if pkg.db.internal.resource.transaction_active(candidate) { candidate } else { raw.null() }
      }
    }
    mut live_exec := false
    if !connection_state.is_null() {
      state_version: u32 := raw.load(connection_state, 0)
      state_driver: u8 := raw.load(connection_state, 4)
      state_closed: u8 := raw.load(connection_state, 5)
      state_reserved: u16 := raw.load(connection_state, 6)
      state_native: raw := raw.load(connection_state, 8)
      live_exec = state_version == 1 && state_driver == connection_driver && state_closed == 0
        && state_reserved == 0 && !state_native.is_null()
    }
    if !live_exec {
      return Err(Error.Unsupported(ContractError {
        query_id: Some(query_id.clone()),
        item: "db.meta.exec".clone(),
        message: "database metadata requires a live execution target".clone(),
      }))
    }

    mut rows: array_builder<QueryMeta> := array_builder(out)
    detail_tag: u8 := match detail {
      Names => 0
      Summary => 1
      Full => 2
    }
    mut index := 0
    loop {
      next := pkg.db.internal.descriptor.materialize_meta(
        statement, driver, detail_tag, index,
      )
      row := next else { break }
      rows.push(row.clone_in(out))
      index = index + 1
    }
    if index == 0 {
      return Err(Error.InvalidQuery(ContractError {
        query_id: Some(query_id.clone()),
        item: "db.descriptor.query_meta".clone(),
        message: "static Query metadata materializer returned no summary row".clone(),
      }))
    }
    return Ok(rows.build())
  }
}

pub fn explain<P, R>(
  target: exec,
  statement: query<P, R>,
  params: P,
  out: region,
  options: slice<ExplainOption>,
) -> Result<QueryPlan, Error> {
  unsafe {
    data := pkg.db.internal.descriptor.data(statement)
    if data.is_null() {
      return Err(Error.InvalidQuery(ContractError {
        query_id: None,
        item: "db.descriptor.header".clone(),
        message: "invalid static database descriptor".clone(),
      }))
    }
    version: u32 := raw.load(data, 0)
    kind: u8 := raw.load(data, 4)
    mask: u8 := raw.load(data, 5)
    reserved: u16 := raw.load(data, 6)
    tail_reserved: u32 := raw.load(data, 116)
    id_len: i64 := raw.load(data, 24)
    sqlite_len: i64 := raw.load(data, 40)
    postgres_len: i64 := raw.load(data, 56)
    q1 := pkg.db.internal.descriptor.q1_plan(statement)
    id := pkg.db.internal.descriptor.descriptor_id_pointer(statement)
    sqlite_sql := pkg.db.internal.descriptor.sqlite_sql_pointer(statement)
    postgres_sql := pkg.db.internal.descriptor.postgres_sql_pointer(statement)
    binder := pkg.db.internal.descriptor.binder(statement)
    validate_static := pkg.db.internal.descriptor.static_validator(statement)
    validate_row := pkg.db.internal.descriptor.row_validator(statement)
    decode := pkg.db.internal.descriptor.decoder(statement)
    materializer := pkg.db.internal.descriptor.meta_materializer(statement)
    parameter_resolver := pkg.db.internal.descriptor.parameter_resolver(statement)
    base_valid := version == 3 && kind == 0 && reserved == 0 && tail_reserved == 0
      && !q1.is_null()
      && !id.is_null() && id_len > 0 && !binder.is_null() && !validate_static.is_null()
      && !validate_row.is_null() && !decode.is_null() && !materializer.is_null()
      && !parameter_resolver.is_null()
    sqlite_only := mask == 1 && !sqlite_sql.is_null() && sqlite_len > 0
      && postgres_sql.is_null() && postgres_len == 0
    postgres_only := mask == 2 && sqlite_sql.is_null() && sqlite_len == 0
      && !postgres_sql.is_null() && postgres_len > 0
    portable := mask == 3 && !sqlite_sql.is_null() && sqlite_len > 0
      && !postgres_sql.is_null() && postgres_len > 0
    if !(base_valid && (sqlite_only || postgres_only || portable)) {
      return Err(Error.InvalidQuery(ContractError {
        query_id: None,
        item: "db.descriptor.header".clone(),
        message: "invalid static database descriptor".clone(),
      }))
    }
    query_id := pkg.db.internal.descriptor.descriptor_id(statement)
    mut saw_timeout := false
    mut option_index := 0
    loop {
      if option_index >= options.len() { break }
      match options[option_index] {
        TimeoutNs(ns) => {
          if ns <= 0 {
            return Err(Error.Unsupported(ContractError {
              query_id: Some(query_id.clone()),
              item: "db.explain.timeout_ns".clone(),
              message: "database EXPLAIN timeout must be positive".clone(),
            }))
          }
          if saw_timeout {
            return Err(Error.Unsupported(ContractError {
              query_id: Some(query_id.clone()),
              item: "db.explain.timeout_ns".clone(),
              message: "duplicate database EXPLAIN timeout".clone(),
            }))
          }
          saw_timeout = true
        }
      }
      option_index = option_index + 1
    }
    if saw_timeout {
      return Err(Error.Unsupported(ContractError {
        query_id: Some(query_id.clone()),
        item: "db.explain.timeout_ns".clone(),
        message: "database EXPLAIN deadlines are not available in this milestone".clone(),
      }))
    }
    driver := driver_tag(target)
    if driver == 1 && mask & 1 == 0 {
      return Err(Error.DriverMismatch(ContractError {
        query_id: Some(query_id.clone()),
        item: "db.descriptor.driver".clone(),
        message: "static database descriptor does not support SQLite".clone(),
      }))
    }
    if driver == 2 && mask & 2 == 0 {
      return Err(Error.DriverMismatch(ContractError {
        query_id: Some(query_id.clone()),
        item: "db.descriptor.driver".clone(),
        message: "static database descriptor does not support PostgreSQL".clone(),
      }))
    }
    state := match target {
      Conn(reference) => {
        candidate := resource.raw(reference)
        if pkg.db.internal.resource.transaction_active(candidate) { raw.null() } else { candidate }
      }
      Tx(reference) => {
        candidate := resource.raw(reference)
        if pkg.db.internal.resource.transaction_active(candidate) { candidate } else { raw.null() }
      }
    }
    mut live_exec := false
    if !state.is_null() {
      state_version: u32 := raw.load(state, 0)
      state_driver: u8 := raw.load(state, 4)
      state_closed: u8 := raw.load(state, 5)
      state_reserved: u16 := raw.load(state, 6)
      state_native: raw := raw.load(state, 8)
      live_exec = state_version == 1 && state_driver == driver && state_closed == 0
        && state_reserved == 0 && !state_native.is_null()
    }
    if !live_exec {
      return Err(Error.Unsupported(ContractError {
        query_id: Some(query_id.clone()),
        item: "db.explain.exec".clone(),
        message: "database EXPLAIN requires a live execution target".clone(),
      }))
    }
    if driver == 1 {
      return pkg.db.internal.descriptor.explain_sqlite(
        statement, target, params, out, query_id,
      )
    }
    if driver == 2 {
      return pkg.db.internal.descriptor.explain_postgres(
        statement, target, params, out, query_id,
      )
    }
    return Err(Error.Unsupported(ContractError {
      query_id: Some(query_id.clone()),
      item: "db.explain.exec".clone(),
      message: "database EXPLAIN requires a live execution target".clone(),
    }))
  }
}

// Used only when an application asks the common surface without importing the corresponding
// first-party native package.  The generic result keeps the diagnostic an ordinary package value;
// it is never a compiler panic or an implicit driver selection.
pub fn unsupported<T>(query_id: str) -> Result<T, Error> {
  return Err(Error.Unsupported(ContractError {
    query_id: Some(query_id.clone()),
    item: "db.execute.driver".clone(),
    message: "no native database driver is available in this compilation unit".clone(),
  }))
}

pub fn execute<P>(
  target: exec,
  statement: command<P>,
  params: P,
  options: slice<ExecuteOption>,
) -> Result<exec_result, Error> {
  unsafe {
    data := pkg.db.internal.descriptor.data(statement)
    if data.is_null() {
      return Err(Error.InvalidQuery(ContractError {
        query_id: None,
        item: "db.descriptor.header".clone(),
        message: "invalid static database descriptor".clone(),
      }))
    }
    version: u32 := raw.load(data, 0)
    kind: u8 := raw.load(data, 4)
    mask: u8 := raw.load(data, 5)
    reserved: u16 := raw.load(data, 6)
    tail_reserved: u32 := raw.load(data, 116)
    id_len: i64 := raw.load(data, 24)
    sqlite_len: i64 := raw.load(data, 40)
    postgres_len: i64 := raw.load(data, 56)
    q1 := pkg.db.internal.descriptor.q1_plan(statement)
    id := pkg.db.internal.descriptor.descriptor_id_pointer(statement)
    sqlite_sql := pkg.db.internal.descriptor.sqlite_sql_pointer(statement)
    postgres_sql := pkg.db.internal.descriptor.postgres_sql_pointer(statement)
    binder := pkg.db.internal.descriptor.binder(statement)
    validate_static := pkg.db.internal.descriptor.static_validator(statement)
    validate_row := pkg.db.internal.descriptor.row_validator(statement)
    decode := pkg.db.internal.descriptor.decoder(statement)
    materializer := pkg.db.internal.descriptor.meta_materializer(statement)
    parameter_resolver := pkg.db.internal.descriptor.parameter_resolver(statement)
    base_valid := version == 3 && kind == 1 && reserved == 0 && tail_reserved == 0
      && !q1.is_null()
      && !id.is_null() && id_len > 0 && !binder.is_null() && !validate_static.is_null()
      && validate_row.is_null() && decode.is_null() && materializer.is_null()
      && !parameter_resolver.is_null()
    sqlite_only := mask == 1 && !sqlite_sql.is_null() && sqlite_len > 0
      && postgres_sql.is_null() && postgres_len == 0
    postgres_only := mask == 2 && sqlite_sql.is_null() && sqlite_len == 0
      && !postgres_sql.is_null() && postgres_len > 0
    portable := mask == 3 && !sqlite_sql.is_null() && sqlite_len > 0
      && !postgres_sql.is_null() && postgres_len > 0
    if !(base_valid && (sqlite_only || postgres_only || portable)) {
      return Err(Error.InvalidQuery(ContractError {
        query_id: None,
        item: "db.descriptor.header".clone(),
        message: "invalid static database descriptor".clone(),
      }))
    }
  }
  unsafe {
    query_id := pkg.db.internal.descriptor.descriptor_id(statement)
    execute_options_valid(options, query_id)?
    driver := driver_tag(target)
    if driver == 1 {
      return pkg.db.internal.descriptor.execute_sqlite(statement, target, params, query_id)
    }
    if driver == 2 {
      return pkg.db.internal.descriptor.execute_postgres(statement, target, params, query_id)
    }
    return unsupported(query_id)
  }
}

pub fn prepare<P, R>(
  target: exec,
  statement: query<P, R>,
  options: slice<PrepareOption>,
) -> Result<stmt<P, R>, Error> {
  unsafe {
    data := pkg.db.internal.descriptor.data(statement)
    if data.is_null() {
      return Err(Error.InvalidQuery(ContractError {
        query_id: None,
        item: "db.descriptor.header".clone(),
        message: "invalid static database descriptor".clone(),
      }))
    }
    version: u32 := raw.load(data, 0)
    kind: u8 := raw.load(data, 4)
    mask: u8 := raw.load(data, 5)
    reserved: u16 := raw.load(data, 6)
    tail_reserved: u32 := raw.load(data, 116)
    id_len: i64 := raw.load(data, 24)
    sqlite_len: i64 := raw.load(data, 40)
    postgres_len: i64 := raw.load(data, 56)
    q1 := pkg.db.internal.descriptor.q1_plan(statement)
    id := pkg.db.internal.descriptor.descriptor_id_pointer(statement)
    sqlite_sql := pkg.db.internal.descriptor.sqlite_sql_pointer(statement)
    postgres_sql := pkg.db.internal.descriptor.postgres_sql_pointer(statement)
    binder := pkg.db.internal.descriptor.binder(statement)
    validate_static := pkg.db.internal.descriptor.static_validator(statement)
    validate_row := pkg.db.internal.descriptor.row_validator(statement)
    decode := pkg.db.internal.descriptor.decoder(statement)
    materializer := pkg.db.internal.descriptor.meta_materializer(statement)
    parameter_resolver := pkg.db.internal.descriptor.parameter_resolver(statement)
    base_valid := version == 3 && kind == 0 && reserved == 0 && tail_reserved == 0
      && !q1.is_null()
      && !id.is_null() && id_len > 0 && !binder.is_null() && !validate_static.is_null()
      && !validate_row.is_null() && !decode.is_null() && !materializer.is_null()
      && !parameter_resolver.is_null()
    sqlite_only := mask == 1 && !sqlite_sql.is_null() && sqlite_len > 0
      && postgres_sql.is_null() && postgres_len == 0
    postgres_only := mask == 2 && sqlite_sql.is_null() && sqlite_len == 0
      && !postgres_sql.is_null() && postgres_len > 0
    portable := mask == 3 && !sqlite_sql.is_null() && sqlite_len > 0
      && !postgres_sql.is_null() && postgres_len > 0
    if !(base_valid && (sqlite_only || postgres_only || portable)) {
      return Err(Error.InvalidQuery(ContractError {
        query_id: None,
        item: "db.descriptor.header".clone(),
        message: "invalid static database descriptor".clone(),
      }))
    }
    query_id := pkg.db.internal.descriptor.descriptor_id(statement)
    mut i := 0
    loop {
      if i >= options.len() { break }
      match options[i] {
        TimeoutNs(ns) => {
          if ns <= 0 {
            return Err(Error.Unsupported(ContractError {
              query_id: Some(query_id.clone()),
              item: "db.prepare.timeout_ns".clone(),
              message: "database prepare timeout must be positive".clone(),
            }))
          }
          return Err(Error.Unsupported(ContractError {
            query_id: Some(query_id.clone()),
            item: "db.prepare.timeout_ns".clone(),
            message: "database prepare deadlines are not available in this milestone".clone(),
          }))
        }
      }
      i = i + 1
    }
    driver := driver_tag(target)
    if driver == 1 {
      return pkg.db.internal.descriptor.prepare_sqlite(statement, target, query_id, 0 as u32)
    }
    if driver == 2 {
      return pkg.db.internal.descriptor.prepare_postgres(
        statement, target, query_id, raw.null(), 0 as u32,
      )
    }
    return unsupported(query_id)
  }
}

pub fn rows_stmt<P, R>(
  borrow mut statement: stmt<P, R>,
  params: P,
  options: slice<ExecuteOption>,
) -> Result<rows<R>, Error> {
  unsafe {
    wrapper := resource.raw(resource.borrow(statement))
    driver := pkg.db.internal.resource.stmt_driver(wrapper)
    if driver == 1 {
      return pkg.db.internal.descriptor.rows_stmt_sqlite(statement, params, options)
    }
    if driver == 2 {
      return pkg.db.internal.descriptor.rows_stmt_postgres(statement, params, options)
    }
    return Err(Error.InvalidQuery(ContractError {
      query_id: None,
      item: "db.statement.header".clone(),
      message: "invalid prepared statement".clone(),
    }))
  }
}

pub fn one<P, R>(
  target: exec,
  statement: query<P, R>,
  params: P,
  out: region,
  options: slice<ExecuteOption>,
) -> Result<R, Error> {
  unsafe {
    data := pkg.db.internal.descriptor.data(statement)
    if data.is_null() {
      return Err(Error.InvalidQuery(ContractError {
        query_id: None,
        item: "db.descriptor.header".clone(),
        message: "invalid static database descriptor".clone(),
      }))
    }
    version: u32 := raw.load(data, 0)
    kind: u8 := raw.load(data, 4)
    mask: u8 := raw.load(data, 5)
    reserved: u16 := raw.load(data, 6)
    tail_reserved: u32 := raw.load(data, 116)
    id_len: i64 := raw.load(data, 24)
    sqlite_len: i64 := raw.load(data, 40)
    postgres_len: i64 := raw.load(data, 56)
    q1 := pkg.db.internal.descriptor.q1_plan(statement)
    id := pkg.db.internal.descriptor.descriptor_id_pointer(statement)
    sqlite_sql := pkg.db.internal.descriptor.sqlite_sql_pointer(statement)
    postgres_sql := pkg.db.internal.descriptor.postgres_sql_pointer(statement)
    binder := pkg.db.internal.descriptor.binder(statement)
    validate_static := pkg.db.internal.descriptor.static_validator(statement)
    validate_row := pkg.db.internal.descriptor.row_validator(statement)
    decode := pkg.db.internal.descriptor.decoder(statement)
    materializer := pkg.db.internal.descriptor.meta_materializer(statement)
    parameter_resolver := pkg.db.internal.descriptor.parameter_resolver(statement)
    base_valid := version == 3 && kind == 0 && reserved == 0 && tail_reserved == 0
      && !q1.is_null()
      && !id.is_null() && id_len > 0 && !binder.is_null() && !validate_static.is_null()
      && !validate_row.is_null() && !decode.is_null() && !materializer.is_null()
      && !parameter_resolver.is_null()
    sqlite_only := mask == 1 && !sqlite_sql.is_null() && sqlite_len > 0
      && postgres_sql.is_null() && postgres_len == 0
    postgres_only := mask == 2 && sqlite_sql.is_null() && sqlite_len == 0
      && !postgres_sql.is_null() && postgres_len > 0
    portable := mask == 3 && !sqlite_sql.is_null() && sqlite_len > 0
      && !postgres_sql.is_null() && postgres_len > 0
    if !(base_valid && (sqlite_only || postgres_only || portable)) {
      return Err(Error.InvalidQuery(ContractError {
        query_id: None,
        item: "db.descriptor.header".clone(),
        message: "invalid static database descriptor".clone(),
      }))
    }
  }
  unsafe {
    query_id := pkg.db.internal.descriptor.descriptor_id(statement)
    execute_options_valid(options, query_id)?
    driver := driver_tag(target)
    if driver == 1 {
      return pkg.db.internal.descriptor.one_sqlite(statement, target, params, out, query_id)
    }
    if driver == 2 {
      return pkg.db.internal.descriptor.one_postgres(statement, target, params, out, query_id)
    }
    return unsupported(query_id)
  }
}

fn tx_options_valid(options: slice<TxOption>) -> Result<(), Error> {
  mut i := 0
  loop {
    if i >= options.len() { break }
    match options[i] {
      BeginTimeoutNs(ns) => {
        if ns <= 0 {
          return Err(queryless_contract(
            "db.transaction.begin_timeout_ns",
            "database transaction begin timeout must be positive",
          ))
        }
        return Err(queryless_contract(
          "db.transaction.begin_timeout_ns",
          "database transaction begin deadlines are not available in this milestone",
        ))
      }
    }
    i = i + 1
  }
  return Ok(())
}

fn transaction_state_valid(state: raw, active: bool) -> bool {
  unsafe {
    if state.is_null() { return false }
    version: u32 := raw.load(state, 0)
    driver: u8 := raw.load(state, 4)
    closed: u8 := raw.load(state, 5)
    reserved: u16 := raw.load(state, 6)
    native: raw := raw.load(state, 8)
    lease: u8 := raw.load(state, 20)
    transaction: u8 := raw.load(state, 21)
    return version == 1 && (driver == 1 || driver == 2) && closed == 0 && reserved == 0
      && !native.is_null() && lease == 0 && ((transaction != 0) == active)
  }
}

fn transaction_control(state: raw, sql: str) -> Result<(), Error> {
  unsafe {
    driver: u8 := raw.load(state, 4)
    native: raw := raw.load(state, 8)
    command := c_string(sql)
    if driver == 1 {
      status := sqlite3_exec(native, command, raw.null(), raw.null(), raw.null())
      raw.free(command)
      if status != SQLITE_OK { return Err(sqlite_native_error(native)) }
      return Ok(())
    }
    if driver == 2 {
      result := PQexec(native, command)
      raw.free(command)
      if result.is_null() { return Err(postgres_native_error(native, raw.null())) }
      status := PQresultStatus(result)
      if status != PGRES_COMMAND_OK {
        failure := postgres_native_error(native, result)
        PQclear(result)
        return Err(failure)
      }
      expected_status := if sql == "COMMIT" { "COMMIT" } else {
        if sql == "ROLLBACK" { "ROLLBACK" } else { "BEGIN" }
      }
      actual_status := copy_c_string(PQcmdStatus(result))
      if actual_status != expected_status {
        failure := Error.Native(NativeError {
          driver: Driver.PostgreSQL,
          code: None,
          extended_code: None,
          sqlstate: None,
          message: "PostgreSQL transaction control returned an unexpected command status".clone(),
          detail: Some(actual_status),
          constraint: None,
          table: None,
          column: None,
        })
        PQclear(result)
        return Err(failure)
      }
      PQclear(result)
      return Ok(())
    }
    raw.free(command)
    return Err(queryless_contract(
      "db.transaction.driver",
      "database transaction requires a SQLite or PostgreSQL connection",
    ))
  }
}

pub fn begin(connection: conn, options: slice<TxOption>) -> Result<tx, Error> {
  tx_options_valid(options)?
  unsafe {
    state := resource.raw(resource.borrow(connection))
    if !transaction_state_valid(state, false) {
      return Err(queryless_contract(
        "db.transaction.connection",
        "database transaction requires an idle live connection",
      ))
    }
    driver: u8 := raw.load(state, 4)
    if driver == 1 {
      transaction_control(state, "BEGIN DEFERRED")?
    } else {
      transaction_control(
        state,
        "BEGIN ISOLATION LEVEL READ COMMITTED READ WRITE NOT DEFERRABLE",
      )?
    }
    pkg.db.internal.resource.set_transaction_active(state, true)
    transferred := resource.into_raw(connection)
    transaction: tx := resource.from_raw(transferred)
    return Ok(transaction)
  }
}

pub fn commit(transaction: tx) -> Result<conn, Error> {
  unsafe {
    state := resource.raw(resource.borrow(transaction))
    if !transaction_state_valid(state, true) {
      return Err(queryless_contract(
        "db.transaction.state",
        "database transaction is not active",
      ))
    }
    transaction_control(state, "COMMIT")?
    pkg.db.internal.resource.set_transaction_active(state, false)
    transferred := resource.into_raw(transaction)
    connection: conn := resource.from_raw(transferred)
    return Ok(connection)
  }
}

pub fn rollback(transaction: tx) -> Result<conn, Error> {
  unsafe {
    state := resource.raw(resource.borrow(transaction))
    if !transaction_state_valid(state, true) {
      return Err(queryless_contract(
        "db.transaction.state",
        "database transaction is not active",
      ))
    }
    transaction_control(state, "ROLLBACK")?
    pkg.db.internal.resource.set_transaction_active(state, false)
    transferred := resource.into_raw(transaction)
    connection: conn := resource.from_raw(transferred)
    return Ok(connection)
  }
}
