pub fn meta_database(
  target: exec,
  detail: MetaDetail,
  out: region,
  options: slice<MetaOption>,
) -> Result<DatabaseMeta, Error> {
  controls := metadata_controls(options)?
  driver := driver_tag(target)
  if driver == 1 { return sqlite_meta_database(target, detail, out) }
  if driver == 2 { return postgres_meta_database(target, detail, out) }
  return Err(queryless_contract("db.meta.exec", "database metadata requires a live connection"))
}

pub fn meta_schemas(
  target: exec,
  detail: MetaDetail,
  out: region,
  options: slice<MetaOption>,
) -> Result<array<SchemaMeta>, Error> {
  controls := metadata_controls(options)?
  driver := driver_tag(target)
  if driver == 1 { return sqlite_meta_schemas(target, detail, out, controls.include_system) }
  if driver == 2 {
    return postgres_meta_schemas_configured(
      target, detail, out, controls.include_system, false,
    )
  }
  return Err(queryless_contract("db.meta.exec", "database metadata requires a live connection"))
}

pub fn meta_tables(
  target: exec,
  schema_filter: Option<SchemaRef>,
  detail: MetaDetail,
  out: region,
  options: slice<MetaOption>,
) -> Result<array<TableMeta>, Error> {
  controls := metadata_controls(options)?
  match schema_filter {
    Some(reference) => { metadata_schema_valid(reference)? }
    None => {}
  }
  driver := driver_tag(target)
  if driver == 1 {
    return sqlite_meta_tables(
      target,
      schema_filter,
      detail,
      out,
      controls.include_system,
      controls.include_system,
    )
  }
  if driver == 2 {
    return postgres_meta_tables_configured(
      target, schema_filter, detail, out, controls.include_system, false,
    )
  }
  return Err(queryless_contract("db.meta.exec", "database metadata requires a live connection"))
}

