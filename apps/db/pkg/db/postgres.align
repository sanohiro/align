pub fn explain_native<P, R>(
  target: pkg.db.exec,
  statement: pkg.db.query<P, R>,
  params: P,
  out: region,
  options: slice<pkg.db.ExplainOption>,
  native: slice<ExplainOption>,
) -> Result<pkg.db.QueryPlan, pkg.db.Error> {
  if !pkg.db.internal.postgres.query_header_valid(statement) {
    return Err(pkg.db.internal.postgres.invalid_descriptor_error())
  }
  unsafe {
    query_id := pkg.db.internal.descriptor.descriptor_id(statement)
    mut saw_timeout := false
    mut common_index := 0
    loop {
      if common_index >= options.len() { break }
      match options[common_index] {
        TimeoutNs(ns) => {
          if ns <= 0 {
            return Err(pkg.db.internal.postgres.descriptor_error(
              query_id,
              "db.explain.timeout_ns",
              "database EXPLAIN timeout must be positive",
            ))
          }
          if saw_timeout {
            return Err(pkg.db.internal.postgres.descriptor_error(
              query_id,
              "db.explain.timeout_ns",
              "duplicate database EXPLAIN timeout",
            ))
          }
          saw_timeout = true
        }
      }
      common_index = common_index + 1
    }
    if saw_timeout {
      return Err(pkg.db.internal.postgres.descriptor_error(
        query_id,
        "db.explain.timeout_ns",
        "database EXPLAIN deadlines are not available in this milestone",
      ))
    }

    mut format: u8 := 0
    mut saw_format := false
    mut option_mask: u8 := 0
    mut option_values: u8 := 0
    mut native_index := 0
    loop {
      if native_index >= native.len() { break }
      mut bit: u8 := 0
      mut value := true
      match native[native_index] {
        Analyze => { bit = 1 }
        Format(selected) => {
          if saw_format {
            return Err(pkg.db.internal.postgres.descriptor_error(
              query_id,
              "postgres.explain.format",
              "duplicate PostgreSQL EXPLAIN format",
            ))
          }
          saw_format = true
          format = match selected { Text => 1 Json => 2 }
        }
        Verbose(enabled) => { bit = 2; value = enabled }
        Costs(enabled) => { bit = 4; value = enabled }
        Buffers(enabled) => { bit = 8; value = enabled }
        Timing(enabled) => { bit = 16; value = enabled }
        Settings(enabled) => { bit = 32; value = enabled }
        Wal(enabled) => { bit = 64; value = enabled }
      }
      if bit != 0 {
        if option_mask & bit != 0 {
          return Err(pkg.db.internal.postgres.descriptor_error(
            query_id,
            "postgres.explain.options",
            "duplicate PostgreSQL EXPLAIN option",
          ))
        }
        option_mask = option_mask | bit
        if value { option_values = option_values | bit }
      }
      native_index = native_index + 1
    }
    if option_mask & 88 != 0 && option_mask & 1 == 0 {
      return Err(pkg.db.internal.postgres.descriptor_error(
        query_id,
        "postgres.explain.analyze",
        "PostgreSQL Buffers, Timing, and Wal require Analyze",
      ))
    }
    result: Result<pkg.db.QueryPlan, pkg.db.Error> :=
      pkg.db.internal.descriptor.explain_postgres_native(
      statement,
      target,
      params,
      out,
      query_id,
      format,
      option_mask,
      option_values,
    )
    return result
  }
}
