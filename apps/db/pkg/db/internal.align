module pkg.db.internal

extern "C" link("sqlite3") {
  fn sqlite3_bind_null(statement: raw, index: i32) -> i32
  fn sqlite3_bind_int64(statement: raw, index: i32, value: i64) -> i32
  fn sqlite3_bind_double(statement: raw, index: i32, value: f64) -> i32
  fn sqlite3_bind_text(statement: raw, index: i32, value: raw, bytes: i32, destructor: raw) -> i32
  fn sqlite3_bind_blob(statement: raw, index: i32, value: raw, bytes: i32, destructor: raw) -> i32
  fn sqlite3_column_count(statement: raw) -> i32
  fn sqlite3_column_name(statement: raw, index: i32) -> raw
  fn sqlite3_column_type(statement: raw, index: i32) -> i32
  fn sqlite3_column_int64(statement: raw, index: i32) -> i64
  fn sqlite3_column_double(statement: raw, index: i32) -> f64
  fn sqlite3_column_text(statement: raw, index: i32) -> raw
  fn sqlite3_column_blob(statement: raw, index: i32) -> raw
  fn sqlite3_column_bytes(statement: raw, index: i32) -> i32
  fn sqlite3_libversion_number() -> i32
}

extern "C" link("pq") {
  fn PQnfields(result: raw) -> i32
  fn PQfname(result: raw, column: i32) -> raw
  fn PQftype(result: raw, column: i32) -> u32
  fn PQfformat(result: raw, column: i32) -> i32
  fn PQgetisnull(result: raw, row: i32, column: i32) -> i32
  fn PQgetvalue(result: raw, row: i32, column: i32) -> raw
  fn PQgetlength(result: raw, row: i32, column: i32) -> i32
}

// libpq is built with OpenSSL on supported targets. Keep its native dependency
// closure explicit because the static runtime can retain TLS references in an
// ELF link even when the Align program reaches only the common database path.
extern "C" link("ssl") {}
extern "C" link("crypto") {}
extern "C" link("zstd") {}
extern "C" link("z") {}

extern "C" {
  fn align_rt_utf8_valid(pointer: raw, length: i64) -> i32
  fn align_rt_f32_to_bits(value: f32) -> u32
  fn align_rt_f32_from_bits(bits: u32) -> f32
  fn align_rt_f64_to_bits(value: f64) -> u64
  fn align_rt_f64_from_bits(bits: u64) -> f64
  fn align_rt_f32_text_len(value: f32) -> i64
  fn align_rt_f64_text_len(value: f64) -> i64
  fn align_rt_f32_text_write(value: f32, output: raw, capacity: i64) -> i64
  fn align_rt_f64_text_write(value: f64, output: raw, capacity: i64) -> i64
}

CONTEXT_VERSION: u32 := 4
DRIVER_SQLITE: u8 := 1
DRIVER_POSTGRES: u8 := 2
FAILURE_NONE: u8 := 0
FAILURE_NATIVE: u8 := 1
FAILURE_UNSUPPORTED: u8 := 2
FAILURE_ROW: u8 := 3
FAILURE_ENCODE: u8 := 4
FAILURE_PARAMETER_REPRESENTATION: u8 := 5
FAILURE_PARAMETER_NUL: u8 := 6
FAILURE_PARAMETER_BUDGET: u8 := 7
SQLITE_OK: i32 := 0
SQLITE_INTEGER: i32 := 1
SQLITE_FLOAT: i32 := 2
SQLITE_TEXT: i32 := 3
SQLITE_BLOB: i32 := 4
SQLITE_NULL: i32 := 5
POSTGRES_BOOL_OID: u32 := 16
POSTGRES_BYTEA_OID: u32 := 17
POSTGRES_NAME_OID: u32 := 19
POSTGRES_INT8_OID: u32 := 20
POSTGRES_INT2_OID: u32 := 21
POSTGRES_INT4_OID: u32 := 23
POSTGRES_TEXT_OID: u32 := 25
POSTGRES_FLOAT4_OID: u32 := 700
POSTGRES_FLOAT8_OID: u32 := 701
POSTGRES_VARCHAR_OID: u32 := 1043
VALUE_BOOL: u8 := 0
VALUE_I16: u8 := 1
VALUE_I32: u8 := 2
VALUE_I64: u8 := 3
VALUE_F32: u8 := 4
VALUE_F64: u8 := 5
VALUE_TEXT: u8 := 6
VALUE_BYTES: u8 := 7
ROW_CACHE_STRIDE: i64 := 24

// Sealed catalog controls cross from the public driver descendants into the common root without
// exposing a second raw-boolean metadata API. The `internal` path rule prevents application and
// sibling-package code from importing or constructing these values.
pub SqliteCatalogControls {
  include_system: bool,
  include_internal: bool,
  include_hidden: bool,
}

pub PostgresCatalogControls {
  include_system: bool,
  search_path_only: bool,
}

// One sealed capability admits the shared execution-descriptor validators in `pkg.db`. The
// `internal` path rule prevents application and sibling-package source from constructing it.
pub DescriptorHeaderControl {
  seal: bool,
}

pub fn descriptor_header_control() -> DescriptorHeaderControl {
  return DescriptorHeaderControl { seal: true }
}

// Authenticate the fixed descriptor fields needed to invoke the producer-owned count thunk. The
// public header validators compare its result with offset 112 immediately afterward; keeping this
// smaller guard separate avoids calling an untrusted thunk while forming that complete verdict.
pub fn descriptor_count_shape_valid(data: raw, expected_kind: u8) -> bool {
  unsafe {
    if data.is_null() || expected_kind > 1 { return false }
    version: u32 := raw.load(data, 0)
    kind: u8 := raw.load(data, 4)
    reserved: u16 := raw.load(data, 6)
    parameter_count: u32 := raw.load(data, 112)
    tail_reserved: u32 := raw.load(data, 116)
    parameter_count_thunk: raw := raw.load(data, 136)
    return version == 6 && kind == expected_kind && reserved == 0
      && parameter_count <= 65535 && tail_reserved == 0 && !parameter_count_thunk.is_null()
  }
}

// Resolver v2 uses its sign as a private static-type proof. Ordinary name lookup never exposes
// that proof; only the sealed Binary-specific descriptor operations consume the negative form.
pub fn parameter_ordinal_v2(resolved: i32) -> i32 {
  if resolved == -2147483648 { return 0 }
  return if resolved < 0 { -resolved } else { resolved }
}

pub fn binary_parameter_ordinal_v2(resolved: i32) -> i32 {
  if resolved >= 0 || resolved == -2147483648 { return 0 }
  return -resolved
}

// The package-owned call-scoped execution context is one exact 112-byte v4 record:
//   0: u32 version (= 4)
//   4: u8  driver (1 SQLite, 2 PostgreSQL)
//   5: u8  first-failure class (0 none, 1 native, 2 unsupported, 3 row contract)
//   6: u16 reserved (= 0)
//   8: raw current SQLite statement / PostgreSQL result
//  16: u32 current row ordinal
//  20: u32 reserved
//  24: raw cached decoded i64 values
//  32: u32 cached value count
//  36: u32 reserved
// SQLite prepared binding extends the allocation:
//  40: raw retained text/blob pointer vector
//  48: u32 retained pointer vector length
//  52: u32 reserved
// PostgreSQL extends the allocation while binding:
//  40: raw parameter value-pointer vector
//  48: raw parameter OID vector
//  56: raw parameter length vector
//  64: raw parameter format vector
//  72: u32 parameter vector length
//  76: u32 reserved
//  80: u8 result format (0 Text, 1 PostgreSQL Binary)
//  81: u8 result-generation metadata state (0 unvalidated, 1 validated)
//  82: u16 reserved
//  84: u32 reserved
//  88: raw validated result-generation identity
//  96: i64 remaining PostgreSQL Bind payload budget (-1 before measurement)
// 104: u8 measurement state (0 unmeasured, 1 measuring, 2 measured)
// 105: u8[7] reserved
// The descriptor thunks treat this pointer as opaque. Only these callbacks and the driver package
// that created it may inspect it; neither side retains the pointer after the synchronous call.

fn context_base_valid(context: raw, driver: u8) -> bool {
  unsafe {
    if context.is_null() { return false }
    version: u32 := raw.load(context, 0)
    actual_driver: u8 := raw.load(context, 4)
    failure: u8 := raw.load(context, 5)
    reserved: u16 := raw.load(context, 6)
    row_reserved: u32 := raw.load(context, 20)
    cache: raw := raw.load(context, 24)
    cache_count: u32 := raw.load(context, 32)
    cache_reserved: u32 := raw.load(context, 36)
    if version != CONTEXT_VERSION || actual_driver != driver || failure > FAILURE_PARAMETER_BUDGET
      || reserved != 0 || row_reserved != 0 || cache_reserved != 0
      || cache_count > 2147483647 {
      return false
    }
    cache_empty := cache.is_null() && cache_count == 0
    cache_full := !cache.is_null() && cache_count > 0
    if !cache_empty && !cache_full { return false }
    result_format: u8 := raw.load(context, 80)
    metadata_state: u8 := raw.load(context, 81)
    metadata_reserved: u16 := raw.load(context, 82)
    metadata_reserved32: u32 := raw.load(context, 84)
    metadata_native: raw := raw.load(context, 88)
    metadata_native_bits: u64 := raw.load(context, 88)
    budget: i64 := raw.load(context, 96)
    measurement_state: u8 := raw.load(context, 104)
    mut tail: i64 := 105
    loop {
      if tail >= 112 { break }
      byte: u8 := raw.load(context, tail)
      if byte != 0 { return false }
      tail = tail + 1
    }
    if metadata_state > 1 || metadata_reserved != 0 || metadata_reserved32 != 0
      || measurement_state > 2 {
      return false
    }
    native: raw := raw.load(context, 8)
    native_bits: u64 := raw.load(context, 8)
    if metadata_state == 0 {
      if !metadata_native.is_null() { return false }
    } else {
      if native.is_null() || metadata_native_bits != native_bits { return false }
    }
    if driver == DRIVER_SQLITE {
      if failure > FAILURE_ENCODE { return false }
      values: raw := raw.load(context, 40)
      count: u32 := raw.load(context, 48)
      slot52: u32 := raw.load(context, 52)
      slot56: raw := raw.load(context, 56)
      slot64: raw := raw.load(context, 64)
      slot72: u32 := raw.load(context, 72)
      slot76: u32 := raw.load(context, 76)
      vector_empty := values.is_null() && count == 0
      vector_full := !values.is_null() && count > 0 && count <= 2147483647
      return (vector_empty || vector_full) && slot52 == 0
        && result_format == 0 && slot56.is_null() && slot64.is_null()
        && slot72 == 0 && slot76 == 0 && budget == -1 && measurement_state == 0
    }
    if driver != DRIVER_POSTGRES || result_format > 1 { return false }
    values: raw := raw.load(context, 40)
    types: raw := raw.load(context, 48)
    lengths: raw := raw.load(context, 56)
    formats: raw := raw.load(context, 64)
    count: u32 := raw.load(context, 72)
    vector_reserved: u32 := raw.load(context, 76)
    if vector_reserved != 0 || count > 65535 { return false }
    vector_empty := values.is_null() && types.is_null() && lengths.is_null() && formats.is_null()
    vector_full := !values.is_null() && !types.is_null() && !lengths.is_null() && !formats.is_null()
    if (count == 0 && !vector_empty) || (count > 0 && !vector_full) { return false }
    return (measurement_state == 0 && budget == -1)
      || ((measurement_state == 1 || measurement_state == 2) && budget >= 0)
  }
}

pub fn context_valid_v4(context: raw, driver: u8) -> bool = context_base_valid(context, driver)

// Install one new native result generation. Metadata proof is generation-local; reset it even
// when libpq reuses the same pointer address for a later PGresult.
pub fn set_native_generation_v1(context: raw, native: raw) -> bool {
  unsafe {
    if context.is_null() { return false }
    driver: u8 := raw.load(context, 4)
    if driver != DRIVER_SQLITE && driver != DRIVER_POSTGRES { return false }
    if !context_base_valid(context, driver) { return false }
    raw.store(context, 8, native)
    raw.store(context, 16, 0 as u32)
    raw.store(context, 81, 0 as u8)
    raw.store(context, 88, raw.null())
    return true
  }
}

fn context_ready(context: raw, driver: u8) -> bool {
  unsafe {
    if !context_base_valid(context, driver) { return false }
    failure: u8 := raw.load(context, 5)
    native: raw := raw.load(context, 8)
    return failure == FAILURE_NONE && !native.is_null()
  }
}

fn record_failure(context: raw, failure: u8) {
  unsafe {
    if context.is_null() { return }
    driver: u8 := raw.load(context, 4)
    if driver != DRIVER_SQLITE && driver != DRIVER_POSTGRES { return }
    if !context_base_valid(context, driver) { return }
    current: u8 := raw.load(context, 5)
    if current == FAILURE_NONE { raw.store(context, 5, failure) }
  }
}

fn native_name_matches(pointer: raw, expected: str) -> bool {
  unsafe {
    if pointer.is_null() { return false }
    bytes := expected.bytes()
    mut i := 0
    loop {
      if i >= bytes.len() { break }
      actual: u8 := raw.load(pointer, i)
      if actual != bytes[i] { return false }
      i = i + 1
    }
    terminal: u8 := raw.load(pointer, bytes.len())
    return terminal == 0
  }
}

// Versioned callbacks used only by compiler-generated static statement thunks.
pub fn bind_i64_v1(context: raw, protocol_ordinal: u32, value: i64) -> i32 {
  unsafe {
    if protocol_ordinal == 0 || protocol_ordinal > 2147483647 {
      record_failure(context, FAILURE_NATIVE)
      return 1
    }
    if context_ready(context, DRIVER_SQLITE) {
      statement: raw := raw.load(context, 8)
      // Static-artifact protocol ordinals are the native one-based parameter indices.
      status := sqlite3_bind_int64(statement, protocol_ordinal as i32, value)
      if status != SQLITE_OK {
        record_failure(context, FAILURE_NATIVE)
        return 1
      }
      return 0
    }
    if context_ready(context, DRIVER_POSTGRES) {
      if !ensure_postgres_slots(context, protocol_ordinal) {
        record_failure(context, FAILURE_NATIVE)
        return 1
      }
      values: raw := raw.load(context, 40)
      lengths: raw := raw.load(context, 56)
      formats: raw := raw.load(context, 64)
      offset := (protocol_ordinal as i64) - 1
      old: raw := raw.load(values, offset * 8)
      if !old.is_null() { raw.free(old) }
      text := postgres_i64_text(value)
      raw.store(values, offset * 8, text)
      length := postgres_c_string_length(text)
      raw.store(lengths, offset * 4, length)
      text_format: i32 := 0
      raw.store(formats, offset * 4, text_format)
      return 0
    }
    return 1
  }
}

fn ensure_sqlite_slots(context: raw, required: u32) -> bool {
  unsafe {
    if !context_base_valid(context, DRIVER_SQLITE) || required == 0 { return false }
    old_count: u32 := raw.load(context, 48)
    if required <= old_count { return true }
    values := raw.alloc((required as i64) * 8)
    old_values: raw := raw.load(context, 40)
    mut i: u32 := 0
    loop {
      if i >= required { break }
      value: raw := if i < old_count {
        raw.load(old_values, (i as i64) * 8)
      } else { raw.null() }
      raw.store(values, (i as i64) * 8, value)
      i = i + 1
    }
    if !old_values.is_null() { raw.free(old_values) }
    raw.store(context, 40, values)
    raw.store(context, 48, required)
    return true
  }
}

fn copy_str_bytes(value: str) -> raw {
  unsafe {
    bytes := value.bytes()
    output := raw.alloc(bytes.len() + 1)
    mut i := 0
    loop {
      if i >= bytes.len() { break }
      raw.store(output, i, bytes[i])
      i = i + 1
    }
    raw.store(output, bytes.len(), 0 as u8)
    return output
  }
}

fn copy_slice_bytes(value: slice<u8>) -> raw {
  unsafe {
    output := raw.alloc(value.len() + 1)
    mut i := 0
    loop {
      if i >= value.len() { break }
      raw.store(output, i, value[i])
      i = i + 1
    }
    raw.store(output, value.len(), 0 as u8)
    return output
  }
}

fn copy_binary_bytes(value: slice<u8>) -> raw {
  unsafe {
    output := raw.alloc(if value.len() == 0 { 1 } else { value.len() })
    mut i := 0
    loop {
      if i >= value.len() { break }
      raw.store(output, i, value[i])
      i = i + 1
    }
    if value.len() == 0 { raw.store(output, 0, 0 as u8) }
    return output
  }
}

fn postgres_text_has_nul(value: str) -> bool {
  bytes := value.bytes()
  mut i := 0
  loop {
    if i >= bytes.len() { break false }
    if bytes[i] == 0 { break true }
    i = i + 1
  }
}

fn postgres_bytea_hex(value: slice<u8>) -> raw {
  unsafe {
    length := value.len() * 2 + 2
    output := raw.alloc(length + 1)
    raw.store(output, 0, 92 as u8)
    raw.store(output, 1, 120 as u8)
    mut i := 0
    loop {
      if i >= value.len() { break }
      byte := value[i]
      high := byte / 16
      low := byte % 16
      raw.store(output, i * 2 + 2, if high < 10 { 48 + high } else { 87 + high })
      raw.store(output, i * 2 + 3, if low < 10 { 48 + low } else { 87 + low })
      i = i + 1
    }
    raw.store(output, length, 0 as u8)
    return output
  }
}

pub fn bind_text_v1(context: raw, protocol_ordinal: u32, value: str) -> i32 {
  unsafe {
    if protocol_ordinal == 0 || protocol_ordinal > 2147483647 || value.len() > 2147483647 {
      record_failure(context, FAILURE_ENCODE)
      return 1
    }
    if context_ready(context, DRIVER_SQLITE) {
      if !ensure_sqlite_slots(context, protocol_ordinal) {
        record_failure(context, FAILURE_NATIVE)
        return 1
      }
      statement: raw := raw.load(context, 8)
      copied := copy_str_bytes(value)
      status := sqlite3_bind_text(
        statement, protocol_ordinal as i32, copied, value.len() as i32, raw.null(),
      )
      if status != SQLITE_OK {
        raw.free(copied)
        record_failure(context, FAILURE_NATIVE)
        return 1
      }
      values: raw := raw.load(context, 40)
      offset := ((protocol_ordinal as i64) - 1) * 8
      old: raw := raw.load(values, offset)
      if !old.is_null() { raw.free(old) }
      raw.store(values, offset, copied)
      return 0
    }
    if context_ready(context, DRIVER_POSTGRES) {
      if postgres_text_has_nul(value) {
        record_failure(context, FAILURE_ENCODE)
        return 1
      }
      if !ensure_postgres_slots(context, protocol_ordinal) {
        record_failure(context, FAILURE_NATIVE)
        return 1
      }
      copied := copy_str_bytes(value)
      values: raw := raw.load(context, 40)
      lengths: raw := raw.load(context, 56)
      formats: raw := raw.load(context, 64)
      offset := (protocol_ordinal as i64) - 1
      old: raw := raw.load(values, offset * 8)
      if !old.is_null() { raw.free(old) }
      raw.store(values, offset * 8, copied)
      raw.store(lengths, offset * 4, value.len() as i32)
      raw.store(formats, offset * 4, 0 as i32)
      return 0
    }
    return 1
  }
}

pub fn bind_bytes_v1(context: raw, protocol_ordinal: u32, value: slice<u8>) -> i32 {
  unsafe {
    if protocol_ordinal == 0 || protocol_ordinal > 2147483647 {
      record_failure(context, FAILURE_NATIVE)
      return 1
    }
    if context_ready(context, DRIVER_SQLITE) {
      if value.len() > 2147483647 {
        record_failure(context, FAILURE_ENCODE)
        return 1
      }
      if !ensure_sqlite_slots(context, protocol_ordinal) {
        record_failure(context, FAILURE_NATIVE)
        return 1
      }
      statement: raw := raw.load(context, 8)
      copied := copy_slice_bytes(value)
      status := sqlite3_bind_blob(
        statement, protocol_ordinal as i32, copied, value.len() as i32, raw.null(),
      )
      if status != SQLITE_OK {
        raw.free(copied)
        record_failure(context, FAILURE_NATIVE)
        return 1
      }
      values: raw := raw.load(context, 40)
      offset := ((protocol_ordinal as i64) - 1) * 8
      old: raw := raw.load(values, offset)
      if !old.is_null() { raw.free(old) }
      raw.store(values, offset, copied)
      return 0
    }
    if context_ready(context, DRIVER_POSTGRES) {
      if value.len() > 1073741822 {
        record_failure(context, FAILURE_ENCODE)
        return 1
      }
      if !ensure_postgres_slots(context, protocol_ordinal) {
        record_failure(context, FAILURE_NATIVE)
        return 1
      }
      encoded := postgres_bytea_hex(value)
      encoded_length := value.len() * 2 + 2
      values: raw := raw.load(context, 40)
      lengths: raw := raw.load(context, 56)
      formats: raw := raw.load(context, 64)
      offset := (protocol_ordinal as i64) - 1
      old: raw := raw.load(values, offset * 8)
      if !old.is_null() { raw.free(old) }
      raw.store(values, offset * 8, encoded)
      raw.store(lengths, offset * 4, encoded_length as i32)
      raw.store(formats, offset * 4, 0 as i32)
      return 0
    }
    return 1
  }
}

fn bind_null_v2(context: raw, protocol_ordinal: u32) -> i32 {
  unsafe {
    if protocol_ordinal == 0 || protocol_ordinal > 2147483647 {
      record_failure(context, FAILURE_NATIVE)
      return 1
    }
    if context_ready(context, DRIVER_SQLITE) {
      if !ensure_sqlite_slots(context, protocol_ordinal) {
        record_failure(context, FAILURE_NATIVE)
        return 1
      }
      statement: raw := raw.load(context, 8)
      status := sqlite3_bind_null(statement, protocol_ordinal as i32)
      if status != SQLITE_OK {
        record_failure(context, FAILURE_NATIVE)
        return 1
      }
      values: raw := raw.load(context, 40)
      offset := ((protocol_ordinal as i64) - 1) * 8
      old: raw := raw.load(values, offset)
      if !old.is_null() { raw.free(old) }
      raw.store(values, offset, raw.null())
      return 0
    }
    if context_ready(context, DRIVER_POSTGRES) {
      format := postgres_selected_format(context, protocol_ordinal, 2)
      if format < 0 {
        record_failure(context, FAILURE_PARAMETER_REPRESENTATION)
        return 1
      }
      values: raw := raw.load(context, 40)
      lengths: raw := raw.load(context, 56)
      offset := (protocol_ordinal as i64) - 1
      old: raw := raw.load(values, offset * 8)
      if !old.is_null() { raw.free(old) }
      raw.store(values, offset * 8, raw.null())
      raw.store(lengths, offset * 4, 0 as i32)
      return 0
    }
    return 1
  }
}

fn bind_postgres_text_v2(
  context: raw,
  protocol_ordinal: u32,
  value: raw,
  length: i32,
) -> i32 {
  unsafe {
    if value.is_null() || length < 0
      || postgres_selected_format(context, protocol_ordinal, 2) != 0 {
      if !value.is_null() { raw.free(value) }
      record_failure(context, FAILURE_PARAMETER_REPRESENTATION)
      return 1
    }
    values: raw := raw.load(context, 40)
    lengths: raw := raw.load(context, 56)
    offset := (protocol_ordinal as i64) - 1
    old: raw := raw.load(values, offset * 8)
    if !old.is_null() { raw.free(old) }
    raw.store(values, offset * 8, value)
    raw.store(lengths, offset * 4, length)
    return 0
  }
}

fn bind_postgres_binary_v2(
  context: raw,
  protocol_ordinal: u32,
  value: raw,
  length: i32,
) -> i32 {
  unsafe {
    if value.is_null() || length < 0
      || postgres_selected_format(context, protocol_ordinal, 2) != 1 {
      if !value.is_null() { raw.free(value) }
      record_failure(context, FAILURE_PARAMETER_REPRESENTATION)
      return 1
    }
    values: raw := raw.load(context, 40)
    lengths: raw := raw.load(context, 56)
    offset := (protocol_ordinal as i64) - 1
    old: raw := raw.load(values, offset * 8)
    if !old.is_null() { raw.free(old) }
    raw.store(values, offset * 8, value)
    raw.store(lengths, offset * 4, length)
    return 0
  }
}

fn binary_u64(value: u64, bytes: i64) -> raw {
  unsafe {
    output := raw.alloc(bytes)
    mut i: i64 := 0
    loop {
      if i >= bytes { break }
      shift := ((bytes - i - 1) * 8) as u64
      raw.store(output, i, ((value >> shift) & 255) as u8)
      i = i + 1
    }
    return output
  }
}

fn bind_integer_v2(context: raw, protocol_ordinal: u32, value: i64) -> i32 {
  unsafe {
    if protocol_ordinal == 0 || protocol_ordinal > 2147483647 {
      record_failure(context, FAILURE_NATIVE)
      return 1
    }
    if context_ready(context, DRIVER_SQLITE) {
      statement: raw := raw.load(context, 8)
      status := sqlite3_bind_int64(statement, protocol_ordinal as i32, value)
      if status != SQLITE_OK {
        record_failure(context, FAILURE_NATIVE)
        return 1
      }
      return 0
    }
    if context_ready(context, DRIVER_POSTGRES) {
      format := postgres_selected_format(context, protocol_ordinal, 2)
      if format == 1 {
        // The concrete public callback supplies the required width below. This helper is used
        // only by Text integer callbacks.
        record_failure(context, FAILURE_PARAMETER_REPRESENTATION)
        return 1
      }
      text := postgres_i64_text(value)
      return bind_postgres_text_v2(
        context, protocol_ordinal, text, postgres_c_string_length(text),
      )
    }
    return 1
  }
}

fn postgres_f64_text(value: f64) -> raw {
  unsafe {
    length := align_rt_f64_text_len(value)
    if length < 0 { return raw.null() }
    output := raw.alloc(length + 1)
    if align_rt_f64_text_write(value, output, length) != length {
      raw.free(output)
      return raw.null()
    }
    raw.store(output, length, 0 as u8)
    return output
  }
}

fn postgres_f32_text(value: f32) -> raw {
  unsafe {
    length := align_rt_f32_text_len(value)
    if length < 0 { return raw.null() }
    output := raw.alloc(length + 1)
    if align_rt_f32_text_write(value, output, length) != length {
      raw.free(output)
      return raw.null()
    }
    raw.store(output, length, 0 as u8)
    return output
  }
}

fn bind_float_v2(context: raw, protocol_ordinal: u32, value: f64) -> i32 {
  unsafe {
    if protocol_ordinal == 0 || protocol_ordinal > 2147483647 {
      record_failure(context, FAILURE_NATIVE)
      return 1
    }
    if context_ready(context, DRIVER_SQLITE) {
      statement: raw := raw.load(context, 8)
      status := sqlite3_bind_double(statement, protocol_ordinal as i32, value)
      if status != SQLITE_OK {
        record_failure(context, FAILURE_NATIVE)
        return 1
      }
      return 0
    }
    if context_ready(context, DRIVER_POSTGRES) {
      format := postgres_selected_format(context, protocol_ordinal, 2)
      if format == 1 {
        record_failure(context, FAILURE_PARAMETER_REPRESENTATION)
        return 1
      }
      text := postgres_f64_text(value)
      return bind_postgres_text_v2(
        context, protocol_ordinal, text, postgres_c_string_length(text),
      )
    }
    return 1
  }
}

pub fn bind_bool_v2(context: raw, protocol_ordinal: u32, value: Option<bool>) -> i32 {
  return match value {
    None => bind_null_v2(context, protocol_ordinal)
    Some(actual) => {
      unsafe {
        if context_ready(context, DRIVER_POSTGRES) {
          format := postgres_selected_format(context, protocol_ordinal, 2)
          if format == 1 {
            payload := raw.alloc(1)
            raw.store(payload, 0, if actual { 1 as u8 } else { 0 as u8 })
            return bind_postgres_binary_v2(context, protocol_ordinal, payload, 1)
          }
          text := copy_str_bytes(if actual { "t" } else { "f" })
          return bind_postgres_text_v2(context, protocol_ordinal, text, 1)
        }
      }
      bind_integer_v2(context, protocol_ordinal, if actual { 1 } else { 0 })
    }
  }
}

pub fn bind_i16_v2(context: raw, protocol_ordinal: u32, value: Option<i16>) -> i32 {
  return match value {
    None => bind_null_v2(context, protocol_ordinal)
    Some(actual) => unsafe {
      if context_ready(context, DRIVER_POSTGRES)
        && postgres_selected_format(context, protocol_ordinal, 2) == 1 {
        return bind_postgres_binary_v2(
          context, protocol_ordinal, binary_u64(actual as u16 as u64, 2), 2,
        )
      }
      bind_integer_v2(context, protocol_ordinal, actual as i64)
    }
  }
}

pub fn bind_i32_v2(context: raw, protocol_ordinal: u32, value: Option<i32>) -> i32 {
  return match value {
    None => bind_null_v2(context, protocol_ordinal)
    Some(actual) => unsafe {
      if context_ready(context, DRIVER_POSTGRES)
        && postgres_selected_format(context, protocol_ordinal, 2) == 1 {
        return bind_postgres_binary_v2(
          context, protocol_ordinal, binary_u64(actual as u32 as u64, 4), 4,
        )
      }
      bind_integer_v2(context, protocol_ordinal, actual as i64)
    }
  }
}

pub fn bind_i64_v2(context: raw, protocol_ordinal: u32, value: Option<i64>) -> i32 {
  return match value {
    None => bind_null_v2(context, protocol_ordinal)
    Some(actual) => unsafe {
      if context_ready(context, DRIVER_POSTGRES)
        && postgres_selected_format(context, protocol_ordinal, 2) == 1 {
        return bind_postgres_binary_v2(
          context, protocol_ordinal, binary_u64(actual as u64, 8), 8,
        )
      }
      bind_integer_v2(context, protocol_ordinal, actual)
    }
  }
}

pub fn bind_f32_v2(context: raw, protocol_ordinal: u32, value: Option<f32>) -> i32 {
  return match value {
    None => bind_null_v2(context, protocol_ordinal)
    Some(actual) => unsafe {
      if context_ready(context, DRIVER_POSTGRES)
        && postgres_selected_format(context, protocol_ordinal, 2) == 1 {
        bits := align_rt_f32_to_bits(actual)
        return bind_postgres_binary_v2(
          context, protocol_ordinal, binary_u64(bits as u64, 4), 4,
        )
      }
      if context_ready(context, DRIVER_POSTGRES) {
        text := postgres_f32_text(actual)
        return bind_postgres_text_v2(
          context, protocol_ordinal, text, postgres_c_string_length(text),
        )
      }
      bind_float_v2(context, protocol_ordinal, actual as f64)
    }
  }
}

pub fn bind_f64_v2(context: raw, protocol_ordinal: u32, value: Option<f64>) -> i32 {
  return match value {
    None => bind_null_v2(context, protocol_ordinal)
    Some(actual) => unsafe {
      if context_ready(context, DRIVER_POSTGRES)
        && postgres_selected_format(context, protocol_ordinal, 2) == 1 {
        bits := align_rt_f64_to_bits(actual)
        return bind_postgres_binary_v2(
          context, protocol_ordinal, binary_u64(bits, 8), 8,
        )
      }
      bind_float_v2(context, protocol_ordinal, actual)
    }
  }
}

pub fn bind_text_v2(context: raw, protocol_ordinal: u32, value: Option<str>) -> i32 {
  return match value {
    None => bind_null_v2(context, protocol_ordinal)
    Some(actual) => unsafe {
      if context_ready(context, DRIVER_POSTGRES)
        && postgres_selected_format(context, protocol_ordinal, 2) == 1 {
        if postgres_text_has_nul(actual) {
          record_failure(context, FAILURE_PARAMETER_NUL)
          return 1
        }
        copied := copy_str_bytes(actual)
        return bind_postgres_binary_v2(
          context, protocol_ordinal, copied, actual.len() as i32,
        )
      }
      bind_text_v1(context, protocol_ordinal, actual)
    }
  }
}

pub fn bind_bytes_v2(context: raw, protocol_ordinal: u32, value: Option<slice<u8>>) -> i32 {
  return match value {
    None => bind_null_v2(context, protocol_ordinal)
    Some(actual) => unsafe {
      if context_ready(context, DRIVER_POSTGRES)
        && postgres_selected_format(context, protocol_ordinal, 2) == 1 {
        copied := copy_binary_bytes(actual)
        return bind_postgres_binary_v2(
          context, protocol_ordinal, copied, actual.len() as i32,
        )
      }
      bind_bytes_v1(context, protocol_ordinal, actual)
    }
  }
}

fn ensure_postgres_slots(context: raw, required: u32) -> bool {
  unsafe {
    if !context_base_valid(context, DRIVER_POSTGRES) || required == 0 { return false }
    old_count: u32 := raw.load(context, 72)
    if required <= old_count { return true }
    values := raw.alloc((required as i64) * 8)
    types := raw.alloc((required as i64) * 4)
    lengths := raw.alloc((required as i64) * 4)
    formats := raw.alloc((required as i64) * 4)
    old_values: raw := raw.load(context, 40)
    old_types: raw := raw.load(context, 48)
    old_lengths: raw := raw.load(context, 56)
    old_formats: raw := raw.load(context, 64)
    mut i: u32 := 0
    loop {
      if i >= required { break }
      mut value: raw := raw.null()
      mut oid: u32 := 0
      mut length: i32 := 0
      mut format: i32 := 0
      if i < old_count {
        value = raw.load(old_values, (i as i64) * 8)
        oid = raw.load(old_types, (i as i64) * 4)
        length = raw.load(old_lengths, (i as i64) * 4)
        format = raw.load(old_formats, (i as i64) * 4)
      }
      raw.store(values, (i as i64) * 8, value)
      raw.store(types, (i as i64) * 4, oid)
      raw.store(lengths, (i as i64) * 4, length)
      raw.store(formats, (i as i64) * 4, format)
      i = i + 1
    }
    if !old_values.is_null() { raw.free(old_values) }
    if !old_types.is_null() { raw.free(old_types) }
    if !old_lengths.is_null() { raw.free(old_lengths) }
    if !old_formats.is_null() { raw.free(old_formats) }
    raw.store(context, 40, values)
    raw.store(context, 48, types)
    raw.store(context, 56, lengths)
    raw.store(context, 64, formats)
    raw.store(context, 72, required)
    return true
  }
}

// Q4a's PostgreSQL prepare engine sizes the opaque parameter vectors before the static option
// thunk writes inferred OIDs. The layout remains owned here rather than duplicated by the driver.
pub fn ensure_postgres_parameters_v1(context: raw, required: u32) -> bool {
  if required == 0 { return context_base_valid(context, DRIVER_POSTGRES) }
  return ensure_postgres_slots(context, required)
}

// Form the execution-owned full parameter-format vector. Static validation may already have sized
// the parallel PostgreSQL vectors; this operation initializes every format to Text and installs the
// one libpq-wide result format before either binder pass.
pub fn install_postgres_formats_v1(
  context: raw,
  count: u32,
  result_format: u8,
) -> bool {
  unsafe {
    if result_format > 1 || count > 65535 || !context_base_valid(context, DRIVER_POSTGRES) {
      return false
    }
    if count > 0 && !ensure_postgres_slots(context, count) { return false }
    actual: u32 := raw.load(context, 72)
    if actual != count { return false }
    formats: raw := raw.load(context, 64)
    mut i: u32 := 0
    loop {
      if i >= count { break }
      raw.store(formats, (i as i64) * 4, 0 as i32)
      i = i + 1
    }
    raw.store(context, 80, result_format)
    return context_base_valid(context, DRIVER_POSTGRES)
  }
}

pub fn set_postgres_parameter_format_v1(
  context: raw,
  protocol_ordinal: u32,
  format: u8,
) -> bool {
  unsafe {
    if !context_base_valid(context, DRIVER_POSTGRES) || format > 1 || protocol_ordinal == 0 {
      return false
    }
    count: u32 := raw.load(context, 72)
    if protocol_ordinal > count { return false }
    formats: raw := raw.load(context, 64)
    raw.store(formats, ((protocol_ordinal as i64) - 1) * 4, format as i32)
    return true
  }
}

pub fn begin_postgres_measure_v1(context: raw, budget: i64) -> bool {
  unsafe {
    if budget < 0 || !context_base_valid(context, DRIVER_POSTGRES) { return false }
    state: u8 := raw.load(context, 104)
    current: i64 := raw.load(context, 96)
    if state != 0 || current != -1 { return false }
    raw.store(context, 96, budget)
    raw.store(context, 104, 1 as u8)
    return context_base_valid(context, DRIVER_POSTGRES)
  }
}

pub fn finish_postgres_measure_v1(context: raw) -> bool {
  unsafe {
    if !context_base_valid(context, DRIVER_POSTGRES) { return false }
    state: u8 := raw.load(context, 104)
    if state != 1 { return false }
    raw.store(context, 104, 2 as u8)
    return context_base_valid(context, DRIVER_POSTGRES)
  }
}

fn postgres_selected_format(context: raw, protocol_ordinal: u32, state: u8) -> i32 {
  unsafe {
    if !context_base_valid(context, DRIVER_POSTGRES) || protocol_ordinal == 0 { return -1 }
    actual_state: u8 := raw.load(context, 104)
    count: u32 := raw.load(context, 72)
    if actual_state != state || protocol_ordinal > count { return -1 }
    formats: raw := raw.load(context, 64)
    format: i32 := raw.load(formats, ((protocol_ordinal as i64) - 1) * 4)
    if format != 0 && format != 1 { return -1 }
    return format
  }
}

fn debit_postgres_budget(context: raw, length: i64) -> i32 {
  unsafe {
    if length < 0 {
      record_failure(context, FAILURE_PARAMETER_BUDGET)
      return 1
    }
    budget: i64 := raw.load(context, 96)
    if budget < length {
      record_failure(context, FAILURE_PARAMETER_BUDGET)
      return 1
    }
    raw.store(context, 96, budget - length)
    return 0
  }
}

fn decimal_i64_length(value: i64) -> i64 {
  mut remaining := value
  mut length: i64 := if value < 0 { 1 } else { 0 }
  loop {
    length = length + 1
    remaining = remaining / 10
    if remaining == 0 { break }
  }
  return length
}

fn measure_null_v1(context: raw, protocol_ordinal: u32) -> i32 {
  if postgres_selected_format(context, protocol_ordinal, 1) < 0 {
    record_failure(context, FAILURE_PARAMETER_REPRESENTATION)
    return 1
  }
  return debit_postgres_budget(context, 0)
}

pub fn measure_bool_v1(context: raw, protocol_ordinal: u32, value: Option<bool>) -> i32 {
  return match value {
    None => measure_null_v1(context, protocol_ordinal)
    Some(_) => {
      format := postgres_selected_format(context, protocol_ordinal, 1)
      if format < 0 { record_failure(context, FAILURE_PARAMETER_REPRESENTATION); return 1 }
      debit_postgres_budget(context, 1)
    }
  }
}

pub fn measure_i16_v1(context: raw, protocol_ordinal: u32, value: Option<i16>) -> i32 {
  return match value {
    None => measure_null_v1(context, protocol_ordinal)
    Some(actual) => {
      format := postgres_selected_format(context, protocol_ordinal, 1)
      if format < 0 { record_failure(context, FAILURE_PARAMETER_REPRESENTATION); return 1 }
      debit_postgres_budget(context, if format == 1 { 2 } else {
        decimal_i64_length(actual as i64)
      })
    }
  }
}

pub fn measure_i32_v1(context: raw, protocol_ordinal: u32, value: Option<i32>) -> i32 {
  return match value {
    None => measure_null_v1(context, protocol_ordinal)
    Some(actual) => {
      format := postgres_selected_format(context, protocol_ordinal, 1)
      if format < 0 { record_failure(context, FAILURE_PARAMETER_REPRESENTATION); return 1 }
      debit_postgres_budget(context, if format == 1 { 4 } else {
        decimal_i64_length(actual as i64)
      })
    }
  }
}

pub fn measure_i64_v1(context: raw, protocol_ordinal: u32, value: Option<i64>) -> i32 {
  return match value {
    None => measure_null_v1(context, protocol_ordinal)
    Some(actual) => {
      format := postgres_selected_format(context, protocol_ordinal, 1)
      if format < 0 { record_failure(context, FAILURE_PARAMETER_REPRESENTATION); return 1 }
      debit_postgres_budget(context, if format == 1 { 8 } else {
        decimal_i64_length(actual)
      })
    }
  }
}

pub fn measure_f32_v1(context: raw, protocol_ordinal: u32, value: Option<f32>) -> i32 {
  return match value {
    None => measure_null_v1(context, protocol_ordinal)
    Some(actual) => {
      format := postgres_selected_format(context, protocol_ordinal, 1)
      if format < 0 { record_failure(context, FAILURE_PARAMETER_REPRESENTATION); return 1 }
      debit_postgres_budget(context, if format == 1 { 4 } else {
        unsafe { align_rt_f32_text_len(actual) }
      })
    }
  }
}

pub fn measure_f64_v1(context: raw, protocol_ordinal: u32, value: Option<f64>) -> i32 {
  return match value {
    None => measure_null_v1(context, protocol_ordinal)
    Some(actual) => {
      format := postgres_selected_format(context, protocol_ordinal, 1)
      if format < 0 { record_failure(context, FAILURE_PARAMETER_REPRESENTATION); return 1 }
      debit_postgres_budget(context, if format == 1 { 8 } else {
        unsafe { align_rt_f64_text_len(actual) }
      })
    }
  }
}

pub fn measure_text_v1(context: raw, protocol_ordinal: u32, value: Option<str>) -> i32 {
  return match value {
    None => measure_null_v1(context, protocol_ordinal)
    Some(actual) => {
      format := postgres_selected_format(context, protocol_ordinal, 1)
      if format < 0 { record_failure(context, FAILURE_PARAMETER_REPRESENTATION); return 1 }
      if postgres_text_has_nul(actual) {
        record_failure(context, FAILURE_PARAMETER_NUL)
        return 1
      }
      debit_postgres_budget(context, actual.len())
    }
  }
}

pub fn measure_bytes_v1(context: raw, protocol_ordinal: u32, value: Option<slice<u8>>) -> i32 {
  return match value {
    None => measure_null_v1(context, protocol_ordinal)
    Some(actual) => {
      format := postgres_selected_format(context, protocol_ordinal, 1)
      if format < 0 { record_failure(context, FAILURE_PARAMETER_REPRESENTATION); return 1 }
      if format == 1 { return debit_postgres_budget(context, actual.len()) }
      if actual.len() > 4611686018427387902 {
        record_failure(context, FAILURE_PARAMETER_BUDGET)
        return 1
      }
      debit_postgres_budget(context, actual.len() * 2 + 2)
    }
  }
}

fn postgres_i64_text(value: i64) -> raw {
  unsafe {
    length := decimal_i64_length(value)
    result := raw.alloc(length + 1)
    raw.store(result, length, 0 as u8)
    mut remaining := value
    mut index := length
    loop {
      quotient := remaining / 10
      remainder := remaining - quotient * 10
      digit := if remainder < 0 { -remainder } else { remainder }
      index = index - 1
      raw.store(result, index, (48 + digit) as u8)
      remaining = quotient
      if remaining == 0 { break }
    }
    if value < 0 { raw.store(result, 0, 45 as u8) }
    return result
  }
}

pub fn postgres_c_string_length(pointer: raw) -> i32 {
  unsafe {
    mut length: i32 := 0
    loop {
      byte: u8 := raw.load(pointer, length as i64)
      if byte == 0 { break }
      length = length + 1
    }
    return length
  }
}

pub fn require_sqlite_version_v1(
  context: raw,
  major: u32,
  minor: u32,
  patch: u32,
) -> i32 {
  unsafe {
    if !context_base_valid(context, DRIVER_SQLITE) { return 1 }
    current: u8 := raw.load(context, 5)
    if current != FAILURE_NONE { return 1 }
    linked := sqlite3_libversion_number()
    linked_major := linked / 1000000
    linked_minor := (linked / 1000) % 1000
    linked_patch := linked % 1000
    required_too_new := major > (linked_major as u32)
      || (major == (linked_major as u32) && minor > (linked_minor as u32))
      || (major == (linked_major as u32) && minor == (linked_minor as u32)
        && patch > (linked_patch as u32))
    if required_too_new {
      record_failure(context, FAILURE_UNSUPPORTED)
      return 1
    }
    return 0
  }
}

pub fn set_postgres_i64_type_v1(
  context: raw,
  protocol_ordinal: u32,
  canonical_type_name: str,
) -> i32 {
  unsafe {
    if !context_base_valid(context, DRIVER_POSTGRES) { return 1 }
    current: u8 := raw.load(context, 5)
    if current != FAILURE_NONE || protocol_ordinal == 0 { return 1 }
    if canonical_type_name != "int8" {
      record_failure(context, FAILURE_UNSUPPORTED)
      return 1
    }
    if !ensure_postgres_slots(context, protocol_ordinal) {
      record_failure(context, FAILURE_NATIVE)
      return 1
    }
    types: raw := raw.load(context, 48)
    raw.store(types, ((protocol_ordinal as i64) - 1) * 4, POSTGRES_INT8_OID)
    return 0
  }
}

pub fn set_postgres_type_v2(
  context: raw,
  protocol_ordinal: u32,
  canonical_type_name: str,
) -> i32 {
  unsafe {
    if !context_base_valid(context, DRIVER_POSTGRES) { return 1 }
    current: u8 := raw.load(context, 5)
    if current != FAILURE_NONE || protocol_ordinal == 0 { return 1 }
    mut oid: u32 := 0
    if canonical_type_name == "bool" { oid = POSTGRES_BOOL_OID }
    if canonical_type_name == "int2" { oid = POSTGRES_INT2_OID }
    if canonical_type_name == "int4" { oid = POSTGRES_INT4_OID }
    if canonical_type_name == "int8" { oid = POSTGRES_INT8_OID }
    if canonical_type_name == "float4" { oid = POSTGRES_FLOAT4_OID }
    if canonical_type_name == "float8" { oid = POSTGRES_FLOAT8_OID }
    if canonical_type_name == "text" { oid = POSTGRES_TEXT_OID }
    if canonical_type_name == "varchar" { oid = POSTGRES_VARCHAR_OID }
    if canonical_type_name == "name" { oid = POSTGRES_NAME_OID }
    if canonical_type_name == "bytea" { oid = POSTGRES_BYTEA_OID }
    if oid == 0 {
      record_failure(context, FAILURE_UNSUPPORTED)
      return 1
    }
    if !ensure_postgres_slots(context, protocol_ordinal) {
      record_failure(context, FAILURE_NATIVE)
      return 1
    }
    types: raw := raw.load(context, 48)
    raw.store(types, ((protocol_ordinal as i64) - 1) * 4, oid)
    return 0
  }
}

pub fn validate_row_count_v1(context: raw, expected: u32) -> i32 {
  unsafe {
    if context.is_null() { return 1 }
    driver: u8 := raw.load(context, 4)
    if !context_ready(context, driver) { return 1 }
    native: raw := raw.load(context, 8)
    count := if driver == DRIVER_SQLITE {
      sqlite3_column_count(native)
    } else {
      if driver != DRIVER_POSTGRES { return 1 }
      PQnfields(native)
    }
    if count < 0 || (count as u32) != expected {
      record_failure(context, FAILURE_ROW)
      return 1
    }
    old_cache: raw := raw.load(context, 24)
    if !old_cache.is_null() { raw.free(old_cache) }
    if expected == 0 {
      raw.store(context, 24, raw.null())
    } else {
      raw.store(context, 24, raw.alloc((expected as i64) * 8))
    }
    raw.store(context, 32, expected)
    return 0
  }
}

pub fn validate_i64_v1(context: raw, ordinal: u32, expected_name: str) -> i32 {
  unsafe {
    if context.is_null() { return 1 }
    driver: u8 := raw.load(context, 4)
    if !context_ready(context, driver) { return 1 }
    count: u32 := raw.load(context, 32)
    cache: raw := raw.load(context, 24)
    if ordinal >= count || cache.is_null() || ordinal > 2147483647 {
      record_failure(context, FAILURE_ROW)
      return 1
    }
    native: raw := raw.load(context, 8)
    index := ordinal as i32
    mut value: i64 := 0
    if driver == DRIVER_SQLITE {
      name := sqlite3_column_name(native, index)
      if !native_name_matches(name, expected_name)
        || sqlite3_column_type(native, index) != SQLITE_INTEGER {
        record_failure(context, FAILURE_ROW)
        return 1
      }
      value = sqlite3_column_int64(native, index)
    } else {
      if driver != DRIVER_POSTGRES {
        record_failure(context, FAILURE_ROW)
        return 1
      }
      row: u32 := raw.load(context, 16)
      name := PQfname(native, index)
      if !native_name_matches(name, expected_name) || PQftype(native, index) != POSTGRES_INT8_OID
        || PQgetisnull(native, row as i32, index) != 0 {
        record_failure(context, FAILURE_ROW)
        return 1
      }
      pointer := PQgetvalue(native, row as i32, index)
      length := PQgetlength(native, row as i32, index)
      parsed := parse_postgres_i64(pointer, length)
      match parsed {
        Some(parsed_value) => { value = parsed_value }
        None => {
          record_failure(context, FAILURE_ROW)
          return 1
        }
      }
    }
    raw.store(cache, (ordinal as i64) * 8, value)
    return 0
  }
}

fn parse_postgres_i64(pointer: raw, length: i32) -> Option<i64> {
  unsafe {
    if pointer.is_null() || length <= 0 { return None }
    mut index: i32 := 0
    mut negative := false
    first: u8 := raw.load(pointer, 0)
    if first == 45 {
      negative = true
      index = 1
      if length == 1 { return None }
    }
    limit: i64 := if negative { -9223372036854775808 } else { -9223372036854775807 }
    multiply_limit := limit / 10
    mut value: i64 := 0
    loop {
      if index >= length { break }
      byte: u8 := raw.load(pointer, index as i64)
      if byte < 48 || byte > 57 { return None }
      digit := (byte - 48) as i64
      if value < multiply_limit { return None }
      value = value * 10
      if value < limit + digit { return None }
      value = value - digit
      index = index + 1
    }
    if negative { return Some(value) }
    return Some(-value)
  }
}

pub fn read_i64_v1(context: raw, ordinal: u32) -> i64 {
  unsafe {
    if context.is_null() { return 0 }
    driver: u8 := raw.load(context, 4)
    if driver != DRIVER_SQLITE && driver != DRIVER_POSTGRES { return 0 }
    if !context_base_valid(context, driver) { return 0 }
    failure: u8 := raw.load(context, 5)
    count: u32 := raw.load(context, 32)
    cache: raw := raw.load(context, 24)
    if failure != FAILURE_NONE || ordinal >= count || cache.is_null() { return 0 }
    value: i64 := raw.load(cache, (ordinal as i64) * 8)
    return value
  }
}

fn row_cache_entry(context: raw, ordinal: u32) -> raw {
  unsafe {
    if context.is_null() { return raw.null() }
    driver: u8 := raw.load(context, 4)
    if driver != DRIVER_SQLITE && driver != DRIVER_POSTGRES { return raw.null() }
    if !context_base_valid(context, driver) { return raw.null() }
    failure: u8 := raw.load(context, 5)
    count: u32 := raw.load(context, 32)
    cache: raw := raw.load(context, 24)
    if failure != FAILURE_NONE || ordinal >= count || cache.is_null() { return raw.null() }
    return raw.offset(cache, (ordinal as i64) * ROW_CACHE_STRIDE)
  }
}

fn reset_row_cache_v2(context: raw) {
  unsafe {
    if context.is_null() { return }
    cache: raw := raw.load(context, 24)
    count: u32 := raw.load(context, 32)
    if !cache.is_null() {
      mut ordinal: u32 := 0
      loop {
        if ordinal >= count { break }
        entry := raw.offset(cache, (ordinal as i64) * ROW_CACHE_STRIDE)
        owned: u8 := raw.load(entry, 17)
        if owned != 0 {
          pointer: raw := raw.load(entry, 0)
          if !pointer.is_null() { raw.free(pointer) }
        }
        raw.store(entry, 0, 0 as i64)
        raw.store(entry, 8, 0 as i64)
        raw.store(entry, 16, 0 as u8)
        raw.store(entry, 17, 0 as u8)
        raw.store(entry, 18, 0 as u16)
        raw.store(entry, 20, 0 as u32)
        ordinal = ordinal + 1
      }
    }
  }
}

pub fn release_row_cache_v2(context: raw) {
  unsafe {
    if context.is_null() { return }
    reset_row_cache_v2(context)
    cache: raw := raw.load(context, 24)
    if !cache.is_null() {
      raw.free(cache)
    }
    raw.store(context, 24, raw.null())
    raw.store(context, 32, 0 as u32)
  }
}

pub fn validate_row_count_v2(context: raw, expected: u32) -> i32 {
  unsafe {
    if context.is_null() { return 1 }
    driver: u8 := raw.load(context, 4)
    if !context_ready(context, driver) { return 1 }
    native: raw := raw.load(context, 8)
    count := if driver == DRIVER_SQLITE {
      sqlite3_column_count(native)
    } else {
      if driver != DRIVER_POSTGRES { return 1 }
      PQnfields(native)
    }
    if count < 0 || (count as u32) != expected {
      record_failure(context, FAILURE_ROW)
      return 1
    }
    cache: raw := raw.load(context, 24)
    cached_count: u32 := raw.load(context, 32)
    reusable := cached_count == expected
      && ((expected == 0 && cache.is_null()) || (expected > 0 && !cache.is_null()))
    if reusable {
      reset_row_cache_v2(context)
    } else {
      release_row_cache_v2(context)
    }
    if expected > 0 && !reusable {
      new_cache := raw.alloc((expected as i64) * ROW_CACHE_STRIDE)
      mut ordinal: u32 := 0
      loop {
        if ordinal >= expected { break }
        entry := raw.offset(new_cache, (ordinal as i64) * ROW_CACHE_STRIDE)
        raw.store(entry, 0, 0 as i64)
        raw.store(entry, 8, 0 as i64)
        raw.store(entry, 16, 0 as u8)
        raw.store(entry, 17, 0 as u8)
        raw.store(entry, 18, 0 as u16)
        raw.store(entry, 20, 0 as u32)
        ordinal = ordinal + 1
      }
      raw.store(context, 24, new_cache)
    }
    raw.store(context, 32, expected)
    return 0
  }
}

fn bytes_equal(pointer: raw, length: i32, expected: str) -> bool {
  unsafe {
    if length < 0 || (length as i64) != expected.len() { return false }
    if pointer.is_null() { return length == 0 }
    bytes := expected.bytes()
    mut i := 0
    loop {
      if i >= bytes.len() { break }
      actual: u8 := raw.load(pointer, i)
      if actual != bytes[i] { return false }
      i = i + 1
    }
    return true
  }
}

fn parse_postgres_bool(pointer: raw, length: i32) -> Option<bool> {
  unsafe {
    if pointer.is_null() || length != 1 { return None }
    value: u8 := raw.load(pointer, 0)
    if value == 116 { return Some(true) }
    if value == 102 { return Some(false) }
    return None
  }
}

fn parse_postgres_f64(pointer: raw, length: i32) -> Option<f64> {
  unsafe {
    if pointer.is_null() || length <= 0 || length > 128 { return None }
    if bytes_equal(pointer, length, "NaN") { return Some(0.0 / 0.0) }
    if bytes_equal(pointer, length, "Infinity") { return Some(1.0 / 0.0) }
    if bytes_equal(pointer, length, "-Infinity") { return Some(-1.0 / 0.0) }
    mut index: i32 := 0
    mut negative := false
    first: u8 := raw.load(pointer, 0)
    if first == 45 {
      negative = true
      index = 1
      if index >= length { return None }
    } else {
      if first == 43 {
        index = 1
        if index >= length { return None }
      }
    }
    mut value: f64 := 0.0
    mut scale: f64 := 1.0
    mut fractional := false
    mut digits: i32 := 0
    loop {
      if index >= length { break }
      byte: u8 := raw.load(pointer, index as i64)
      if byte == 46 && !fractional {
        fractional = true
        index = index + 1
      } else {
        if byte == 101 || byte == 69 { break }
        if byte < 48 || byte > 57 { return None }
        digit := (byte - 48) as f64
        if fractional {
          scale = scale / 10.0
          value = value + digit * scale
        } else {
          value = value * 10.0 + digit
        }
        digits = digits + 1
        index = index + 1
      }
    }
    if digits == 0 { return None }
    mut exponent: i32 := 0
    mut exponent_negative := false
    if index < length {
      marker: u8 := raw.load(pointer, index as i64)
      if marker != 101 && marker != 69 { return None }
      index = index + 1
      if index >= length { return None }
      sign: u8 := raw.load(pointer, index as i64)
      if sign == 45 {
        exponent_negative = true
        index = index + 1
      } else {
        if sign == 43 { index = index + 1 }
      }
      if index >= length { return None }
      mut exponent_digits: i32 := 0
      loop {
        if index >= length { break }
        byte: u8 := raw.load(pointer, index as i64)
        if byte < 48 || byte > 57 { return None }
        if exponent > 400 { return None }
        exponent = exponent * 10 + ((byte - 48) as i32)
        exponent_digits = exponent_digits + 1
        index = index + 1
      }
      if exponent_digits == 0 { return None }
    }
    mut applied: i32 := 0
    loop {
      if applied >= exponent { break }
      value = if exponent_negative { value / 10.0 } else { value * 10.0 }
      applied = applied + 1
    }
    if negative { value = -value }
    return Some(value)
  }
}

fn hex_nibble(byte: u8) -> Option<u8> {
  if byte >= 48 && byte <= 57 { return Some(byte - 48) }
  if byte >= 97 && byte <= 102 { return Some(byte - 87) }
  if byte >= 65 && byte <= 70 { return Some(byte - 55) }
  return None
}

fn decode_postgres_bytea(pointer: raw, length: i32) -> raw {
  unsafe {
    if pointer.is_null() || length < 2 || length % 2 != 0 { return raw.null() }
    prefix0: u8 := raw.load(pointer, 0)
    prefix1: u8 := raw.load(pointer, 1)
    if prefix0 != 92 || prefix1 != 120 { return raw.null() }
    decoded_length := (length - 2) / 2
    output := raw.alloc(if decoded_length == 0 { 1 } else { decoded_length as i64 })
    mut i: i32 := 0
    loop {
      if i >= decoded_length { break }
      high := hex_nibble(raw.load(pointer, (i as i64) * 2 + 2))
      low := hex_nibble(raw.load(pointer, (i as i64) * 2 + 3))
      match high {
        None => { raw.free(output); return raw.null() }
        Some(high_value) => match low {
          None => { raw.free(output); return raw.null() }
          Some(low_value) => {
            raw.store(output, i as i64, high_value * 16 + low_value)
          }
        }
      }
      i = i + 1
    }
    return output
  }
}

fn postgres_text_oid(oid: u32) -> bool {
  return oid == POSTGRES_TEXT_OID || oid == POSTGRES_VARCHAR_OID || oid == POSTGRES_NAME_OID
}

fn expected_postgres_oid(kind: u8, oid: u32) -> bool {
  if kind == VALUE_BOOL { return oid == POSTGRES_BOOL_OID }
  if kind == VALUE_I16 { return oid == POSTGRES_INT2_OID }
  if kind == VALUE_I32 { return oid == POSTGRES_INT4_OID }
  if kind == VALUE_I64 { return oid == POSTGRES_INT8_OID }
  if kind == VALUE_F32 { return oid == POSTGRES_FLOAT4_OID }
  if kind == VALUE_F64 { return oid == POSTGRES_FLOAT8_OID }
  if kind == VALUE_TEXT { return postgres_text_oid(oid) }
  if kind == VALUE_BYTES { return oid == POSTGRES_BYTEA_OID }
  return false
}

pub fn validate_row_count_v3(context: raw, expected: u32) -> i32 {
  unsafe {
    if context.is_null() { return 1 }
    driver: u8 := raw.load(context, 4)
    if !context_base_valid(context, driver) { return 1 }
    metadata_state: u8 := raw.load(context, 81)
    metadata_native: raw := raw.load(context, 88)
    if metadata_state != 0 || !metadata_native.is_null() {
      record_failure(context, FAILURE_ROW)
      return 1
    }
    status := validate_row_count_v2(context, expected)
    if status != 0 { return status }
    raw.store(context, 81, 0 as u8)
    raw.store(context, 88, raw.null())
    if expected == 0 {
      native: raw := raw.load(context, 8)
      raw.store(context, 81, 1 as u8)
      raw.store(context, 88, native)
    }
    return 0
  }
}

pub fn validate_field_metadata_v3(
  context: raw,
  ordinal: u32,
  expected_name: str,
  kind: u8,
) -> i32 {
  unsafe {
    if context.is_null() || kind > VALUE_BYTES { return 1 }
    driver: u8 := raw.load(context, 4)
    if !context_ready(context, driver) { return 1 }
    metadata_state: u8 := raw.load(context, 81)
    count: u32 := raw.load(context, 32)
    if metadata_state != 0 || ordinal >= count || ordinal > 2147483647 {
      record_failure(context, FAILURE_ROW)
      return 1
    }
    native: raw := raw.load(context, 8)
    index := ordinal as i32
    name := if driver == DRIVER_SQLITE {
      sqlite3_column_name(native, index)
    } else {
      if driver != DRIVER_POSTGRES {
        record_failure(context, FAILURE_ROW)
        return 1
      }
      PQfname(native, index)
    }
    if !native_name_matches(name, expected_name) {
      record_failure(context, FAILURE_ROW)
      return 1
    }
    if driver == DRIVER_POSTGRES {
      oid := PQftype(native, index)
      format := PQfformat(native, index)
      expected_format: u8 := raw.load(context, 80)
      if !expected_postgres_oid(kind, oid) || format != (expected_format as i32) {
        record_failure(context, FAILURE_ROW)
        return 1
      }
    }
    if ordinal + 1 == count {
      raw.store(context, 81, 1 as u8)
      raw.store(context, 88, native)
    }
    return 0
  }
}

pub fn validate_field_value_v3(
  context: raw,
  ordinal: u32,
  kind: u8,
  nullable: bool,
) -> i32 {
  unsafe {
    if context.is_null() { return 1 }
    driver: u8 := raw.load(context, 4)
    if !context_base_valid(context, driver) { return 1 }
    metadata_state: u8 := raw.load(context, 81)
    metadata_native_bits: u64 := raw.load(context, 88)
    native_bits: u64 := raw.load(context, 8)
    if metadata_state != 1 || metadata_native_bits != native_bits {
      record_failure(context, FAILURE_ROW)
      return 1
    }
    count: u32 := raw.load(context, 32)
    cache: raw := raw.load(context, 24)
    if ordinal >= count || cache.is_null() {
      record_failure(context, FAILURE_ROW)
      return 1
    }
    entry := raw.offset(cache, (ordinal as i64) * ROW_CACHE_STRIDE)
    owned: u8 := raw.load(entry, 17)
    if owned != 0 {
      pointer: raw := raw.load(entry, 0)
      if !pointer.is_null() { raw.free(pointer) }
    }
    raw.store(entry, 0, 0 as i64)
    raw.store(entry, 8, 0 as i64)
    raw.store(entry, 16, 0 as u8)
    raw.store(entry, 17, 0 as u8)
    raw.store(entry, 18, 0 as u16)
    raw.store(entry, 20, 0 as u32)
    return validate_field_v2(context, ordinal, "", kind, nullable)
  }
}

fn read_binary_u64(pointer: raw, length: i32) -> u64 {
  unsafe {
    mut value: u64 := 0
    mut i: i32 := 0
    loop {
      if i >= length { break }
      byte: u8 := raw.load(pointer, i as i64)
      value = (value << 8) | (byte as u64)
      i = i + 1
    }
    return value
  }
}

pub fn validate_field_v2(
  context: raw,
  ordinal: u32,
  expected_name: str,
  kind: u8,
  nullable: bool,
) -> i32 {
  unsafe {
    if context.is_null() || kind > VALUE_BYTES { return 1 }
    driver: u8 := raw.load(context, 4)
    if !context_ready(context, driver) { return 1 }
    count: u32 := raw.load(context, 32)
    cache: raw := raw.load(context, 24)
    if ordinal >= count || cache.is_null() || ordinal > 2147483647 {
      record_failure(context, FAILURE_ROW)
      return 1
    }
    native: raw := raw.load(context, 8)
    index := ordinal as i32
    entry := raw.offset(cache, (ordinal as i64) * ROW_CACHE_STRIDE)
    if driver == DRIVER_SQLITE {
      name := sqlite3_column_name(native, index)
      if expected_name.len() > 0 && !native_name_matches(name, expected_name) {
        record_failure(context, FAILURE_ROW)
        return 1
      }
      native_type := sqlite3_column_type(native, index)
      if native_type == SQLITE_NULL {
        if !nullable {
          record_failure(context, FAILURE_ROW)
          return 1
        }
        raw.store(entry, 16, 1 as u8)
        return 0
      }
      if kind == VALUE_BOOL || kind == VALUE_I16 || kind == VALUE_I32 || kind == VALUE_I64 {
        if native_type != SQLITE_INTEGER {
          record_failure(context, FAILURE_ROW)
          return 1
        }
        integer := sqlite3_column_int64(native, index)
        if kind == VALUE_BOOL {
          if integer != 0 && integer != 1 {
            record_failure(context, FAILURE_ROW)
            return 1
          }
          raw.store(entry, 0, integer != 0)
        } else {
          if kind == VALUE_I16 && (integer < -32768 || integer > 32767) {
            record_failure(context, FAILURE_ROW)
            return 1
          }
          if kind == VALUE_I32 && (integer < -2147483648 || integer > 2147483647) {
            record_failure(context, FAILURE_ROW)
            return 1
          }
          if kind == VALUE_I16 { raw.store(entry, 0, integer as i16) }
          if kind == VALUE_I32 { raw.store(entry, 0, integer as i32) }
          if kind == VALUE_I64 { raw.store(entry, 0, integer) }
        }
        return 0
      }
      if kind == VALUE_F32 || kind == VALUE_F64 {
        if native_type != SQLITE_FLOAT {
          record_failure(context, FAILURE_ROW)
          return 1
        }
        floating := sqlite3_column_double(native, index)
        if kind == VALUE_F32 { raw.store(entry, 0, floating as f32) }
        if kind == VALUE_F64 { raw.store(entry, 0, floating) }
        return 0
      }
      if kind == VALUE_TEXT {
        if native_type != SQLITE_TEXT {
          record_failure(context, FAILURE_ROW)
          return 1
        }
        pointer := sqlite3_column_text(native, index)
        length := sqlite3_column_bytes(native, index)
        if length < 0 || (pointer.is_null() && length != 0)
          || align_rt_utf8_valid(pointer, length as i64) == 0 {
          record_failure(context, FAILURE_ROW)
          return 1
        }
        raw.store(entry, 0, pointer)
        raw.store(entry, 8, length as i64)
        return 0
      }
      if kind == VALUE_BYTES {
        if native_type != SQLITE_BLOB {
          record_failure(context, FAILURE_ROW)
          return 1
        }
        pointer := sqlite3_column_blob(native, index)
        length := sqlite3_column_bytes(native, index)
        if length < 0 || (pointer.is_null() && length != 0) {
          record_failure(context, FAILURE_ROW)
          return 1
        }
        raw.store(entry, 0, pointer)
        raw.store(entry, 8, length as i64)
        return 0
      }
      record_failure(context, FAILURE_ROW)
      return 1
    }
    if driver != DRIVER_POSTGRES {
      record_failure(context, FAILURE_ROW)
      return 1
    }
    row: u32 := raw.load(context, 16)
    name := PQfname(native, index)
    if expected_name.len() > 0 && !native_name_matches(name, expected_name) {
      record_failure(context, FAILURE_ROW)
      return 1
    }
    is_null := PQgetisnull(native, row as i32, index) != 0
    if is_null {
      if !nullable {
        record_failure(context, FAILURE_ROW)
        return 1
      }
      raw.store(entry, 16, 1 as u8)
      return 0
    }
    oid := PQftype(native, index)
    pointer := PQgetvalue(native, row as i32, index)
    length := PQgetlength(native, row as i32, index)
    if pointer.is_null() || length < 0 {
      record_failure(context, FAILURE_ROW)
      return 1
    }
    result_format: u8 := raw.load(context, 80)
    if kind == VALUE_BOOL {
      if oid != POSTGRES_BOOL_OID {
        record_failure(context, FAILURE_ROW)
        return 1
      }
      parsed: Option<bool> := if result_format == 1 {
        if length != 1 { None } else {
          byte: u8 := raw.load(pointer, 0)
          if byte == 0 { Some(false) } else {
            if byte == 1 { Some(true) } else { None }
          }
        }
      } else { parse_postgres_bool(pointer, length) }
      match parsed {
        None => { record_failure(context, FAILURE_ROW); return 1 }
        Some(value) => { raw.store(entry, 0, value); return 0 }
      }
    }
    if kind == VALUE_I16 || kind == VALUE_I32 || kind == VALUE_I64 {
      expected_oid := if kind == VALUE_I16 { POSTGRES_INT2_OID } else {
        if kind == VALUE_I32 { POSTGRES_INT4_OID } else { POSTGRES_INT8_OID }
      }
      if oid != expected_oid {
        record_failure(context, FAILURE_ROW)
        return 1
      }
      required_width := if kind == VALUE_I16 { 2 } else { if kind == VALUE_I32 { 4 } else { 8 } }
      parsed: Option<i64> := if result_format == 1 {
        if length != required_width { None } else {
          bits := read_binary_u64(pointer, length)
          if kind == VALUE_I16 { Some((bits as u16 as i16) as i64) } else {
            if kind == VALUE_I32 { Some((bits as u32 as i32) as i64) } else {
              Some(bits as i64)
            }
          }
        }
      } else { parse_postgres_i64(pointer, length) }
      match parsed {
        None => { record_failure(context, FAILURE_ROW); return 1 }
        Some(integer) => {
          if kind == VALUE_I16 && (integer < -32768 || integer > 32767) {
            record_failure(context, FAILURE_ROW)
            return 1
          }
          if kind == VALUE_I32 && (integer < -2147483648 || integer > 2147483647) {
            record_failure(context, FAILURE_ROW)
            return 1
          }
          if kind == VALUE_I16 { raw.store(entry, 0, integer as i16) }
          if kind == VALUE_I32 { raw.store(entry, 0, integer as i32) }
          if kind == VALUE_I64 { raw.store(entry, 0, integer) }
          return 0
        }
      }
    }
    if kind == VALUE_F32 || kind == VALUE_F64 {
      expected_oid := if kind == VALUE_F32 { POSTGRES_FLOAT4_OID } else { POSTGRES_FLOAT8_OID }
      if oid != expected_oid {
        record_failure(context, FAILURE_ROW)
        return 1
      }
      if result_format == 1 {
        if kind == VALUE_F32 {
          if length != 4 { record_failure(context, FAILURE_ROW); return 1 }
          raw.store(entry, 0, align_rt_f32_from_bits(read_binary_u64(pointer, length) as u32))
          return 0
        }
        if length != 8 { record_failure(context, FAILURE_ROW); return 1 }
        raw.store(entry, 0, align_rt_f64_from_bits(read_binary_u64(pointer, length)))
        return 0
      }
      parsed: Option<f64> := parse_postgres_f64(pointer, length)
      match parsed {
        None => { record_failure(context, FAILURE_ROW); return 1 }
        Some(floating) => {
          if kind == VALUE_F32 { raw.store(entry, 0, floating as f32) }
          if kind == VALUE_F64 { raw.store(entry, 0, floating) }
          return 0
        }
      }
    }
    if kind == VALUE_TEXT {
      if !postgres_text_oid(oid) || align_rt_utf8_valid(pointer, length as i64) == 0 {
        record_failure(context, FAILURE_ROW)
        return 1
      }
      raw.store(entry, 0, pointer)
      raw.store(entry, 8, length as i64)
      return 0
    }
    if kind == VALUE_BYTES {
      if oid != POSTGRES_BYTEA_OID {
        record_failure(context, FAILURE_ROW)
        return 1
      }
      if result_format == 1 {
        raw.store(entry, 0, pointer)
        raw.store(entry, 8, length as i64)
        raw.store(entry, 17, 0 as u8)
      } else {
        decoded := decode_postgres_bytea(pointer, length)
        if decoded.is_null() {
          record_failure(context, FAILURE_ROW)
          return 1
        }
        raw.store(entry, 0, decoded)
        raw.store(entry, 8, ((length - 2) / 2) as i64)
        raw.store(entry, 17, 1 as u8)
      }
      return 0
    }
    record_failure(context, FAILURE_ROW)
    return 1
  }
}

pub fn read_bool_v2(context: raw, ordinal: u32) -> Option<bool> {
  unsafe {
    entry := row_cache_entry(context, ordinal)
    null_value: u8 := if entry.is_null() { 1 } else { raw.load(entry, 16) }
    if null_value != 0 { return None }
    value: bool := raw.load(entry, 0)
    return Some(value)
  }
}

pub fn read_i16_v2(context: raw, ordinal: u32) -> Option<i16> {
  unsafe {
    entry := row_cache_entry(context, ordinal)
    null_value: u8 := if entry.is_null() { 1 } else { raw.load(entry, 16) }
    if null_value != 0 { return None }
    value: i16 := raw.load(entry, 0)
    return Some(value)
  }
}

pub fn read_i32_v2(context: raw, ordinal: u32) -> Option<i32> {
  unsafe {
    entry := row_cache_entry(context, ordinal)
    null_value: u8 := if entry.is_null() { 1 } else { raw.load(entry, 16) }
    if null_value != 0 { return None }
    value: i32 := raw.load(entry, 0)
    return Some(value)
  }
}

pub fn read_i64_v2(context: raw, ordinal: u32) -> Option<i64> {
  unsafe {
    entry := row_cache_entry(context, ordinal)
    null_value: u8 := if entry.is_null() { 1 } else { raw.load(entry, 16) }
    if null_value != 0 { return None }
    value: i64 := raw.load(entry, 0)
    return Some(value)
  }
}

pub fn read_f32_v2(context: raw, ordinal: u32) -> Option<f32> {
  unsafe {
    entry := row_cache_entry(context, ordinal)
    null_value: u8 := if entry.is_null() { 1 } else { raw.load(entry, 16) }
    if null_value != 0 { return None }
    value: f32 := raw.load(entry, 0)
    return Some(value)
  }
}

pub fn read_f64_v2(context: raw, ordinal: u32) -> Option<f64> {
  unsafe {
    entry := row_cache_entry(context, ordinal)
    null_value: u8 := if entry.is_null() { 1 } else { raw.load(entry, 16) }
    if null_value != 0 { return None }
    value: f64 := raw.load(entry, 0)
    return Some(value)
  }
}

pub fn read_view_pointer_v2(context: raw, ordinal: u32) -> raw {
  unsafe {
    entry := row_cache_entry(context, ordinal)
    null_value: u8 := if entry.is_null() { 1 } else { raw.load(entry, 16) }
    if null_value != 0 { return raw.null() }
    pointer: raw := raw.load(entry, 0)
    return pointer
  }
}

pub fn read_view_length_v2(context: raw, ordinal: u32) -> i64 {
  unsafe {
    entry := row_cache_entry(context, ordinal)
    null_value: u8 := if entry.is_null() { 1 } else { raw.load(entry, 16) }
    if null_value != 0 { return -1 }
    length: i64 := raw.load(entry, 8)
    return length
  }
}
