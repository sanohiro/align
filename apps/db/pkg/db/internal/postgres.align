module pkg.db.internal.postgres

import pkg.db
import pkg.db.internal
import pkg.db.internal.descriptor
import pkg.db.internal.postgres_status
import pkg.db.internal.resource
import std.time

extern "C" link("pq") {
  fn PQprepare(
    connection: raw,
    statement_name: raw,
    query: raw,
    parameter_count: i32,
    parameter_types: raw,
  ) -> raw
  fn PQexecPrepared(
    connection: raw,
    statement_name: raw,
    parameter_count: i32,
    parameter_values: raw,
    parameter_lengths: raw,
    parameter_formats: raw,
    result_format: i32,
  ) -> raw
  fn PQexecParams(
    connection: raw,
    command: raw,
    parameter_count: i32,
    parameter_types: raw,
    parameter_values: raw,
    parameter_lengths: raw,
    parameter_formats: raw,
    result_format: i32,
  ) -> raw
  fn PQsendQueryParams(
    connection: raw,
    command: raw,
    parameter_count: i32,
    parameter_types: raw,
    parameter_values: raw,
    parameter_lengths: raw,
    parameter_formats: raw,
    result_format: i32,
  ) -> i32
  fn PQsendQueryPrepared(
    connection: raw,
    statement_name: raw,
    parameter_count: i32,
    parameter_values: raw,
    parameter_lengths: raw,
    parameter_formats: raw,
    result_format: i32,
  ) -> i32
  fn PQsetnonblocking(connection: raw, enabled: i32) -> i32
  fn PQflush(connection: raw) -> i32
  fn PQconsumeInput(connection: raw) -> i32
  fn PQisBusy(connection: raw) -> i32
  fn PQgetResult(connection: raw) -> raw
  fn PQtransactionStatus(connection: raw) -> i32
  fn PQgetCancel(connection: raw) -> raw
  fn PQcancel(cancel: raw, error_buffer: raw, error_buffer_size: i32) -> i32
  fn PQfreeCancel(cancel: raw)
  fn PQntuples(result: raw) -> i32
  fn PQnfields(result: raw) -> i32
  fn PQgetisnull(result: raw, row: i32, column: i32) -> i32
  fn PQgetvalue(result: raw, row: i32, column: i32) -> raw
  fn PQgetlength(result: raw, row: i32, column: i32) -> i32
  fn PQcmdTuples(result: raw) -> raw
  fn PQclear(result: raw)
  fn PQerrorMessage(connection: raw) -> raw
  fn PQresultErrorField(result: raw, field_code: i32) -> raw
}

pub DRIVER_POSTGRES: u8 := 2
CONTEXT_VERSION: u32 := 2
FAILURE_UNSUPPORTED: u8 := 2
FAILURE_ROW: u8 := 3
FAILURE_ENCODE: u8 := 4
pub PGRES_COMMAND_OK: i32 := 1
pub PGRES_TUPLES_OK: i32 := 2
PGRES_COPY_OUT: i32 := 3
PGRES_COPY_IN: i32 := 4
PGRES_TUPLES_CHUNK: i32 := 12
PGRES_SINGLE_TUPLE: i32 := 9
PGRES_COPY_BOTH: i32 := 8
PQTRANS_IDLE: i32 := 0
PQTRANS_INTRANS: i32 := 2
PQTRANS_INERROR: i32 := 3
WAIT_SLICE_NS: i64 := 1000000

pub fn rows_count(result: raw) -> i32 {
  unsafe { return PQntuples(result) }
}

fn bytea_hex_digit(value: u8) -> u8 {
  if value < 10 { return 48 + value }
  return 87 + value
}

pub fn bytea_text_length(value: slice<u8>) -> i64 {
  length := value.len()
  // The encoded payload also needs a two-byte prefix and one NUL sentinel.  A
  // negative result is the internal fail-closed marker for an unrepresentable
  // allocation size; normal byte slices never reach this boundary.
  if length > 4611686018427387902 { return -1 }
  return length * 2 + 2
}

pub fn encode_bytea_text(value: slice<u8>) -> raw {
  unsafe {
    input_length := value.len()
    // `raw.alloc` has no fallible form in the language. Return a null pointer
    // before any store if the encoded size cannot be represented.
    encoded_length := bytea_text_length(value)
    if encoded_length < 0 { return raw.null() }
    pointer := raw.alloc(encoded_length + 1)
    raw.store(pointer, 0, 92 as u8)
    raw.store(pointer, 1, 120 as u8)
    mut index := 0
    loop {
      if index >= input_length { break }
      byte := value[index]
      output_offset := index * 2 + 2
      raw.store(pointer, output_offset, bytea_hex_digit(byte / 16))
      raw.store(pointer, output_offset + 1, bytea_hex_digit(byte % 16))
      index = index + 1
    }
    raw.store(pointer, encoded_length, 0 as u8)
    return pointer
  }
}

pub fn bytea_binary_length(value: slice<u8>) -> i64 = value.len()

pub fn encode_bytea_binary(value: slice<u8>) -> raw {
  unsafe {
    length := value.len()
    // Keep a non-null allocation for an empty binary value while preserving the
    // explicit zero length passed to libpq. The sentinel is outside the
    // recorded byte range.
    if length >= 9223372036854775807 { return raw.null() }
    pointer := raw.alloc(length + 1)
    mut index := 0
    loop {
      if index >= length { break }
      raw.store(pointer, index, value[index])
      index = index + 1
    }
    raw.store(pointer, length, 0 as u8)
    return pointer
  }
}

pub fn free_bytea_buffer(pointer: raw) {
  unsafe {
    if !pointer.is_null() { raw.free(pointer) }
  }
}

pub fn contains_nul(value: str) -> bool {
  bytes := value.bytes()
  mut i := 0
  loop {
    if i >= bytes.len() { break false }
    if bytes[i] == 0 { break true }
    i = i + 1
  }
}

pub fn descriptor_error(query_id: str, item: str, message: str) -> pkg.db.Error =
  pkg.db.Error.Unsupported(pkg.db.ContractError {
    query_id: Some(query_id.clone()),
    item: item.clone(),
    message: message.clone(),
  })

pub fn invalid_descriptor_error() -> pkg.db.Error = pkg.db.Error.InvalidQuery(
  pkg.db.ContractError {
    query_id: None,
    item: "db.descriptor.header".clone(),
    message: "invalid static database descriptor".clone(),
  },
)

pub fn invalid_query_error(query_id: str, item: str, message: str) -> pkg.db.Error =
  pkg.db.Error.InvalidQuery(pkg.db.ContractError {
    query_id: Some(query_id.clone()),
    item: item.clone(),
    message: message.clone(),
  })

pub fn driver_mismatch_error(query_id: str) -> pkg.db.Error = pkg.db.Error.DriverMismatch(
  pkg.db.ContractError {
    query_id: Some(query_id.clone()),
    item: "db.descriptor.driver".clone(),
    message: "static database descriptor does not support PostgreSQL".clone(),
  },
)

pub fn cardinality_error(observed: i64) -> pkg.db.Error = pkg.db.Error.Cardinality(
  pkg.db.CardinalityError {
    expected_min: 1,
    expected_max: 1,
    observed_at_least: observed,
  },
)

fn copy_c_string(pointer: raw) -> string {
  unsafe {
    if pointer.is_null() { return "".clone() }
    mut output := buffer(64)
    mut i := 0
    loop {
      byte: u8 := raw.load(pointer, i)
      if byte == 0 { break }
      output.put_u8(byte)
      i = i + 1
    }
    text := output.bytes().as_str() else "invalid UTF-8 in PostgreSQL error"
    return text.clone()
  }
}

pub fn c_string(value: str) -> raw {
  unsafe {
    bytes := value.bytes()
    pointer := raw.alloc(bytes.len() + 1)
    mut i := 0
    loop {
      if i >= bytes.len() { break }
      raw.store(pointer, i, bytes[i])
      i = i + 1
    }
    terminal: u8 := 0
    raw.store(pointer, bytes.len(), terminal)
    return pointer
  }
}

fn optional_c_string(pointer: raw) -> Option<string> {
  if pointer.is_null() { return None }
  return Some(copy_c_string(pointer))
}

fn native_detail(connection: raw, result: raw) -> pkg.db.NativeError {
  unsafe {
    mut sqlstate: Option<string> := None
    mut message := copy_c_string(PQerrorMessage(connection))
    mut detail: Option<string> := None
    mut constraint: Option<string> := None
    mut table: Option<string> := None
    mut column: Option<string> := None
    if !result.is_null() {
      state_pointer := PQresultErrorField(result, 67)
      sqlstate = optional_c_string(state_pointer)
      message_pointer := PQresultErrorField(result, 77)
      if !message_pointer.is_null() { message = copy_c_string(message_pointer) }
      detail = optional_c_string(PQresultErrorField(result, 68))
      constraint = optional_c_string(PQresultErrorField(result, 110))
      table = optional_c_string(PQresultErrorField(result, 116))
      column = optional_c_string(PQresultErrorField(result, 99))
    }
    return pkg.db.NativeError {
      driver: pkg.db.Driver.PostgreSQL,
      code: None,
      extended_code: None,
      sqlstate: sqlstate,
      message: message,
      detail: detail,
      constraint: constraint,
      table: table,
      column: column,
    }
  }
}

pub fn connection_error(connection: raw) -> pkg.db.Error {
  unsafe { return pkg.db.Error.Connection(native_detail(connection, raw.null())) }
}

pub fn execution_error(connection: raw, result: raw) -> pkg.db.Error {
  unsafe {
    state := PQresultErrorField(result, 67)
    category := sqlstate_category(state)
    detail := native_detail(connection, result)
    if category == 1 { return pkg.db.Error.Constraint(detail) }
    if category == 2 { return pkg.db.Error.Serialization(detail) }
    if category == 3 { return pkg.db.Error.Deadlock(detail) }
    if category == 4 { return pkg.db.Error.Cancelled(detail) }
    return pkg.db.Error.Native(detail)
  }
}

fn sqlstate_category(pointer: raw) -> i32 {
  unsafe {
    if pointer.is_null() { return 0 }
    a: u8 := raw.load(pointer, 0)
    b: u8 := raw.load(pointer, 1)
    c: u8 := raw.load(pointer, 2)
    d: u8 := raw.load(pointer, 3)
    e: u8 := raw.load(pointer, 4)
    terminal: u8 := raw.load(pointer, 5)
    if terminal != 0 { return 0 }
    if a == 50 && b == 51 { return 1 }
    if a == 52 && b == 48 && c == 48 && d == 48 && e == 49 { return 2 }
    if a == 52 && b == 48 && c == 80 && d == 48 && e == 49 { return 3 }
    if a == 53 && b == 55 && c == 48 && d == 49 && e == 52 { return 4 }
    return 0
  }
}

pub fn common_options_valid(
  options: slice<pkg.db.ExecuteOption>,
  query_id: str,
) -> Result<Option<i64>, pkg.db.Error> {
  mut timeout: Option<i64> := None
  mut i := 0
  loop {
    if i >= options.len() { break }
    match options[i] {
      TimeoutNs(ns) => {
        if ns <= 0 {
          return Err(descriptor_error(
            query_id,
            "db.execute.timeout_ns",
            "database execution timeout must be positive",
          ))
        }
        match timeout {
          Some(_) => {
            return Err(descriptor_error(
              query_id,
              "db.execute.timeout_ns",
              "duplicate database execution timeout",
            ))
          }
          None => { timeout = Some(ns) }
        }
      }
    }
    i = i + 1
  }
  return Ok(timeout)
}

pub fn acquire_lease(state: raw, query_id: str) -> Result<(), pkg.db.Error> {
  unsafe {
    active: u8 := raw.load(state, 20)
    if active != 0 {
      return Err(descriptor_error(
        query_id,
        "postgres.connection.active_execution",
        "PostgreSQL connection already has an active execution",
      ))
    }
    raw.store(state, 20, 1 as u8)
    return Ok(())
  }
}

pub fn release_lease(state: raw) {
  unsafe {
    if !state.is_null() { raw.store(state, 20, 0 as u8) }
  }
}

fn absolute_deadline(duration_ns: i64, query_id: str) -> Result<i64, pkg.db.Error> {
  now := time.instant()
  if now < 0 || duration_ns > 9223372036854775807 - now {
    return Err(descriptor_error(
      query_id,
      "db.execute.timeout_ns",
      "database execution timeout exceeds the monotonic deadline range",
    ))
  }
  return Ok(now + duration_ns)
}

// Return 0 when one complete result is ready, 1 on deadline expiry, and 2 on libpq I/O failure.
fn wait_ready(connection: raw, deadline: i64) -> i32 {
  loop {
    flush := unsafe { PQflush(connection) }
    if flush < 0 { return 2 }
    if unsafe { PQconsumeInput(connection) } == 0 { return 2 }
    if flush == 0 && unsafe { PQisBusy(connection) } == 0 { return 0 }
    now := time.instant()
    if now >= deadline { return 1 }
    remaining := deadline - now
    time.sleep(if remaining < WAIT_SLICE_NS { remaining } else { WAIT_SLICE_NS })
  }
}

fn transaction_synchronized(state: raw, connection: raw) -> bool {
  unsafe {
    status := PQtransactionStatus(connection)
    active: u8 := raw.load(state, 21)
    if active == 0 { return status == PQTRANS_IDLE }
    return status == PQTRANS_INTRANS || status == PQTRANS_INERROR
  }
}

fn timeout_error(connection: raw, result: raw) -> pkg.db.Error {
  unsafe { return pkg.db.Error.Timeout(native_detail(connection, result)) }
}

fn finish_async_result(
  state: raw,
  connection: raw,
  context: raw,
  duration_ns: i64,
  deadline: i64,
  query_id: str,
  expected_status: i32,
) -> Result<(), pkg.db.Error> {
  unsafe {
    wait_status := wait_ready(connection, deadline)
    if wait_status == 0 {
      result := PQgetResult(connection)
      if result.is_null() {
        failure := connection_error(connection)
        pkg.db.internal.resource.poison_conn_state(state)
        return Err(failure)
      }
      status := result_status(result)
      if result_must_close(status) {
        failure := if expected_status == PGRES_COMMAND_OK && tuple_status(status) {
          invalid_query_error(
            query_id,
            "db.command.row",
            "a database command must not produce rows",
          )
        } else { execution_error(connection, result) }
        clear_and_poison(state, result)
        return Err(failure)
      }
      extra := PQgetResult(connection)
      if !extra.is_null() {
        PQclear(result)
        failure := invalid_query_error(
          "database execution",
          "postgres.execution.results",
          "PostgreSQL execution returned more than one result",
        )
        mut current := extra
        loop {
          current_status := result_status(current)
          if result_must_close(current_status) {
            clear_and_poison(state, current)
            return Err(failure)
          }
          PQclear(current)
          current = PQgetResult(connection)
          if current.is_null() { break }
        }
        if PQsetnonblocking(connection, 0) != 0 {
          pkg.db.internal.resource.poison_conn_state(state)
        }
        return Err(failure)
      }
      if PQsetnonblocking(connection, 0) != 0 {
        failure := connection_error(connection)
        if !result.is_null() { PQclear(result) }
        pkg.db.internal.resource.poison_conn_state(state)
        return Err(failure)
      }
      raw.store(context, 8, result)
      return Ok(())
    }
    if wait_status == 2 {
      failure := connection_error(connection)
      ignored := PQsetnonblocking(connection, 0)
      pkg.db.internal.resource.poison_conn_state(state)
      return Err(failure)
    }

    cancel := PQgetCancel(connection)
    error_buffer := raw.alloc(256)
    cancel_status := if cancel.is_null() { 0 } else { PQcancel(cancel, error_buffer, 256) }
    if !cancel.is_null() { PQfreeCancel(cancel) }
    raw.free(error_buffer)
    if cancel_status == 0 {
      failure := timeout_error(connection, raw.null())
      ignored := PQsetnonblocking(connection, 0)
      pkg.db.internal.resource.poison_conn_state(state)
      return Err(failure)
    }

    recovery_start := time.instant()
    recovery_budget := if duration_ns < WAIT_SLICE_NS { WAIT_SLICE_NS } else { duration_ns }
    recovery_deadline := if recovery_start > 9223372036854775807 - recovery_budget {
      9223372036854775807
    } else { recovery_start + recovery_budget }
    recovery_status := wait_ready(connection, recovery_deadline)
    mut timeout_result := raw.null()
    if recovery_status == 0 {
      timeout_result = PQgetResult(connection)
      if !timeout_result.is_null() {
        timeout_status := result_status(timeout_result)
        if result_must_close(timeout_status) {
          failure := timeout_error(connection, timeout_result)
          clear_and_poison(state, timeout_result)
          return Err(failure)
        }
      }
      mut extra := PQgetResult(connection)
      loop {
        if extra.is_null() { break }
        if !timeout_result.is_null() { PQclear(timeout_result) }
        timeout_result = extra
        timeout_status := result_status(timeout_result)
        if result_must_close(timeout_status) {
          failure := timeout_error(connection, timeout_result)
          clear_and_poison(state, timeout_result)
          return Err(failure)
        }
        extra = PQgetResult(connection)
      }
    }
    synchronized := recovery_status == 0 && transaction_synchronized(state, connection)
    restored := PQsetnonblocking(connection, 0) == 0
    failure := timeout_error(connection, timeout_result)
    if !timeout_result.is_null() { PQclear(timeout_result) }
    if !synchronized || !restored { pkg.db.internal.resource.poison_conn_state(state) }
    return Err(failure)
  }
}

pub fn state_for(target: pkg.db.exec) -> raw {
  unsafe {
    return match target {
      Conn(reference) => {
        state := resource.raw(reference)
        if pkg.db.internal.resource.transaction_active(state) { raw.null() } else { state }
      }
      Tx(reference) => {
        state := resource.raw(reference)
        if pkg.db.internal.resource.transaction_active(state) { state } else { raw.null() }
      }
    }
  }
}

pub fn postgres_connection(state: raw) -> raw {
  unsafe {
    if state.is_null() { return raw.null() }
    version: u32 := raw.load(state, 0)
    driver: u8 := raw.load(state, 4)
    closed: u8 := raw.load(state, 5)
    reserved: u16 := raw.load(state, 6)
    connection: raw := raw.load(state, 8)
    if driver != DRIVER_POSTGRES { return raw.null() }
    if version != 1 || reserved != 0 || closed != 0 || connection.is_null() {
      return raw.null()
    }
    return connection
  }
}

pub fn command_header_valid<P>(statement: pkg.db.command<P>) -> bool {
  return pkg.db.command_header_valid(statement, pkg.db.internal.descriptor_header_control())
}

pub fn query_header_valid<P, R>(statement: pkg.db.query<P, R>) -> bool {
  return pkg.db.query_header_valid(statement, pkg.db.internal.descriptor_header_control())
}

pub fn new_context(connection: raw) -> raw {
  unsafe {
    context := raw.alloc(80)
    version: u32 := CONTEXT_VERSION
    driver: u8 := DRIVER_POSTGRES
    clear8: u8 := 0
    clear16: u16 := 0
    clear32: u32 := 0
    raw.store(context, 0, version)
    raw.store(context, 4, driver)
    raw.store(context, 5, clear8)
    raw.store(context, 6, clear16)
    raw.store(context, 8, connection)
    raw.store(context, 16, clear32)
    raw.store(context, 20, clear32)
    raw.store(context, 24, raw.null())
    raw.store(context, 32, clear32)
    raw.store(context, 36, clear32)
    raw.store(context, 40, raw.null())
    raw.store(context, 48, raw.null())
    raw.store(context, 56, raw.null())
    raw.store(context, 64, raw.null())
    raw.store(context, 72, clear32)
    raw.store(context, 76, clear32)
    return context
  }
}

pub fn free_context(context: raw) {
  unsafe {
    if context.is_null() { return }
    pkg.db.internal.release_row_cache_v2(context)
    values: raw := raw.load(context, 40)
    types: raw := raw.load(context, 48)
    lengths: raw := raw.load(context, 56)
    formats: raw := raw.load(context, 64)
    count: u32 := raw.load(context, 72)
    if !values.is_null() {
      mut i: u32 := 0
      loop {
        if i >= count { break }
        value: raw := raw.load(values, (i as i64) * 8)
        if !value.is_null() { raw.free(value) }
        i = i + 1
      }
      raw.free(values)
    }
    if !types.is_null() { raw.free(types) }
    if !lengths.is_null() { raw.free(lengths) }
    if !formats.is_null() { raw.free(formats) }
    raw.free(context)
  }
}

pub fn context_error(context: raw, connection: raw, result: raw, query_id: str) -> pkg.db.Error {
  unsafe {
    failure: u8 := raw.load(context, 5)
    if failure == FAILURE_UNSUPPORTED {
      return descriptor_error(
        query_id,
        "db.descriptor.static_option",
        "static database option is unsupported by PostgreSQL Q2 execution",
      )
    }
    if failure == FAILURE_ROW {
      return pkg.db.Error.Decode(pkg.db.ContractError {
        query_id: Some(query_id.clone()),
        item: "db.row".clone(),
        message: "PostgreSQL row does not match the static Row contract".clone(),
      })
    }
    if failure == FAILURE_ENCODE {
      return pkg.db.Error.Encode(pkg.db.ContractError {
        query_id: Some(query_id.clone()),
        item: "db.parameter".clone(),
        message: "database text contains U+0000 or a parameter exceeds the PostgreSQL text range".clone(),
      })
    }
    return execution_error(connection, result)
  }
}

pub fn clear_result_and_context(result: raw, context: raw) {
  unsafe {
    if !result.is_null() { PQclear(result) }
    free_context(context)
  }
}

pub fn prepared_open(
  connection: raw,
  name: raw,
  sql: raw,
  count: i32,
  types: raw,
) -> raw {
  unsafe { return PQprepare(connection, name, sql, count, types) }
}

pub fn prepared_execute(connection: raw, name: raw, context: raw) -> raw {
  unsafe {
    count: u32 := raw.load(context, 72)
    values: raw := raw.load(context, 40)
    lengths: raw := raw.load(context, 56)
    formats: raw := raw.load(context, 64)
    return PQexecPrepared(connection, name, count as i32, values, lengths, formats, 0)
  }
}

pub fn prepared_execute_with_timeout(
  state: raw,
  connection: raw,
  name: raw,
  context: raw,
  timeout: Option<i64>,
  query_id: str,
  expected_status: i32,
) -> Result<(), pkg.db.Error> {
  match timeout {
    None => unsafe {
      raw.store(context, 8, prepared_execute(connection, name, context))
      return Ok(())
    }
    Some(duration_ns) => unsafe {
      deadline := absolute_deadline(duration_ns, query_id)?
      if PQsetnonblocking(connection, 1) != 0 { return Err(connection_error(connection)) }
      if time.instant() >= deadline {
        if PQsetnonblocking(connection, 0) != 0 {
          pkg.db.internal.resource.poison_conn_state(state)
        }
        return Err(timeout_error(connection, raw.null()))
      }
      count: u32 := raw.load(context, 72)
      values: raw := raw.load(context, 40)
      lengths: raw := raw.load(context, 56)
      formats: raw := raw.load(context, 64)
      sent := PQsendQueryPrepared(
        connection, name, count as i32, values, lengths, formats, 0,
      )
      if sent == 0 {
        failure := connection_error(connection)
        if PQsetnonblocking(connection, 0) != 0 {
          pkg.db.internal.resource.poison_conn_state(state)
        }
        return Err(failure)
      }
      return finish_async_result(
        state, connection, context, duration_ns, deadline, query_id, expected_status,
      )
    }
  }
}

pub fn prepared_clear(result: raw) {
  unsafe { if !result.is_null() { PQclear(result) } }
}

pub fn execute_params(connection: raw, statement: raw, context: raw) -> raw {
  unsafe {
    count: u32 := raw.load(context, 72)
    types: raw := raw.load(context, 48)
    values: raw := raw.load(context, 40)
    lengths: raw := raw.load(context, 56)
    formats: raw := raw.load(context, 64)
    return PQexecParams(
      connection,
      statement,
      count as i32,
      types,
      values,
      lengths,
      formats,
      0,
    )
  }
}

pub fn execute_params_with_timeout(
  state: raw,
  connection: raw,
  statement: raw,
  context: raw,
  timeout: Option<i64>,
  query_id: str,
  expected_status: i32,
) -> Result<(), pkg.db.Error> {
  match timeout {
    None => unsafe {
      raw.store(context, 8, execute_params(connection, statement, context))
      return Ok(())
    }
    Some(duration_ns) => unsafe {
      deadline := absolute_deadline(duration_ns, query_id)?
      if PQsetnonblocking(connection, 1) != 0 { return Err(connection_error(connection)) }
      if time.instant() >= deadline {
        if PQsetnonblocking(connection, 0) != 0 {
          pkg.db.internal.resource.poison_conn_state(state)
        }
        return Err(timeout_error(connection, raw.null()))
      }
      count: u32 := raw.load(context, 72)
      types: raw := raw.load(context, 48)
      values: raw := raw.load(context, 40)
      lengths: raw := raw.load(context, 56)
      formats: raw := raw.load(context, 64)
      sent := PQsendQueryParams(
        connection,
        statement,
        count as i32,
        types,
        values,
        lengths,
        formats,
        0,
      )
      if sent == 0 {
        failure := connection_error(connection)
        if PQsetnonblocking(connection, 0) != 0 {
          pkg.db.internal.resource.poison_conn_state(state)
        }
        return Err(failure)
      }
      return finish_async_result(
        state, connection, context, duration_ns, deadline, query_id, expected_status,
      )
    }
  }
}

pub fn result_status(result: raw) -> i32 {
  return pkg.db.internal.postgres_status.code(result)
}

pub fn result_must_close(status: i32) -> bool =
  pkg.db.internal.postgres_status.must_close(status)

pub fn clear_and_poison(state: raw, result: raw) {
  unsafe {
    if !result.is_null() { PQclear(result) }
    pkg.db.internal.resource.poison_conn_state(state)
  }
}

pub fn result_rows(result: raw) -> i32 {
  unsafe { return PQntuples(result) }
}

pub fn result_fields(result: raw) -> i32 {
  unsafe { return PQnfields(result) }
}

pub fn result_is_null(result: raw, row: i32, column: i32) -> bool {
  unsafe { return PQgetisnull(result, row, column) != 0 }
}

pub fn result_value(result: raw, row: i32, column: i32) -> raw {
  unsafe { return PQgetvalue(result, row, column) }
}

pub fn result_length(result: raw, row: i32, column: i32) -> i32 {
  unsafe { return PQgetlength(result, row, column) }
}

pub fn command_affected(result: raw) -> raw {
  unsafe { return PQcmdTuples(result) }
}

pub fn parse_affected(pointer: raw) -> Result<Option<i64>, ()> {
  unsafe {
    if pointer.is_null() { return Err(()) }
    first: u8 := raw.load(pointer, 0)
    if first == 0 { return Ok(None) }
    mut value: i64 := 0
    mut index := 0
    loop {
      byte: u8 := raw.load(pointer, index)
      if byte == 0 { break }
      if byte < 48 || byte > 57 { return Err(()) }
      digit := (byte - 48) as i64
      if value > (9223372036854775807 - digit) / 10 { return Err(()) }
      value = value * 10 + digit
      index = index + 1
    }
    return Ok(Some(value))
  }
}

pub fn tuple_status(status: i32) -> bool = status == PGRES_TUPLES_OK
  || status == PGRES_SINGLE_TUPLE || status == PGRES_TUPLES_CHUNK
  || status == PGRES_COPY_OUT || status == PGRES_COPY_IN || status == PGRES_COPY_BOTH

pub fn prepare_prevalidated<P, R>(
  target: pkg.db.exec,
  statement: pkg.db.query<P, R>,
  query_id: str,
  native_oids: raw,
  native_count: u32,
) -> Result<pkg.db.stmt<P, R>, pkg.db.Error> {
  unsafe {
    if !query_header_valid(statement) { return Err(invalid_descriptor_error()) }
    data := pkg.db.internal.descriptor.data(statement)
    mask: u8 := raw.load(data, 5)
    if mask & 2 == 0 || pkg.db.driver_tag(target) != DRIVER_POSTGRES {
      return Err(driver_mismatch_error(query_id))
    }
    count := pkg.db.internal.descriptor.parameter_count(statement)
    overrides_valid := if native_oids.is_null() {
      native_count == 0
    } else { native_count == count }
    if !overrides_valid || count > 2147483647 {
      return Err(invalid_query_error(
        query_id,
        "postgres.prepare.parameter_count",
        "normalized PostgreSQL parameter OIDs do not match the Params contract",
      ))
    }
    state := state_for(target)
    connection := postgres_connection(state)
    if connection.is_null() {
      return Err(descriptor_error(
        query_id,
        "db.connection.state",
        "PostgreSQL connection is closed, poisoned, or not transaction-active",
      ))
    }
    context := new_context(connection)
    if !pkg.db.internal.ensure_postgres_parameters_v1(context, count) {
      free_context(context)
      return Err(descriptor_error(
        query_id,
        "postgres.prepare.parameters",
        "PostgreSQL parameter storage could not be formed",
      ))
    }
    static_status := pkg.db.internal.descriptor.validate_static(statement, context)
    if static_status != 0 {
      failure := if static_status == -1 {
        descriptor_error(
          query_id,
          "db.descriptor.shape",
          "static database descriptor uses a field shape unsupported by prepared execution",
        )
      } else { context_error(context, connection, raw.null(), query_id) }
      free_context(context)
      return Err(failure)
    }
    types: raw := raw.load(context, 48)
    mut i: u32 := 0
    loop {
      if i >= count { break }
      if !native_oids.is_null() {
        override_oid: u32 := raw.load(native_oids, (i as i64) * 4)
        if override_oid != 0 { raw.store(types, (i as i64) * 4, override_oid) }
      }
      i = i + 1
    }
    lease := acquire_lease(state, query_id)
    match lease {
      Err(error) => {
        free_context(context)
        return Err(error)
      }
      Ok(_) => {}
    }
    ordinal := pkg.db.internal.resource.next_statement_ordinal(state)
    if ordinal < 0 {
      free_context(context)
      release_lease(state)
      return Err(descriptor_error(
        query_id,
        "postgres.prepare.identity",
        "PostgreSQL prepared-statement identity space is exhausted",
      ))
    }
    mut name_builder := builder()
    name_builder.write("__align_pkg_db_")
    name_builder.write_int(ordinal)
    name_text := name_builder.to_string()
    name := c_string(name_text)
    mut deallocate_builder := builder()
    deallocate_builder.write("DEALLOCATE ")
    deallocate_builder.write(name_text)
    deallocate_text := deallocate_builder.to_string()
    deallocate := c_string(deallocate_text)
    sql := pkg.db.internal.descriptor.postgres_sql_pointer(statement)
    result := prepared_open(connection, name, sql, count as i32, types)
    if result.is_null() {
      failure := connection_error(connection)
      pkg.db.internal.resource.poison_conn_state(state)
      raw.free(name)
      raw.free(deallocate)
      free_context(context)
      release_lease(state)
      return Err(failure)
    }
    status := result_status(result)
    if status != PGRES_COMMAND_OK {
      failure := execution_error(connection, result)
      if result_must_close(status) {
        clear_and_poison(state, result)
      } else { prepared_clear(result) }
      raw.free(name)
      raw.free(deallocate)
      free_context(context)
      release_lease(state)
      return Err(failure)
    }
    prepared_clear(result)
    free_context(context)
    release_lease(state)
    owned_id := c_string(query_id)
    binder := pkg.db.internal.descriptor.binder(statement)
    row_validator := pkg.db.internal.descriptor.row_validator(statement)
    stream_decoder := pkg.db.internal.descriptor.stream_decoder(statement)
    batch_plan := pkg.db.internal.descriptor.batch_plan(statement)
    wrapper := pkg.db.internal.resource.new_stmt_state(
      DRIVER_POSTGRES,
      name,
      state,
      binder,
      owned_id,
      query_id.len(),
      deallocate,
      row_validator,
      stream_decoder,
      batch_plan,
    )
    prepared: pkg.db.stmt<P, R> := match target {
      Conn(reference) => resource.from_raw_borrowed(wrapper, reference)
      Tx(reference) => resource.from_raw_borrowed(wrapper, reference)
    }
    return Ok(prepared)
  }
}

pub fn rows_stmt_prevalidated<P, R>(
  borrow mut statement: pkg.db.stmt<P, R>,
  params: P,
  options: slice<pkg.db.ExecuteOption>,
) -> Result<pkg.db.rows<R>, pkg.db.Error> {
  unsafe {
    statement_ref := resource.borrow(statement)
    wrapper := resource.raw(statement_ref)
    if pkg.db.internal.resource.stmt_driver(wrapper) != DRIVER_POSTGRES {
      return Err(invalid_descriptor_error())
    }
    id_pointer := pkg.db.internal.resource.stmt_query_id_pointer(wrapper)
    id_length := pkg.db.internal.resource.stmt_query_id_length(wrapper)
    query_id: str := resource.view_from_raw(statement_ref, id_pointer, id_length) else {
      return Err(invalid_descriptor_error())
    }
    timeout := common_options_valid(options, query_id)?
    state := pkg.db.internal.resource.stmt_connection_state(wrapper)
    connection := postgres_connection(state)
    name := pkg.db.internal.resource.stmt_native(wrapper)
    if connection.is_null() || name.is_null() {
      return Err(descriptor_error(
        query_id,
        "db.statement.state",
        "PostgreSQL prepared statement is closed or poisoned",
      ))
    }
    acquire_lease(state, query_id)?
    context := new_context(connection)
    bind_status := pkg.db.internal.descriptor.bind_prepared(statement_ref, context, params)
    if bind_status != 0 {
      failure := if bind_status == -1 {
        descriptor_error(
          query_id,
          "db.descriptor.shape",
          "static database descriptor uses a Params shape unsupported by prepared execution",
        )
      } else { context_error(context, connection, raw.null(), query_id) }
      free_context(context)
      release_lease(state)
      return Err(failure)
    }
    executed := prepared_execute_with_timeout(
      state, connection, name, context, timeout, query_id, PGRES_TUPLES_OK,
    )
    match executed {
      Err(error) => {
        free_context(context)
        release_lease(state)
        return Err(error)
      }
      Ok(_) => {}
    }
    result: raw := raw.load(context, 8)
    if result.is_null() {
      failure := connection_error(connection)
      pkg.db.internal.resource.poison_conn_state(state)
      free_context(context)
      release_lease(state)
      return Err(failure)
    }
    status := result_status(result)
    if status != PGRES_TUPLES_OK {
      failure := execution_error(connection, result)
      if result_must_close(status) {
        clear_and_poison(state, result)
      } else { prepared_clear(result) }
      free_context(context)
      release_lease(state)
      return Err(failure)
    }
    raw.store(context, 8, result)
    rows_wrapper := pkg.db.internal.resource.new_rows_state(
      DRIVER_POSTGRES,
      result,
      wrapper,
      context,
      state,
      pkg.db.internal.resource.stmt_row_validator(wrapper),
      pkg.db.internal.resource.stmt_stream_decoder(wrapper),
      id_pointer,
      id_length,
      false,
      false,
      false,
      0,
      pkg.db.internal.resource.stmt_batch_plan(wrapper),
    )
    output: pkg.db.rows<R> := resource.from_raw_borrowed(
      rows_wrapper, resource.borrow(statement),
    )
    return Ok(output)
  }
}

pub fn rows_prevalidated<P, R>(
  target: pkg.db.exec,
  params: P,
  statement: pkg.db.query<P, R>,
  query_id: str,
  timeout: Option<i64>,
) -> Result<pkg.db.rows<R>, pkg.db.Error> {
  unsafe {
    if !query_header_valid(statement) { return Err(invalid_descriptor_error()) }
    data := pkg.db.internal.descriptor.data(statement)
    mask: u8 := raw.load(data, 5)
    if mask & 2 == 0 { return Err(driver_mismatch_error(query_id)) }
    state := state_for(target)
    if state.is_null() {
      return Err(descriptor_error(
        query_id,
        "db.exec.state",
        "PostgreSQL execution requires an idle connection or active transaction",
      ))
    }
    connection := postgres_connection(state)
    if connection.is_null() {
      return Err(descriptor_error(
        query_id,
        "db.connection.state",
        "PostgreSQL connection is closed or poisoned",
      ))
    }
    context := new_context(connection)
    static_status := pkg.db.internal.descriptor.validate_static(statement, context)
    if static_status != 0 {
      failure := if static_status == -1 {
        descriptor_error(
          query_id,
          "db.descriptor.shape",
          "static database descriptor uses a field shape unsupported by streaming execution",
        )
      } else { context_error(context, connection, raw.null(), query_id) }
      free_context(context)
      return Err(failure)
    }
    lease := acquire_lease(state, query_id)
    match lease {
      Err(error) => {
        free_context(context)
        return Err(error)
      }
      Ok(_) => {}
    }
    bind_status := pkg.db.internal.descriptor.bind(statement, context, params)
    if bind_status != 0 {
      failure := context_error(context, connection, raw.null(), query_id)
      free_context(context)
      release_lease(state)
      return Err(failure)
    }
    sql := pkg.db.internal.descriptor.postgres_sql_pointer(statement)
    executed := execute_params_with_timeout(
      state, connection, sql, context, timeout, query_id, PGRES_TUPLES_OK,
    )
    match executed {
      Err(error) => {
        free_context(context)
        release_lease(state)
        return Err(error)
      }
      Ok(_) => {}
    }
    result: raw := raw.load(context, 8)
    if result.is_null() {
      failure := connection_error(connection)
      pkg.db.internal.resource.poison_conn_state(state)
      free_context(context)
      release_lease(state)
      return Err(failure)
    }
    status := result_status(result)
    if status != PGRES_TUPLES_OK {
      failure := execution_error(connection, result)
      if result_must_close(status) {
        clear_and_poison(state, result)
        free_context(context)
      } else { clear_result_and_context(result, context) }
      release_lease(state)
      return Err(failure)
    }
    raw.store(context, 8, result)
    raw.store(context, 16, 0 as u32)
    owned_id := c_string(query_id)
    rows_wrapper := pkg.db.internal.resource.new_rows_state(
      DRIVER_POSTGRES,
      result,
      raw.null(),
      context,
      state,
      pkg.db.internal.descriptor.row_validator(statement),
      pkg.db.internal.descriptor.stream_decoder(statement),
      owned_id,
      query_id.len(),
      true,
      false,
      false,
      0,
      pkg.db.internal.descriptor.batch_plan(statement),
    )
    output: pkg.db.rows<R> := match target {
      Conn(reference) => resource.from_raw_borrowed(rows_wrapper, reference)
      Tx(reference) => resource.from_raw_borrowed(rows_wrapper, reference)
    }
    return Ok(output)
  }
}

pub fn next_prevalidated<R>(
  borrow mut rows: pkg.db.rows<R>,
) -> Result<Option<R>, pkg.db.Error> {
  unsafe {
    reference := resource.borrow(rows)
    wrapper := resource.raw(reference)
    if pkg.db.internal.resource.rows_driver(wrapper) != DRIVER_POSTGRES {
      return Err(invalid_descriptor_error())
    }
    terminal := pkg.db.internal.resource.rows_terminal(wrapper)
    if terminal == 1 { return Ok(None) }
    if terminal != 0 {
      return Err(invalid_query_error(
        "database rows",
        "db.rows.state",
        "database rows cannot advance after a failed execution",
      ))
    }
    id_pointer := pkg.db.internal.resource.rows_query_id_pointer(wrapper)
    id_length := pkg.db.internal.resource.rows_query_id_length(wrapper)
    query_id: str := resource.view_from_raw(reference, id_pointer, id_length) else {
      ignored := pkg.db.internal.resource.close_rows(wrapper, 2)
      return Err(invalid_descriptor_error())
    }
    result := pkg.db.internal.resource.rows_native(wrapper)
    context := pkg.db.internal.resource.rows_context(wrapper)
    state := pkg.db.internal.resource.rows_connection_state(wrapper)
    connection := postgres_connection(state)
    if result.is_null() || context.is_null() || connection.is_null() {
      ignored := pkg.db.internal.resource.close_rows(wrapper, 2)
      return Err(descriptor_error(
        query_id,
        "db.rows.state",
        "PostgreSQL rows are closed or poisoned",
      ))
    }
    count := rows_count(result)
    if count < 0 {
      failure := execution_error(connection, result)
      ignored := pkg.db.internal.resource.close_rows(wrapper, 2)
      return Err(failure)
    }
    row: u32 := raw.load(context, 16)
    if row >= (count as u32) {
      ignored := pkg.db.internal.resource.close_rows(wrapper, 1)
      return Ok(None)
    }
    validate_status := pkg.db.internal.descriptor.validate_current_row(reference, context)
    if validate_status != 0 {
      failure := context_error(context, connection, result, query_id)
      ignored := pkg.db.internal.resource.close_rows(wrapper, 2)
      return Err(failure)
    }
    decoded := pkg.db.internal.descriptor.decode_current_row(reference, context)
    raw.store(context, 16, row + 1)
    return Ok(Some(decoded))
  }
}

pub fn next_batch_prevalidated<R>(
  borrow mut rows: pkg.db.rows<R>,
  max_rows: i64,
) -> Result<Option<pkg.db.batch<R>>, pkg.db.Error> {
  unsafe {
    reference := resource.borrow(rows)
    wrapper := resource.raw(reference)
    if pkg.db.internal.resource.rows_driver(wrapper) != DRIVER_POSTGRES
      || !pkg.db.internal.resource.rows_batch_header_valid(wrapper) {
      return Err(pkg.db.Error.InvalidQuery(pkg.db.ContractError {
        query_id: None,
        item: "db.rows.header".clone(),
        message: "invalid database rows resource".clone(),
      }))
    }
    id_pointer := pkg.db.internal.resource.rows_query_id_pointer(wrapper)
    id_length := pkg.db.internal.resource.rows_query_id_length(wrapper)
    plan := pkg.db.internal.resource.rows_batch_plan(wrapper)
    query_id: str := resource.view_from_raw(reference, id_pointer, id_length) else {
      return Err(pkg.db.Error.InvalidQuery(pkg.db.ContractError {
        query_id: None,
        item: "db.rows.header".clone(),
        message: "invalid database rows resource".clone(),
      }))
    }
    if plan.is_null() {
      return Err(pkg.db.Error.InvalidQuery(pkg.db.ContractError {
        query_id: None,
        item: "db.rows.header".clone(),
        message: "invalid database rows resource".clone(),
      }))
    }
    if max_rows <= 0 || max_rows > 2147483647 {
      return Err(descriptor_error(
        query_id,
        "db.batch.max_rows",
        "database batch size must be between 1 and 2147483647 rows",
      ))
    }
    terminal := pkg.db.internal.resource.rows_terminal(wrapper)
    if terminal == 1 { return Ok(None) }
    if terminal != 0 {
      return Err(invalid_query_error(
        query_id,
        "db.rows.state",
        "database rows cannot advance after a failed execution",
      ))
    }
    result := pkg.db.internal.resource.rows_native(wrapper)
    context := pkg.db.internal.resource.rows_context(wrapper)
    state := pkg.db.internal.resource.rows_connection_state(wrapper)
    connection := postgres_connection(state)
    if result.is_null() || context.is_null() || connection.is_null() {
      ignored := pkg.db.internal.resource.close_rows(wrapper, 2)
      return Err(descriptor_error(
        query_id,
        "db.rows.state",
        "PostgreSQL rows are closed or poisoned",
      ))
    }
    count := rows_count(result)
    if count < 0 {
      failure := execution_error(connection, result)
      ignored := pkg.db.internal.resource.close_rows(wrapper, 2)
      return Err(failure)
    }
    mut row: u32 := raw.load(context, 16)
    if row >= (count as u32) {
      ignored := pkg.db.internal.resource.close_rows(wrapper, 1)
      return Ok(None)
    }
    payload := pkg.db.internal.descriptor.create_batch(plan, max_rows)
    if payload.is_null() {
      return Err(descriptor_error(
        query_id,
        "db.batch.layout",
        "database batch layout exceeds the supported address range",
      ))
    }
    mut length := 0
    loop {
      if length >= max_rows || row >= (count as u32) { break }
      validate_status := pkg.db.internal.descriptor.validate_current_row(reference, context)
      if validate_status != 0 {
        failure := context_error(context, connection, result, query_id)
        pkg.db.internal.descriptor.drop_batch_payload(plan, payload)
        ignored := pkg.db.internal.resource.close_rows(wrapper, 2)
        return Err(failure)
      }
      append_status := pkg.db.internal.descriptor.append_current_batch(
        plan, payload, context, reference,
      )
      if append_status != 0 {
        pkg.db.internal.descriptor.drop_batch_payload(plan, payload)
        ignored := pkg.db.internal.resource.close_rows(wrapper, 2)
        return Err(descriptor_error(
          query_id,
          "db.batch.storage",
          "database batch variable-width storage exceeds the supported address range",
        ))
      }
      row = row + 1
      raw.store(context, 16, row)
      length = length + 1
    }
    if row >= (count as u32) {
      ignored := pkg.db.internal.resource.close_rows(wrapper, 1)
    }
    pkg.db.internal.descriptor.finish_batch(plan, payload, length)
    batch_wrapper := pkg.db.internal.resource.new_batch_state(plan, payload, length, max_rows)
    output: pkg.db.batch<R> := resource.from_raw(batch_wrapper)
    return Ok(Some(output))
  }
}

pub fn has_next_prevalidated<R>(
  borrow mut rows: pkg.db.rows<R>,
) -> Result<bool, pkg.db.Error> {
  unsafe {
    reference := resource.borrow(rows)
    wrapper := resource.raw(reference)
    if pkg.db.internal.resource.rows_driver(wrapper) != DRIVER_POSTGRES {
      return Err(invalid_descriptor_error())
    }
    terminal := pkg.db.internal.resource.rows_terminal(wrapper)
    if terminal == 1 { return Ok(false) }
    if terminal != 0 {
      return Err(invalid_query_error(
        "database rows",
        "db.rows.state",
        "database rows cannot advance after a failed execution",
      ))
    }
    id_pointer := pkg.db.internal.resource.rows_query_id_pointer(wrapper)
    id_length := pkg.db.internal.resource.rows_query_id_length(wrapper)
    query_id: str := resource.view_from_raw(reference, id_pointer, id_length) else {
      ignored := pkg.db.internal.resource.close_rows(wrapper, 2)
      return Err(invalid_descriptor_error())
    }
    result := pkg.db.internal.resource.rows_native(wrapper)
    state := pkg.db.internal.resource.rows_connection_state(wrapper)
    connection := postgres_connection(state)
    if result.is_null() || connection.is_null() {
      ignored := pkg.db.internal.resource.close_rows(wrapper, 2)
      return Err(descriptor_error(
        query_id,
        "db.rows.state",
        "PostgreSQL rows are closed or poisoned",
      ))
    }
    count := rows_count(result)
    if count < 0 {
      failure := execution_error(connection, result)
      ignored := pkg.db.internal.resource.close_rows(wrapper, 2)
      return Err(failure)
    }
    context := pkg.db.internal.resource.rows_context(wrapper)
    if context.is_null() {
      ignored := pkg.db.internal.resource.close_rows(wrapper, 2)
      return Err(descriptor_error(
        query_id,
        "db.rows.state",
        "PostgreSQL rows are closed or poisoned",
      ))
    }
    row: u32 := raw.load(context, 16)
    if row < (count as u32) { return Ok(true) }
    ignored := pkg.db.internal.resource.close_rows(wrapper, 1)
    return Ok(false)
  }
}

pub fn execute_prevalidated<P>(
  target: pkg.db.exec,
  params: P,
  statement: pkg.db.command<P>,
  query_id: str,
  timeout: Option<i64>,
) -> Result<pkg.db.exec_result, pkg.db.Error> {
  unsafe {
    data := pkg.db.internal.descriptor.data(statement)
    mask: u8 := raw.load(data, 5)
    if mask & 2 == 0 { return Err(driver_mismatch_error(query_id)) }
    state := state_for(target)
    if state.is_null() {
      return Err(descriptor_error(
        query_id,
        "db.exec.state",
        "PostgreSQL execution requires an idle connection or active transaction",
      ))
    }
    state_driver: u8 := raw.load(state, 4)
    if state_driver != DRIVER_POSTGRES { return Err(driver_mismatch_error(query_id)) }
    connection := postgres_connection(state)
    if connection.is_null() {
      return Err(descriptor_error(
        query_id,
        "db.connection.state",
        "PostgreSQL connection is closed or poisoned",
      ))
    }
    context := new_context(connection)
    static_status := pkg.db.internal.descriptor.validate_static(statement, context)
    if static_status != 0 {
      failure := if static_status == -1 {
        descriptor_error(
          query_id,
          "db.descriptor.shape",
          "static database descriptor uses a field shape unsupported by this execution milestone",
        )
      } else { context_error(context, connection, raw.null(), query_id) }
      free_context(context)
      return Err(failure)
    }
    lease := acquire_lease(state, query_id)
    match lease {
      Err(error) => {
        free_context(context)
        return Err(error)
      }
      Ok(_) => {}
    }
    bind_status := pkg.db.internal.descriptor.bind(statement, context, params)
    if bind_status != 0 {
      failure := context_error(context, connection, raw.null(), query_id)
      free_context(context)
      release_lease(state)
      return Err(failure)
    }
    sql := pkg.db.internal.descriptor.postgres_sql_pointer(statement)
    executed := execute_params_with_timeout(
      state, connection, sql, context, timeout, query_id, PGRES_COMMAND_OK,
    )
    match executed {
      Err(error) => {
        free_context(context)
        release_lease(state)
        return Err(error)
      }
      Ok(_) => {}
    }
    result: raw := raw.load(context, 8)
    if result.is_null() {
      failure := connection_error(connection)
      pkg.db.internal.resource.poison_conn_state(state)
      free_context(context)
      release_lease(state)
      return Err(failure)
    }
    status := result_status(result)
    if status != PGRES_COMMAND_OK {
      failure := if tuple_status(status) {
        invalid_query_error(query_id, "db.command.row", "a database command must not produce rows")
      } else { execution_error(connection, result) }
      if result_must_close(status) {
        clear_and_poison(state, result)
        free_context(context)
      } else { clear_result_and_context(result, context) }
      release_lease(state)
      return Err(failure)
    }
    parsed := parse_affected(command_affected(result))
    match parsed {
      Err(_) => {
        failure := execution_error(connection, result)
        clear_result_and_context(result, context)
        release_lease(state)
        return Err(failure)
      }
      Ok(affected) => {
        clear_result_and_context(result, context)
        release_lease(state)
        return Ok(pkg.db.exec_result { rows_affected: affected })
      }
    }
  }
}

pub fn one_prevalidated<P, R>(
  target: pkg.db.exec,
  params: P,
  statement: pkg.db.query<P, R>,
  out: region,
  query_id: str,
) -> Result<R, pkg.db.Error> {
  unsafe {
    data := pkg.db.internal.descriptor.data(statement)
    mask: u8 := raw.load(data, 5)
    if mask & 2 == 0 { return Err(driver_mismatch_error(query_id)) }
    state := state_for(target)
    if state.is_null() {
      return Err(descriptor_error(
        query_id,
        "db.exec.state",
        "PostgreSQL execution requires an idle connection or active transaction",
      ))
    }
    state_driver: u8 := raw.load(state, 4)
    if state_driver != DRIVER_POSTGRES { return Err(driver_mismatch_error(query_id)) }
    connection := postgres_connection(state)
    if connection.is_null() {
      return Err(descriptor_error(
        query_id,
        "db.connection.state",
        "PostgreSQL connection is closed or poisoned",
      ))
    }
    context := new_context(connection)
    static_status := pkg.db.internal.descriptor.validate_static(statement, context)
    if static_status != 0 {
      failure := if static_status == -1 {
        descriptor_error(
          query_id,
          "db.descriptor.shape",
          "static database descriptor uses a field shape unsupported by this execution milestone",
        )
      } else { context_error(context, connection, raw.null(), query_id) }
      free_context(context)
      return Err(failure)
    }
    bind_status := pkg.db.internal.descriptor.bind(statement, context, params)
    if bind_status != 0 {
      failure := context_error(context, connection, raw.null(), query_id)
      free_context(context)
      return Err(failure)
    }
    sql := pkg.db.internal.descriptor.postgres_sql_pointer(statement)
    result := execute_params(connection, sql, context)
    if result.is_null() {
      failure := connection_error(connection)
      pkg.db.internal.resource.poison_conn_state(state)
      free_context(context)
      return Err(failure)
    }
    status := result_status(result)
    if status != PGRES_TUPLES_OK {
      failure := execution_error(connection, result)
      if result_must_close(status) {
        clear_and_poison(state, result)
        free_context(context)
      } else { clear_result_and_context(result, context) }
      return Err(failure)
    }
    rows := result_rows(result)
    if rows < 0 {
      failure := execution_error(connection, result)
      clear_result_and_context(result, context)
      return Err(failure)
    }
    if rows == 0 {
      failure := cardinality_error(0)
      clear_result_and_context(result, context)
      return Err(failure)
    }
    raw.store(context, 8, result)
    row: u32 := 0
    raw.store(context, 16, row)
    validate_status := pkg.db.internal.descriptor.validate_row(statement, context)
    if validate_status != 0 {
      failure := context_error(context, connection, result, query_id)
      clear_result_and_context(result, context)
      return Err(failure)
    }
    if rows > 1 {
      failure := cardinality_error(2)
      clear_result_and_context(result, context)
      return Err(failure)
    }
    decoded := pkg.db.internal.descriptor.decode(statement, context)
    clear_result_and_context(result, context)
    return Ok(decoded)
  }
}

pub fn explain_prevalidated<P, R>(
  target: pkg.db.exec,
  params: P,
  statement: pkg.db.query<P, R>,
  row_type: Option<R>,
  out: region,
  query_id: str,
  format: u8,
  option_mask: u8,
  option_values: u8,
) -> Result<pkg.db.QueryPlan, pkg.db.Error> {
  unsafe {
    if format > 2 || option_mask & 128 != 0 || option_values & ~option_mask != 0 {
      return Err(descriptor_error(
        query_id,
        "postgres.explain.options",
        "invalid normalized PostgreSQL EXPLAIN options",
      ))
    }
    if option_mask & 1 != option_values & 1 {
      return Err(descriptor_error(
        query_id,
        "postgres.explain.analyze",
        "PostgreSQL Analyze normalization is inconsistent",
      ))
    }
    if option_mask & 88 != 0 && option_mask & 1 == 0 {
      return Err(descriptor_error(
        query_id,
        "postgres.explain.analyze",
        "PostgreSQL Buffers, Timing, and Wal require Analyze",
      ))
    }
    data := pkg.db.internal.descriptor.data(statement)
    mask: u8 := raw.load(data, 5)
    if mask & 2 == 0 { return Err(driver_mismatch_error(query_id)) }
    state := state_for(target)
    if state.is_null() {
      return Err(descriptor_error(
        query_id,
        "db.exec.state",
        "PostgreSQL execution requires an idle connection or active transaction",
      ))
    }
    state_driver: u8 := raw.load(state, 4)
    if state_driver != DRIVER_POSTGRES { return Err(driver_mismatch_error(query_id)) }
    connection := postgres_connection(state)
    if connection.is_null() {
      return Err(descriptor_error(
        query_id,
        "db.connection.state",
        "PostgreSQL connection is closed or poisoned",
      ))
    }
    context := new_context(connection)
    static_status := pkg.db.internal.descriptor.validate_static(statement, context)
    if static_status != 0 {
      failure := if static_status == -1 {
        descriptor_error(
          query_id,
          "db.descriptor.shape",
          "static database descriptor uses a field shape unsupported by EXPLAIN",
        )
      } else { context_error(context, connection, raw.null(), query_id) }
      free_context(context)
      return Err(failure)
    }
    bind_status := pkg.db.internal.descriptor.bind(statement, context, params)
    if bind_status != 0 {
      failure := context_error(context, connection, raw.null(), query_id)
      free_context(context)
      return Err(failure)
    }
    lease := acquire_lease(state, query_id)
    match lease {
      Err(error) => {
        free_context(context)
        return Err(error)
      }
      Ok(_) => {}
    }

    mut sql_builder := builder()
    sql_builder.write("EXPLAIN")
    if option_mask != 0 || format != 0 {
      sql_builder.write(" (")
      mut wrote := false
      if option_mask & 1 != 0 {
        sql_builder.write("ANALYZE TRUE")
        wrote = true
      }
      names := ["VERBOSE", "COSTS", "BUFFERS", "TIMING", "SETTINGS", "WAL"]
      mut bit: u8 := 2
      mut name_index := 0
      loop {
        if name_index >= names.len() { break }
        if option_mask & bit != 0 {
          if wrote { sql_builder.write(", ") }
          sql_builder.write(names[name_index])
          if option_values & bit != 0 {
            sql_builder.write(" TRUE")
          } else { sql_builder.write(" FALSE") }
          wrote = true
        }
        bit = bit * 2
        name_index = name_index + 1
      }
      if format != 0 {
        if wrote { sql_builder.write(", ") }
        if format == 1 { sql_builder.write("FORMAT TEXT") }
        if format == 2 { sql_builder.write("FORMAT JSON") }
      }
      sql_builder.write(")")
    }
    sql_builder.write(" ")
    sql_builder.write(pkg.db.internal.descriptor.postgres_sql(statement))
    sql := sql_builder.to_string()
    sql_pointer := c_string(sql)
    result := execute_params(connection, sql_pointer, context)
    raw.free(sql_pointer)
    if result.is_null() {
      failure := connection_error(connection)
      pkg.db.internal.resource.poison_conn_state(state)
      free_context(context)
      release_lease(state)
      return Err(failure)
    }
    status := result_status(result)
    if status != PGRES_TUPLES_OK {
      failure := execution_error(connection, result)
      if result_must_close(status) {
        clear_and_poison(state, result)
        free_context(context)
      } else { clear_result_and_context(result, context) }
      release_lease(state)
      return Err(failure)
    }
    rows := result_rows(result)
    if rows <= 0 || result_fields(result) != 1 {
      failure := pkg.db.Error.Decode(pkg.db.ContractError {
        query_id: Some(query_id.clone()),
        item: "db.explain.row".clone(),
        message: "PostgreSQL EXPLAIN returned an invalid result shape".clone(),
      })
      clear_result_and_context(result, context)
      release_lease(state)
      return Err(failure)
    }
    mut body_builder := builder()
    mut row: i32 := 0
    loop {
      if row >= rows { break }
      if result_is_null(result, row, 0) {
        failure := pkg.db.Error.Decode(pkg.db.ContractError {
          query_id: Some(query_id.clone()),
          item: "db.explain.row".clone(),
          message: "PostgreSQL EXPLAIN returned a null plan row".clone(),
        })
        clear_result_and_context(result, context)
        release_lease(state)
        return Err(failure)
      }
      pointer := result_value(result, row, 0)
      length := result_length(result, row, 0)
      if length < 0 || (pointer.is_null() && length != 0) {
        failure := pkg.db.Error.Decode(pkg.db.ContractError {
          query_id: Some(query_id.clone()),
          item: "db.explain.row".clone(),
          message: "PostgreSQL EXPLAIN returned an invalid text field".clone(),
        })
        clear_result_and_context(result, context)
        release_lease(state)
        return Err(failure)
      }
      mut text_buffer := buffer(length as i64)
      mut i: i32 := 0
      loop {
        if i >= length { break }
        byte: u8 := raw.load(pointer, i as i64)
        text_buffer.put_u8(byte)
        i = i + 1
      }
      text := text_buffer.bytes().as_str() else {
        failure := pkg.db.Error.Decode(pkg.db.ContractError {
          query_id: Some(query_id.clone()),
          item: "db.explain.row".clone(),
          message: "PostgreSQL EXPLAIN output is not valid UTF-8".clone(),
        })
        clear_result_and_context(result, context)
        release_lease(state)
        return Err(failure)
      }
      if row > 0 { body_builder.write("\n") }
      body_builder.write(text)
      row = row + 1
    }
    body := body_builder.to_string()
    clear_result_and_context(result, context)
    release_lease(state)
    return Ok(pkg.db.QueryPlan {
      driver: pkg.db.Driver.PostgreSQL,
      format: if format == 2 { pkg.db.PlanFormat.Json } else { pkg.db.PlanFormat.Text },
      analyzed: option_mask & 1 != 0,
      body: body.clone_in(out),
    })
  }
}
