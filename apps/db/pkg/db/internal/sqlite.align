module pkg.db.internal.sqlite

import pkg.db
import pkg.db.internal
import pkg.db.internal.descriptor
import pkg.db.internal.resource

extern "C" link("sqlite3") {
  fn sqlite3_busy_timeout(database: raw, milliseconds: i32) -> i32
  fn sqlite3_errcode(database: raw) -> i32
  fn sqlite3_extended_errcode(database: raw) -> i32
  fn sqlite3_errmsg(database: raw) -> raw
  fn sqlite3_prepare_v2(database: raw, sql: raw, bytes: i32, statement_out: raw, tail_out: raw) -> i32
  fn sqlite3_prepare_v3(
    database: raw,
    sql: raw,
    bytes: i32,
    flags: u32,
    statement_out: raw,
    tail_out: raw,
  ) -> i32
  fn sqlite3_finalize(statement: raw) -> i32
  fn sqlite3_reset(statement: raw) -> i32
  fn sqlite3_clear_bindings(statement: raw) -> i32
  fn sqlite3_step(statement: raw) -> i32
  fn sqlite3_close_v2(database: raw) -> i32
  fn sqlite3_changes64(database: raw) -> i64
  fn sqlite3_column_count(statement: raw) -> i32
  fn sqlite3_column_type(statement: raw, index: i32) -> i32
  fn sqlite3_column_int64(statement: raw, index: i32) -> i64
  fn sqlite3_column_text(statement: raw, index: i32) -> raw
  fn sqlite3_column_bytes(statement: raw, index: i32) -> i32
}

pub SQLITE_OK: i32 := 0
SQLITE_TIMEOUT_MAX_MS: i64 := 2147483647
pub SQLITE_ROW: i32 := 100
pub SQLITE_DONE: i32 := 101
pub SQLITE_INTEGER: i32 := 1
pub SQLITE_TEXT: i32 := 3
pub SQLITE_NULL: i32 := 5
pub DRIVER_SQLITE: u8 := 1
CONTEXT_VERSION: u32 := 2
FAILURE_NATIVE: u8 := 1
FAILURE_UNSUPPORTED: u8 := 2
FAILURE_ROW: u8 := 3
FAILURE_ENCODE: u8 := 4

pub fn rows_step(native: raw) -> i32 {
  unsafe { return sqlite3_step(native) }
}

pub fn descriptor_error(query_id: str, item: str, message: str) -> pkg.db.Error =
  pkg.db.Error.Unsupported(pkg.db.ContractError {
    query_id: Some(query_id.clone()),
    item: item.clone(),
    message: message.clone(),
  })

pub fn invalid_descriptor_error() -> pkg.db.Error = pkg.db.Error.InvalidQuery(
  pkg.db.ContractError {
    query_id: None,
    item: "db.descriptor.header".clone(),
    message: "invalid static database descriptor".clone(),
  },
)

pub fn invalid_query_error(query_id: str, item: str, message: str) -> pkg.db.Error =
  pkg.db.Error.InvalidQuery(pkg.db.ContractError {
    query_id: Some(query_id.clone()),
    item: item.clone(),
    message: message.clone(),
  })

pub fn driver_mismatch_error(query_id: str) -> pkg.db.Error = pkg.db.Error.DriverMismatch(
  pkg.db.ContractError {
    query_id: Some(query_id.clone()),
    item: "db.descriptor.driver".clone(),
    message: "static database descriptor does not support SQLite".clone(),
  },
)

pub fn cardinality_error(minimum: i64, maximum: i64, observed: i64) -> pkg.db.Error =
  pkg.db.Error.Cardinality(pkg.db.CardinalityError {
    expected_min: minimum,
    expected_max: maximum,
    observed_at_least: observed,
  })

fn copy_c_string(pointer: raw) -> string {
  unsafe {
    if pointer.is_null() { return "".clone() }
    mut output := buffer(64)
    mut i := 0
    loop {
      byte: u8 := raw.load(pointer, i)
      if byte == 0 { break }
      output.put_u8(byte)
      i = i + 1
    }
    text := output.bytes().as_str() else "invalid UTF-8 in SQLite error"
    return text.clone()
  }
}

pub fn sqlite_error(database: raw) -> pkg.db.Error {
  unsafe {
    primary := sqlite3_errcode(database)
    extended := sqlite3_extended_errcode(database)
    mut code_builder := builder()
    code_builder.write_int(primary)
    code := code_builder.to_string()
    message := copy_c_string(sqlite3_errmsg(database))
    return pkg.db.Error.Connection(pkg.db.NativeError {
      driver: pkg.db.Driver.SQLite,
      code: Some(code),
      extended_code: Some(extended as i64),
      sqlstate: None,
      message: message,
      detail: None,
      constraint: None,
      table: None,
      column: None,
    })
  }
}

pub fn execution_timeout_ms(ns: i64, query_id: str) -> Result<i32, pkg.db.Error> {
  if ns <= 0 {
    return Err(descriptor_error(
      query_id,
      "sqlite.execute.busy_timeout_ns",
      "SQLite busy timeout must be positive",
    ))
  }
  mut milliseconds := ns / 1000000
  if ns % 1000000 != 0 { milliseconds = milliseconds + 1 }
  if milliseconds > SQLITE_TIMEOUT_MAX_MS {
    return Err(descriptor_error(
      query_id,
      "sqlite.execute.busy_timeout_ns",
      "SQLite busy timeout exceeds the native i32 millisecond range",
    ))
  }
  return Ok(milliseconds as i32)
}

pub fn common_options_valid(options: slice<pkg.db.ExecuteOption>, query_id: str) -> Result<(), pkg.db.Error> {
  mut saw_timeout := false
  mut i := 0
  loop {
    if i >= options.len() { break }
    match options[i] {
      TimeoutNs(ns) => {
        if ns <= 0 {
          return Err(descriptor_error(
            query_id,
            "db.execute.timeout_ns",
            "database execution timeout must be positive",
          ))
        }
        if saw_timeout {
          return Err(descriptor_error(
            query_id,
            "db.execute.timeout_ns",
            "duplicate database execution timeout",
          ))
        }
        saw_timeout = true
      }
    }
    i = i + 1
  }
  if saw_timeout {
    return Err(descriptor_error(
      query_id,
      "db.execute.timeout_ns",
      "SQLite does not support common execution deadlines",
    ))
  }
  return Ok(())
}

pub fn tail_is_empty(pointer: raw) -> bool {
  unsafe {
    if pointer.is_null() { return false }
    mut i := 0
    loop {
      byte: u8 := raw.load(pointer, i)
      if byte == 0 { return true }
      if byte == 9 || byte == 10 || byte == 11 || byte == 12 || byte == 13 || byte == 32 {
        i = i + 1
      } else {
        if byte == 45 {
          next: u8 := raw.load(pointer, i + 1)
          if next == 45 {
            i = i + 2
            loop {
              comment: u8 := raw.load(pointer, i)
              if comment == 0 { return true }
              i = i + 1
              if comment == 10 || comment == 13 { break }
            }
          } else { return false }
        } else {
          if byte == 47 {
            next: u8 := raw.load(pointer, i + 1)
            if next != 42 { return false }
            i = i + 2
            mut closed := false
            loop {
              comment: u8 := raw.load(pointer, i)
              if comment == 0 { break }
              if comment == 42 {
                after: u8 := raw.load(pointer, i + 1)
                if after == 47 {
                  i = i + 2
                  closed = true
                  break
                }
              }
              i = i + 1
            }
            if !closed { return false }
          } else { return false }
        }
      }
    }
  }
}

pub fn new_context(native: raw) -> raw {
  unsafe {
    context := raw.alloc(56)
    version: u32 := CONTEXT_VERSION
    driver: u8 := DRIVER_SQLITE
    clear8: u8 := 0
    clear16: u16 := 0
    clear32: u32 := 0
    raw.store(context, 0, version)
    raw.store(context, 4, driver)
    raw.store(context, 5, clear8)
    raw.store(context, 6, clear16)
    raw.store(context, 8, native)
    raw.store(context, 16, clear32)
    raw.store(context, 20, clear32)
    raw.store(context, 24, raw.null())
    raw.store(context, 32, clear32)
    raw.store(context, 36, clear32)
    raw.store(context, 40, raw.null())
    raw.store(context, 48, clear32)
    raw.store(context, 52, clear32)
    return context
  }
}

pub fn free_context(context: raw) {
  unsafe {
    if context.is_null() { return }
    pkg.db.internal.release_row_cache_v2(context)
    values: raw := raw.load(context, 40)
    count: u32 := raw.load(context, 48)
    if !values.is_null() {
      mut i: u32 := 0
      loop {
        if i >= count { break }
        value: raw := raw.load(values, (i as i64) * 8)
        if !value.is_null() { raw.free(value) }
        i = i + 1
      }
      raw.free(values)
    }
    raw.free(context)
  }
}

pub fn copy_bytes(value: str) -> raw {
  unsafe {
    bytes := value.bytes()
    output := raw.alloc(bytes.len() + 1)
    mut i := 0
    loop {
      if i >= bytes.len() { break }
      raw.store(output, i, bytes[i])
      i = i + 1
    }
    raw.store(output, bytes.len(), 0 as u8)
    return output
  }
}

pub fn context_error(context: raw, database: raw, query_id: str) -> pkg.db.Error {
  unsafe {
    failure: u8 := raw.load(context, 5)
    if failure == FAILURE_UNSUPPORTED {
      return descriptor_error(
        query_id,
        "db.descriptor.static_option",
        "static database option is unsupported by the linked SQLite library",
      )
    }
    if failure == FAILURE_ROW {
      return pkg.db.Error.Decode(pkg.db.ContractError {
        query_id: Some(query_id.clone()),
        item: "db.row".clone(),
        message: "SQLite row does not match the static Row contract".clone(),
      })
    }
    if failure == FAILURE_ENCODE {
      return pkg.db.Error.Encode(pkg.db.ContractError {
        query_id: Some(query_id.clone()),
        item: "db.parameter".clone(),
        message: "database parameter cannot be represented by SQLite".clone(),
      })
    }
    return sqlite_error(database)
  }
}

pub fn state_for(target: pkg.db.exec) -> raw {
  unsafe {
    return match target {
      Conn(reference) => {
        state := resource.raw(reference)
        if pkg.db.internal.resource.transaction_active(state) { raw.null() } else { state }
      }
      Tx(reference) => {
        state := resource.raw(reference)
        if pkg.db.internal.resource.transaction_active(state) { state } else { raw.null() }
      }
    }
  }
}

pub fn sqlite_connection(state: raw) -> raw {
  unsafe {
    if state.is_null() { return raw.null() }
    version: u32 := raw.load(state, 0)
    driver: u8 := raw.load(state, 4)
    closed: u8 := raw.load(state, 5)
    reserved: u16 := raw.load(state, 6)
    database: raw := raw.load(state, 8)
    if driver != DRIVER_SQLITE { return raw.null() }
    if version != 1 || reserved != 0 || closed != 0 || database.is_null() {
      return raw.null()
    }
    return database
  }
}

pub fn acquire_lease(state: raw, query_id: str) -> Result<(), pkg.db.Error> {
  unsafe {
    active: u8 := raw.load(state, 20)
    if active != 0 {
      return Err(descriptor_error(
        query_id,
        "sqlite.connection.active_execution",
        "SQLite connection already has an active execution",
      ))
    }
    active_now: u8 := 1
    raw.store(state, 20, active_now)
    return Ok(())
  }
}

pub fn command_header_valid<P>(statement: pkg.db.command<P>) -> bool {
  return pkg.db.command_header_valid(statement, pkg.db.internal.descriptor_header_control())
}

pub fn query_header_valid<P, R>(statement: pkg.db.query<P, R>) -> bool {
  return pkg.db.query_header_valid(statement, pkg.db.internal.descriptor_header_control())
}

pub fn cleanup_execution(
  state: raw,
  database: raw,
  statement: raw,
  context: raw,
  restore_timeout: bool,
  prior_timeout: i32,
) -> Result<(), pkg.db.Error> {
  unsafe {
    finalize_status := if statement.is_null() { SQLITE_OK } else {
      sqlite3_finalize(statement)
    }
    if finalize_status != SQLITE_OK {
      // Own SQLite's connection-global error before timeout restoration or close can replace it.
      failure := sqlite_error(database)
      free_context(context)
      if restore_timeout {
        restore_status := sqlite3_busy_timeout(database, prior_timeout)
        if restore_status != SQLITE_OK { poison_and_close(state, database) }
      }
      clear_execution_lease(state)
      return Err(failure)
    }
    free_context(context)
    if restore_timeout {
      restore_status := sqlite3_busy_timeout(database, prior_timeout)
      if restore_status != SQLITE_OK {
        failure := sqlite_error(database)
        poison_and_close(state, database)
        return Err(failure)
      }
    }
    clear_execution_lease(state)
    return Ok(())
  }
}

fn clear_execution_lease(state: raw) {
  unsafe {
    clear: u8 := 0
    raw.store(state, 20, clear)
  }
}

fn poison_and_close(state: raw, database: raw) {
  unsafe {
    poisoned: u8 := 1
    raw.store(state, 5, poisoned)
    raw.store(state, 8, raw.null())
    clear_execution_lease(state)
    ignored := sqlite3_close_v2(database)
  }
}

pub fn execution_busy_timeout(database: raw, milliseconds: i32) -> i32 {
  unsafe { return sqlite3_busy_timeout(database, milliseconds) }
}

pub fn execution_prepare(
  database: raw,
  sql: raw,
  statement_out: raw,
  tail_out: raw,
) -> i32 {
  unsafe { return sqlite3_prepare_v2(database, sql, -1, statement_out, tail_out) }
}

pub fn prepared_open(
  database: raw,
  sql: raw,
  flags: u32,
  statement_out: raw,
  tail_out: raw,
) -> i32 {
  unsafe { return sqlite3_prepare_v3(database, sql, -1, flags, statement_out, tail_out) }
}

pub fn prepared_finalize(statement: raw) -> i32 {
  unsafe { return sqlite3_finalize(statement) }
}

pub fn prepared_reset(statement: raw) -> i32 {
  unsafe { return sqlite3_reset(statement) }
}

pub fn prepared_clear_bindings(statement: raw) -> i32 {
  unsafe { return sqlite3_clear_bindings(statement) }
}

pub fn execution_step(statement: raw) -> i32 {
  unsafe { return sqlite3_step(statement) }
}

pub fn execution_column_count(statement: raw) -> i32 {
  unsafe { return sqlite3_column_count(statement) }
}

pub fn execution_column_type(statement: raw, column: i32) -> i32 {
  unsafe { return sqlite3_column_type(statement, column) }
}

pub fn execution_column_i64(statement: raw, column: i32) -> i64 {
  unsafe { return sqlite3_column_int64(statement, column) }
}

pub fn execution_column_text(statement: raw, column: i32) -> raw {
  unsafe { return sqlite3_column_text(statement, column) }
}

pub fn execution_column_bytes(statement: raw, column: i32) -> i32 {
  unsafe { return sqlite3_column_bytes(statement, column) }
}

pub fn execution_changes(database: raw) -> i64 {
  unsafe { return sqlite3_changes64(database) }
}

pub fn prepare_prevalidated<P, R>(
  target: pkg.db.exec,
  statement: pkg.db.query<P, R>,
  query_id: str,
  flags: u32,
) -> Result<pkg.db.stmt<P, R>, pkg.db.Error> {
  unsafe {
    if !query_header_valid(statement) { return Err(invalid_descriptor_error()) }
    if pkg.db.driver_tag(target) != DRIVER_SQLITE { return Err(driver_mismatch_error(query_id)) }
    state := state_for(target)
    database := sqlite_connection(state)
    if database.is_null() {
      return Err(descriptor_error(
        query_id,
        "db.connection.state",
        "SQLite connection is closed, poisoned, or not transaction-active",
      ))
    }
    sql := pkg.db.internal.descriptor.sqlite_sql_pointer(statement)
    if sql.is_null() { return Err(driver_mismatch_error(query_id)) }
    context := new_context(database)
    static_status := pkg.db.internal.descriptor.validate_static(statement, context)
    if static_status != 0 {
      failure := if static_status == -1 {
        descriptor_error(
          query_id,
          "db.descriptor.shape",
          "static database descriptor uses a field shape unsupported by prepared execution",
        )
      } else { context_error(context, database, query_id) }
      free_context(context)
      return Err(failure)
    }
    free_context(context)
    acquire_lease(state, query_id)?
    statement_out := raw.alloc(8)
    tail_out := raw.alloc(8)
    raw.store(statement_out, 0, raw.null())
    raw.store(tail_out, 0, raw.null())
    status := prepared_open(database, sql, flags, statement_out, tail_out)
    native: raw := raw.load(statement_out, 0)
    tail: raw := raw.load(tail_out, 0)
    raw.free(statement_out)
    raw.free(tail_out)
    if status != SQLITE_OK || native.is_null() {
      failure := sqlite_error(database)
      mut cleanup_ok := true
      if !native.is_null() { cleanup_ok = prepared_finalize(native) == SQLITE_OK }
      if cleanup_ok { raw.store(state, 20, 0 as u8) } else {
        pkg.db.internal.resource.poison_conn_state(state)
      }
      return Err(failure)
    }
    if !tail_is_empty(tail) {
      cleanup_ok := prepared_finalize(native) == SQLITE_OK
      if cleanup_ok { raw.store(state, 20, 0 as u8) } else {
        pkg.db.internal.resource.poison_conn_state(state)
      }
      return Err(invalid_query_error(
        query_id,
        "db.statement.count",
        "static Query must contain exactly one SQLite statement",
      ))
    }
    owned_id := copy_bytes(query_id)
    binder := pkg.db.internal.descriptor.binder(statement)
    row_validator := pkg.db.internal.descriptor.row_validator(statement)
    stream_decoder := pkg.db.internal.descriptor.stream_decoder(statement)
    batch_plan := pkg.db.internal.descriptor.batch_plan(statement)
    wrapper := pkg.db.internal.resource.new_stmt_state(
      DRIVER_SQLITE,
      native,
      state,
      binder,
      owned_id,
      query_id.len(),
      raw.null(),
      row_validator,
      stream_decoder,
      batch_plan,
    )
    raw.store(state, 20, 0 as u8)
    prepared: pkg.db.stmt<P, R> := match target {
      Conn(reference) => resource.from_raw_borrowed(wrapper, reference)
      Tx(reference) => resource.from_raw_borrowed(wrapper, reference)
    }
    return Ok(prepared)
  }
}

pub fn rows_stmt_prevalidated<P, R>(
  borrow mut statement: pkg.db.stmt<P, R>,
  params: P,
  options: slice<pkg.db.ExecuteOption>,
) -> Result<pkg.db.rows<R>, pkg.db.Error> {
  unsafe {
    statement_ref := resource.borrow(statement)
    wrapper := resource.raw(statement_ref)
    if pkg.db.internal.resource.stmt_driver(wrapper) != DRIVER_SQLITE {
      return Err(invalid_descriptor_error())
    }
    id_pointer := pkg.db.internal.resource.stmt_query_id_pointer(wrapper)
    id_length := pkg.db.internal.resource.stmt_query_id_length(wrapper)
    query_id: str := resource.view_from_raw(statement_ref, id_pointer, id_length) else {
      return Err(invalid_descriptor_error())
    }
    common_options_valid(options, query_id)?
    state := pkg.db.internal.resource.stmt_connection_state(wrapper)
    database := sqlite_connection(state)
    native := pkg.db.internal.resource.stmt_native(wrapper)
    if database.is_null() || native.is_null() {
      return Err(descriptor_error(
        query_id,
        "db.statement.state",
        "SQLite prepared statement is closed or poisoned",
      ))
    }
    acquire_lease(state, query_id)?
    context := new_context(native)
    bind_status := pkg.db.internal.descriptor.bind_prepared(statement_ref, context, params)
    if bind_status != 0 {
      failure := context_error(context, database, query_id)
      reset_status := prepared_reset(native)
      clear_status := prepared_clear_bindings(native)
      free_context(context)
      if reset_status != SQLITE_OK || clear_status != SQLITE_OK {
        pkg.db.internal.resource.poison_conn_state(state)
      } else {
        raw.store(state, 20, 0 as u8)
      }
      return Err(failure)
    }
    rows_wrapper := pkg.db.internal.resource.new_rows_state(
      DRIVER_SQLITE,
      native,
      wrapper,
      context,
      state,
      pkg.db.internal.resource.stmt_row_validator(wrapper),
      pkg.db.internal.resource.stmt_stream_decoder(wrapper),
      id_pointer,
      id_length,
      false,
      false,
      false,
      0,
      pkg.db.internal.resource.stmt_batch_plan(wrapper),
    )
    output: pkg.db.rows<R> := resource.from_raw_borrowed(
      rows_wrapper, resource.borrow(statement),
    )
    return Ok(output)
  }
}

pub fn rows_prevalidated<P, R>(
  target: pkg.db.exec,
  params: P,
  statement: pkg.db.query<P, R>,
  query_id: str,
  timeout: Option<i32>,
) -> Result<pkg.db.rows<R>, pkg.db.Error> {
  unsafe {
    if !query_header_valid(statement) { return Err(invalid_descriptor_error()) }
    data := pkg.db.internal.descriptor.data(statement)
    mask: u8 := raw.load(data, 5)
    if mask & 1 == 0 { return Err(driver_mismatch_error(query_id)) }
    state := state_for(target)
    if state.is_null() {
      return Err(descriptor_error(
        query_id,
        "db.exec.state",
        "SQLite execution requires an idle connection or active transaction",
      ))
    }
    database := sqlite_connection(state)
    if database.is_null() {
      return Err(descriptor_error(
        query_id,
        "db.connection.state",
        "SQLite connection is closed or poisoned",
      ))
    }
    context := new_context(raw.null())
    static_status := pkg.db.internal.descriptor.validate_static(statement, context)
    if static_status != 0 {
      failure := if static_status == -1 {
        descriptor_error(
          query_id,
          "db.descriptor.shape",
          "static database descriptor uses a field shape unsupported by streaming execution",
        )
      } else { context_error(context, database, query_id) }
      free_context(context)
      return Err(failure)
    }
    lease := acquire_lease(state, query_id)
    match lease {
      Err(error) => {
        free_context(context)
        return Err(error)
      }
      Ok(_) => {}
    }

    prior_timeout: i32 := raw.load(state, 16)
    mut restore_timeout := false
    match timeout {
      Some(milliseconds) => {
        restore_timeout = true
        status := execution_busy_timeout(database, milliseconds)
        if status != SQLITE_OK {
          failure := sqlite_error(database)
          cleaned := cleanup_execution(
            state, database, raw.null(), context, restore_timeout, prior_timeout,
          )
          return Err(failure)
        }
      }
      None => {}
    }

    statement_out := raw.alloc(8)
    tail_out := raw.alloc(8)
    raw.store(statement_out, 0, raw.null())
    raw.store(tail_out, 0, raw.null())
    sql := pkg.db.internal.descriptor.sqlite_sql_pointer(statement)
    prepare_status := execution_prepare(database, sql, statement_out, tail_out)
    native_statement: raw := raw.load(statement_out, 0)
    tail: raw := raw.load(tail_out, 0)
    raw.free(statement_out)
    raw.free(tail_out)
    if prepare_status != SQLITE_OK || native_statement.is_null() {
      failure := sqlite_error(database)
      cleaned := cleanup_execution(
        state, database, native_statement, context, restore_timeout, prior_timeout,
      )
      return Err(failure)
    }
    if !tail_is_empty(tail) {
      failure := invalid_query_error(
        query_id,
        "db.statement.tail",
        "static Query must contain exactly one SQL statement",
      )
      cleaned := cleanup_execution(
        state, database, native_statement, context, restore_timeout, prior_timeout,
      )
      return Err(failure)
    }
    raw.store(context, 8, native_statement)
    bind_status := pkg.db.internal.descriptor.bind(statement, context, params)
    if bind_status != 0 {
      failure := context_error(context, database, query_id)
      cleaned := cleanup_execution(
        state, database, native_statement, context, restore_timeout, prior_timeout,
      )
      return Err(failure)
    }
    owned_id := copy_bytes(query_id)
    rows_wrapper := pkg.db.internal.resource.new_rows_state(
      DRIVER_SQLITE,
      native_statement,
      raw.null(),
      context,
      state,
      pkg.db.internal.descriptor.row_validator(statement),
      pkg.db.internal.descriptor.stream_decoder(statement),
      owned_id,
      query_id.len(),
      true,
      true,
      restore_timeout,
      prior_timeout,
      pkg.db.internal.descriptor.batch_plan(statement),
    )
    output: pkg.db.rows<R> := match target {
      Conn(reference) => resource.from_raw_borrowed(rows_wrapper, reference)
      Tx(reference) => resource.from_raw_borrowed(rows_wrapper, reference)
    }
    return Ok(output)
  }
}

pub fn next_prevalidated<R>(
  borrow mut rows: pkg.db.rows<R>,
) -> Result<Option<R>, pkg.db.Error> {
  unsafe {
    reference := resource.borrow(rows)
    wrapper := resource.raw(reference)
    if pkg.db.internal.resource.rows_driver(wrapper) != DRIVER_SQLITE {
      return Err(invalid_descriptor_error())
    }
    terminal := pkg.db.internal.resource.rows_terminal(wrapper)
    if terminal == 1 { return Ok(None) }
    if terminal != 0 {
      return Err(invalid_query_error(
        "database rows",
        "db.rows.state",
        "database rows cannot advance after a failed execution",
      ))
    }
    id_pointer := pkg.db.internal.resource.rows_query_id_pointer(wrapper)
    id_length := pkg.db.internal.resource.rows_query_id_length(wrapper)
    query_id: str := resource.view_from_raw(reference, id_pointer, id_length) else {
      ignored := pkg.db.internal.resource.close_rows(wrapper, 2)
      return Err(invalid_descriptor_error())
    }
    native := pkg.db.internal.resource.rows_native(wrapper)
    context := pkg.db.internal.resource.rows_context(wrapper)
    state := pkg.db.internal.resource.rows_connection_state(wrapper)
    database := sqlite_connection(state)
    if native.is_null() || context.is_null() || database.is_null() {
      ignored := pkg.db.internal.resource.close_rows(wrapper, 2)
      return Err(descriptor_error(
        query_id,
        "db.rows.state",
        "SQLite rows are closed or poisoned",
      ))
    }
    step_status := rows_step(native)
    if step_status == SQLITE_DONE {
      cleanup_status := pkg.db.internal.resource.close_rows(wrapper, 1)
      if cleanup_status != SQLITE_OK {
        return Err(descriptor_error(
          query_id,
          "db.rows.cleanup",
          "SQLite rows cleanup failed and the connection was closed",
        ))
      }
      return Ok(None)
    }
    if step_status != SQLITE_ROW {
      failure := sqlite_error(database)
      ignored := pkg.db.internal.resource.close_rows(wrapper, 2)
      return Err(failure)
    }
    validate_status := pkg.db.internal.descriptor.validate_current_row(reference, context)
    if validate_status != 0 {
      failure := context_error(context, database, query_id)
      ignored := pkg.db.internal.resource.close_rows(wrapper, 2)
      return Err(failure)
    }
    decoded := pkg.db.internal.descriptor.decode_current_row(reference, context)
    return Ok(Some(decoded))
  }
}

pub fn next_batch_prevalidated<R>(
  borrow mut rows: pkg.db.rows<R>,
  max_rows: i64,
) -> Result<Option<pkg.db.batch<R>>, pkg.db.Error> {
  unsafe {
    reference := resource.borrow(rows)
    wrapper := resource.raw(reference)
    if pkg.db.internal.resource.rows_driver(wrapper) != DRIVER_SQLITE
      || !pkg.db.internal.resource.rows_batch_header_valid(wrapper) {
      return Err(pkg.db.Error.InvalidQuery(pkg.db.ContractError {
        query_id: None,
        item: "db.rows.header".clone(),
        message: "invalid database rows resource".clone(),
      }))
    }
    id_pointer := pkg.db.internal.resource.rows_query_id_pointer(wrapper)
    id_length := pkg.db.internal.resource.rows_query_id_length(wrapper)
    plan := pkg.db.internal.resource.rows_batch_plan(wrapper)
    query_id: str := resource.view_from_raw(reference, id_pointer, id_length) else {
      return Err(pkg.db.Error.InvalidQuery(pkg.db.ContractError {
        query_id: None,
        item: "db.rows.header".clone(),
        message: "invalid database rows resource".clone(),
      }))
    }
    if plan.is_null() {
      return Err(pkg.db.Error.InvalidQuery(pkg.db.ContractError {
        query_id: None,
        item: "db.rows.header".clone(),
        message: "invalid database rows resource".clone(),
      }))
    }
    if max_rows <= 0 || max_rows > 2147483647 {
      return Err(descriptor_error(
        query_id,
        "db.batch.max_rows",
        "database batch size must be between 1 and 2147483647 rows",
      ))
    }
    terminal := pkg.db.internal.resource.rows_terminal(wrapper)
    if terminal == 1 { return Ok(None) }
    if terminal != 0 {
      return Err(invalid_query_error(
        query_id,
        "db.rows.state",
        "database rows cannot advance after a failed execution",
      ))
    }
    native := pkg.db.internal.resource.rows_native(wrapper)
    context := pkg.db.internal.resource.rows_context(wrapper)
    state := pkg.db.internal.resource.rows_connection_state(wrapper)
    database := sqlite_connection(state)
    if native.is_null() || context.is_null() || database.is_null() {
      ignored := pkg.db.internal.resource.close_rows(wrapper, 2)
      return Err(descriptor_error(
        query_id,
        "db.rows.state",
        "SQLite rows are closed or poisoned",
      ))
    }
    payload := pkg.db.internal.descriptor.create_batch(plan, max_rows)
    if payload.is_null() {
      return Err(descriptor_error(
        query_id,
        "db.batch.layout",
        "database batch layout exceeds the supported address range",
      ))
    }
    mut length := 0
    loop {
      if length >= max_rows { break }
      step_status := rows_step(native)
      if step_status == SQLITE_DONE {
        cleanup_status := pkg.db.internal.resource.close_rows(wrapper, 1)
        if cleanup_status != SQLITE_OK {
          pkg.db.internal.descriptor.drop_batch_payload(plan, payload)
          return Err(descriptor_error(
            query_id,
            "db.rows.cleanup",
            "SQLite rows cleanup failed and the connection was closed",
          ))
        }
        if length == 0 {
          pkg.db.internal.descriptor.drop_batch_payload(plan, payload)
          return Ok(None)
        }
        break
      }
      if step_status != SQLITE_ROW {
        failure := sqlite_error(database)
        pkg.db.internal.descriptor.drop_batch_payload(plan, payload)
        ignored := pkg.db.internal.resource.close_rows(wrapper, 2)
        return Err(failure)
      }
      validate_status := pkg.db.internal.descriptor.validate_current_row(reference, context)
      if validate_status != 0 {
        failure := context_error(context, database, query_id)
        pkg.db.internal.descriptor.drop_batch_payload(plan, payload)
        ignored := pkg.db.internal.resource.close_rows(wrapper, 2)
        return Err(failure)
      }
      append_status := pkg.db.internal.descriptor.append_current_batch(
        plan, payload, context, reference,
      )
      if append_status != 0 {
        pkg.db.internal.descriptor.drop_batch_payload(plan, payload)
        ignored := pkg.db.internal.resource.close_rows(wrapper, 2)
        return Err(descriptor_error(
          query_id,
          "db.batch.storage",
          "database batch variable-width storage exceeds the supported address range",
        ))
      }
      length = length + 1
    }
    pkg.db.internal.descriptor.finish_batch(plan, payload, length)
    batch_wrapper := pkg.db.internal.resource.new_batch_state(plan, payload, length, max_rows)
    output: pkg.db.batch<R> := resource.from_raw(batch_wrapper)
    return Ok(Some(output))
  }
}

pub fn has_next_prevalidated<R>(
  borrow mut rows: pkg.db.rows<R>,
) -> Result<bool, pkg.db.Error> {
  unsafe {
    reference := resource.borrow(rows)
    wrapper := resource.raw(reference)
    if pkg.db.internal.resource.rows_driver(wrapper) != DRIVER_SQLITE {
      return Err(invalid_descriptor_error())
    }
    terminal := pkg.db.internal.resource.rows_terminal(wrapper)
    if terminal == 1 { return Ok(false) }
    if terminal != 0 {
      return Err(invalid_query_error(
        "database rows",
        "db.rows.state",
        "database rows cannot advance after a failed execution",
      ))
    }
    id_pointer := pkg.db.internal.resource.rows_query_id_pointer(wrapper)
    id_length := pkg.db.internal.resource.rows_query_id_length(wrapper)
    query_id: str := resource.view_from_raw(reference, id_pointer, id_length) else {
      ignored := pkg.db.internal.resource.close_rows(wrapper, 2)
      return Err(invalid_descriptor_error())
    }
    native := pkg.db.internal.resource.rows_native(wrapper)
    state := pkg.db.internal.resource.rows_connection_state(wrapper)
    database := sqlite_connection(state)
    if native.is_null() || database.is_null() {
      ignored := pkg.db.internal.resource.close_rows(wrapper, 2)
      return Err(descriptor_error(
        query_id,
        "db.rows.state",
        "SQLite rows are closed or poisoned",
      ))
    }
    step_status := rows_step(native)
    if step_status == SQLITE_ROW { return Ok(true) }
    if step_status == SQLITE_DONE {
      cleanup_status := pkg.db.internal.resource.close_rows(wrapper, 1)
      if cleanup_status != SQLITE_OK {
        return Err(descriptor_error(
          query_id,
          "db.rows.cleanup",
          "SQLite rows cleanup failed and the connection was closed",
        ))
      }
      return Ok(false)
    }
    failure := sqlite_error(database)
    ignored := pkg.db.internal.resource.close_rows(wrapper, 2)
    return Err(failure)
  }
}

pub fn execute_prevalidated<P>(
  target: pkg.db.exec,
  params: P,
  statement: pkg.db.command<P>,
  query_id: str,
  timeout: Option<i32>,
) -> Result<pkg.db.exec_result, pkg.db.Error> {
  unsafe {
    data := pkg.db.internal.descriptor.data(statement)
    mask: u8 := raw.load(data, 5)
    if mask & 1 == 0 { return Err(driver_mismatch_error(query_id)) }

    state := state_for(target)
    if state.is_null() {
      return Err(descriptor_error(
        query_id,
        "db.exec.state",
        "SQLite execution requires an idle connection or active transaction",
      ))
    }
    state_driver: u8 := raw.load(state, 4)
    if state_driver != DRIVER_SQLITE { return Err(driver_mismatch_error(query_id)) }
    database := sqlite_connection(state)
    if database.is_null() {
      return Err(descriptor_error(
        query_id,
        "db.connection.state",
        "SQLite connection is closed or poisoned",
      ))
    }
    context := new_context(raw.null())
    static_status := pkg.db.internal.descriptor.validate_static(statement, context)
    if static_status != 0 {
      failure := if static_status == -1 {
        descriptor_error(
          query_id,
          "db.descriptor.shape",
          "static database descriptor uses a field shape unsupported by this execution milestone",
        )
      } else { context_error(context, database, query_id) }
      free_context(context)
      return Err(failure)
    }
    lease := acquire_lease(state, query_id)
    match lease {
      Err(error) => {
        free_context(context)
        return Err(error)
      }
      Ok(_) => {}
    }

    prior_timeout: i32 := raw.load(state, 16)
    mut restore_timeout := false
    match timeout {
      Some(milliseconds) => {
        restore_timeout = true
        status := execution_busy_timeout(database, milliseconds)
        if status != SQLITE_OK {
          failure := sqlite_error(database)
          cleaned := cleanup_execution(
            state, database, raw.null(), context, restore_timeout, prior_timeout,
          )
          return Err(failure)
        }
      }
      None => {}
    }

    statement_out := raw.alloc(8)
    tail_out := raw.alloc(8)
    raw.store(statement_out, 0, raw.null())
    raw.store(tail_out, 0, raw.null())
    sql := pkg.db.internal.descriptor.sqlite_sql_pointer(statement)
    prepare_status := execution_prepare(database, sql, statement_out, tail_out)
    native_statement: raw := raw.load(statement_out, 0)
    tail: raw := raw.load(tail_out, 0)
    raw.free(statement_out)
    raw.free(tail_out)
    if prepare_status != SQLITE_OK || native_statement.is_null() {
      failure := sqlite_error(database)
      cleaned := cleanup_execution(
        state, database, native_statement, context, restore_timeout, prior_timeout,
      )
      return Err(failure)
    }
    if !tail_is_empty(tail) {
      failure := invalid_query_error(
        query_id,
        "db.statement.tail",
        "static command must contain exactly one SQL statement",
      )
      cleaned := cleanup_execution(
        state, database, native_statement, context, restore_timeout, prior_timeout,
      )
      return Err(failure)
    }

    raw.store(context, 8, native_statement)
    bind_status := pkg.db.internal.descriptor.bind(statement, context, params)
    if bind_status != 0 {
      failure := context_error(context, database, query_id)
      cleaned := cleanup_execution(
        state, database, native_statement, context, restore_timeout, prior_timeout,
      )
      return Err(failure)
    }
    step_status := execution_step(native_statement)
    if step_status == SQLITE_ROW {
      failure := invalid_query_error(
        query_id,
        "db.command.row",
        "a database command must not produce rows",
      )
      cleaned := cleanup_execution(
        state, database, native_statement, context, restore_timeout, prior_timeout,
      )
      return Err(failure)
    }
    if step_status != SQLITE_DONE {
      failure := sqlite_error(database)
      cleaned := cleanup_execution(
        state, database, native_statement, context, restore_timeout, prior_timeout,
      )
      return Err(failure)
    }
    affected := execution_changes(database)
    cleanup_execution(
      state, database, native_statement, context, restore_timeout, prior_timeout,
    )?
    return Ok(pkg.db.exec_result { rows_affected: Some(affected) })
  }
}

pub fn one_prevalidated<P, R>(
  target: pkg.db.exec,
  params: P,
  statement: pkg.db.query<P, R>,
  out: region,
  query_id: str,
  timeout: Option<i32>,
) -> Result<R, pkg.db.Error> {
  unsafe {
    data := pkg.db.internal.descriptor.data(statement)
    mask: u8 := raw.load(data, 5)
    if mask & 1 == 0 { return Err(driver_mismatch_error(query_id)) }

    state := state_for(target)
    if state.is_null() {
      return Err(descriptor_error(
        query_id,
        "db.exec.state",
        "SQLite execution requires an idle connection or active transaction",
      ))
    }
    state_driver: u8 := raw.load(state, 4)
    if state_driver != DRIVER_SQLITE { return Err(driver_mismatch_error(query_id)) }
    database := sqlite_connection(state)
    if database.is_null() {
      return Err(descriptor_error(
        query_id,
        "db.connection.state",
        "SQLite connection is closed or poisoned",
      ))
    }
    context := new_context(raw.null())
    static_status := pkg.db.internal.descriptor.validate_static(statement, context)
    if static_status != 0 {
      failure := if static_status == -1 {
        descriptor_error(
          query_id,
          "db.descriptor.shape",
          "static database descriptor uses a field shape unsupported by this execution milestone",
        )
      } else { context_error(context, database, query_id) }
      free_context(context)
      return Err(failure)
    }
    lease := acquire_lease(state, query_id)
    match lease {
      Err(error) => {
        free_context(context)
        return Err(error)
      }
      Ok(_) => {}
    }

    prior_timeout: i32 := raw.load(state, 16)
    mut restore_timeout := false
    match timeout {
      Some(milliseconds) => {
        restore_timeout = true
        status := execution_busy_timeout(database, milliseconds)
        if status != SQLITE_OK {
          failure := sqlite_error(database)
          cleaned := cleanup_execution(
            state, database, raw.null(), context, restore_timeout, prior_timeout,
          )
          return Err(failure)
        }
      }
      None => {}
    }

    statement_out := raw.alloc(8)
    tail_out := raw.alloc(8)
    raw.store(statement_out, 0, raw.null())
    raw.store(tail_out, 0, raw.null())
    sql := pkg.db.internal.descriptor.sqlite_sql_pointer(statement)
    prepare_status := execution_prepare(database, sql, statement_out, tail_out)
    native_statement: raw := raw.load(statement_out, 0)
    tail: raw := raw.load(tail_out, 0)
    raw.free(statement_out)
    raw.free(tail_out)
    if prepare_status != SQLITE_OK || native_statement.is_null() {
      failure := sqlite_error(database)
      cleaned := cleanup_execution(
        state, database, native_statement, context, restore_timeout, prior_timeout,
      )
      return Err(failure)
    }
    if !tail_is_empty(tail) {
      failure := invalid_query_error(
        query_id,
        "db.statement.tail",
        "static Query must contain exactly one SQL statement",
      )
      cleaned := cleanup_execution(
        state, database, native_statement, context, restore_timeout, prior_timeout,
      )
      return Err(failure)
    }

    raw.store(context, 8, native_statement)
    bind_status := pkg.db.internal.descriptor.bind(statement, context, params)
    if bind_status != 0 {
      failure := context_error(context, database, query_id)
      cleaned := cleanup_execution(
        state, database, native_statement, context, restore_timeout, prior_timeout,
      )
      return Err(failure)
    }
    first := execution_step(native_statement)
    if first == SQLITE_DONE {
      failure := cardinality_error(1, 1, 0)
      cleaned := cleanup_execution(
        state, database, native_statement, context, restore_timeout, prior_timeout,
      )
      return Err(failure)
    }
    if first != SQLITE_ROW {
      failure := sqlite_error(database)
      cleaned := cleanup_execution(
        state, database, native_statement, context, restore_timeout, prior_timeout,
      )
      return Err(failure)
    }
    validate_status := pkg.db.internal.descriptor.validate_row(statement, context)
    if validate_status != 0 {
      failure := context_error(context, database, query_id)
      cleaned := cleanup_execution(
        state, database, native_statement, context, restore_timeout, prior_timeout,
      )
      return Err(failure)
    }
    second := execution_step(native_statement)
    if second == SQLITE_ROW {
      failure := cardinality_error(1, 1, 2)
      cleaned := cleanup_execution(
        state, database, native_statement, context, restore_timeout, prior_timeout,
      )
      return Err(failure)
    }
    if second != SQLITE_DONE {
      failure := sqlite_error(database)
      cleaned := cleanup_execution(
        state, database, native_statement, context, restore_timeout, prior_timeout,
      )
      return Err(failure)
    }
    decoded := pkg.db.internal.descriptor.decode(statement, context)
    cleanup_execution(
      state, database, native_statement, context, restore_timeout, prior_timeout,
    )?
    return Ok(decoded)
  }
}

pub fn explain_prevalidated<P, R>(
  target: pkg.db.exec,
  params: P,
  statement: pkg.db.query<P, R>,
  row_type: Option<R>,
  out: region,
  query_id: str,
  mode: u8,
) -> Result<pkg.db.QueryPlan, pkg.db.Error> {
  unsafe {
    if mode > 1 {
      return Err(descriptor_error(
        query_id,
        "sqlite.explain.mode",
        "unknown SQLite EXPLAIN mode",
      ))
    }
    data := pkg.db.internal.descriptor.data(statement)
    mask: u8 := raw.load(data, 5)
    if mask & 1 == 0 { return Err(driver_mismatch_error(query_id)) }
    state := state_for(target)
    if state.is_null() {
      return Err(descriptor_error(
        query_id,
        "db.exec.state",
        "SQLite execution requires an idle connection or active transaction",
      ))
    }
    state_driver: u8 := raw.load(state, 4)
    if state_driver != DRIVER_SQLITE { return Err(driver_mismatch_error(query_id)) }
    database := sqlite_connection(state)
    if database.is_null() {
      return Err(descriptor_error(
        query_id,
        "db.connection.state",
        "SQLite connection is closed or poisoned",
      ))
    }
    context := new_context(raw.null())
    static_status := pkg.db.internal.descriptor.validate_static(statement, context)
    if static_status != 0 {
      failure := if static_status == -1 {
        descriptor_error(
          query_id,
          "db.descriptor.shape",
          "static database descriptor uses a field shape unsupported by EXPLAIN",
        )
      } else { context_error(context, database, query_id) }
      free_context(context)
      return Err(failure)
    }
    lease := acquire_lease(state, query_id)
    match lease {
      Err(error) => {
        free_context(context)
        return Err(error)
      }
      Ok(_) => {}
    }

    prefix := if mode == 0 { "EXPLAIN QUERY PLAN " } else { "EXPLAIN " }
    sql_length: i64 := raw.load(data, 40)
    if sql_length <= 0 || sql_length > 2147483647 - prefix.len() {
      failure := invalid_query_error(
        query_id,
        "db.explain.sql",
        "SQLite EXPLAIN SQL exceeds the native length range",
      )
      cleaned := cleanup_execution(state, database, raw.null(), context, false, 0)
      return Err(failure)
    }
    source := pkg.db.internal.descriptor.sqlite_sql_pointer(statement)
    combined := raw.alloc(prefix.len() + sql_length + 1)
    prefix_bytes := prefix.bytes()
    mut i := 0
    loop {
      if i >= prefix_bytes.len() { break }
      raw.store(combined, i, prefix_bytes[i])
      i = i + 1
    }
    mut source_index := 0
    loop {
      if source_index >= sql_length { break }
      byte: u8 := raw.load(source, source_index)
      raw.store(combined, prefix.len() + source_index, byte)
      source_index = source_index + 1
    }
    terminal: u8 := 0
    raw.store(combined, prefix.len() + sql_length, terminal)
    statement_out := raw.alloc(8)
    tail_out := raw.alloc(8)
    raw.store(statement_out, 0, raw.null())
    raw.store(tail_out, 0, raw.null())
    prepare_status := execution_prepare(database, combined, statement_out, tail_out)
    native_statement: raw := raw.load(statement_out, 0)
    tail: raw := raw.load(tail_out, 0)
    raw.free(statement_out)
    raw.free(tail_out)
    if prepare_status != SQLITE_OK || native_statement.is_null() {
      raw.free(combined)
      failure := sqlite_error(database)
      cleaned := cleanup_execution(
        state, database, native_statement, context, false, 0,
      )
      return Err(failure)
    }
    if !tail_is_empty(tail) {
      raw.free(combined)
      failure := invalid_query_error(
        query_id,
        "db.statement.tail",
        "static Query must contain exactly one SQL statement",
      )
      cleaned := cleanup_execution(
        state, database, native_statement, context, false, 0,
      )
      return Err(failure)
    }
    raw.free(combined)
    raw.store(context, 8, native_statement)
    bind_status := pkg.db.internal.descriptor.bind(statement, context, params)
    if bind_status != 0 {
      failure := context_error(context, database, query_id)
      cleaned := cleanup_execution(
        state, database, native_statement, context, false, 0,
      )
      return Err(failure)
    }

    expected_columns: i32 := if mode == 0 { 4 } else { 8 }
    mut body_builder := builder()
    mut rows: i64 := 0
    loop {
      step_status := execution_step(native_statement)
      if step_status == SQLITE_DONE { break }
      if step_status != SQLITE_ROW {
        failure := sqlite_error(database)
        cleaned := cleanup_execution(
          state, database, native_statement, context, false, 0,
        )
        return Err(failure)
      }
      if execution_column_count(native_statement) != expected_columns {
        failure := pkg.db.Error.Decode(pkg.db.ContractError {
          query_id: Some(query_id.clone()),
          item: "db.explain.row".clone(),
          message: "SQLite EXPLAIN row has an invalid column count".clone(),
        })
        cleaned := cleanup_execution(
          state, database, native_statement, context, false, 0,
        )
        return Err(failure)
      }
      mut column: i32 := 0
      loop {
        if column >= expected_columns { break }
        if column > 0 { body_builder.write("|") }
        kind := execution_column_type(native_statement, column)
        if kind == SQLITE_NULL {
          body_builder.write("null")
        } else {
          if kind == SQLITE_INTEGER {
            body_builder.write_int(execution_column_i64(native_statement, column))
          } else {
            pointer := execution_column_text(native_statement, column)
            length := execution_column_bytes(native_statement, column)
            if length < 0 || (pointer.is_null() && length != 0) {
              failure := pkg.db.Error.Decode(pkg.db.ContractError {
                query_id: Some(query_id.clone()),
                item: "db.explain.row".clone(),
                message: "SQLite EXPLAIN row has an invalid text field".clone(),
              })
              cleaned := cleanup_execution(
                state, database, native_statement, context, false, 0,
              )
              return Err(failure)
            }
            mut text_buffer := buffer(length as i64)
            mut byte_index: i32 := 0
            loop {
              if byte_index >= length { break }
              byte: u8 := raw.load(pointer, byte_index as i64)
              text_buffer.put_u8(byte)
              byte_index = byte_index + 1
            }
            text := text_buffer.bytes().as_str() else {
              failure := pkg.db.Error.Decode(pkg.db.ContractError {
                query_id: Some(query_id.clone()),
                item: "db.explain.row".clone(),
                message: "SQLite EXPLAIN row is not valid UTF-8".clone(),
              })
              cleaned := cleanup_execution(
                state, database, native_statement, context, false, 0,
              )
              return Err(failure)
            }
            body_builder.write(text)
          }
        }
        column = column + 1
      }
      body_builder.write("\n")
      rows = rows + 1
    }
    if rows == 0 {
      failure := pkg.db.Error.Decode(pkg.db.ContractError {
        query_id: Some(query_id.clone()),
        item: "db.explain.row".clone(),
        message: "SQLite EXPLAIN returned no plan rows".clone(),
      })
      cleaned := cleanup_execution(
        state, database, native_statement, context, false, 0,
      )
      return Err(failure)
    }
    body := body_builder.to_string()
    cleanup_execution(state, database, native_statement, context, false, 0)?
    return Ok(pkg.db.QueryPlan {
      driver: pkg.db.Driver.SQLite,
      format: if mode == 0 { pkg.db.PlanFormat.Text } else { pkg.db.PlanFormat.Native },
      analyzed: false,
      body: body.clone_in(out),
    })
  }
}
