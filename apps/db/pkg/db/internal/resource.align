module pkg.db.internal.resource

import pkg.db.internal
import pkg.db.internal.descriptor
import pkg.db.internal.postgres_status
import std.time

extern "C" link("sqlite3") {
  fn sqlite3_close_v2(database: raw) -> i32
  fn sqlite3_get_autocommit(database: raw) -> i32
  fn sqlite3_finalize(statement: raw) -> i32
  fn sqlite3_reset(statement: raw) -> i32
  fn sqlite3_clear_bindings(statement: raw) -> i32
  fn sqlite3_busy_timeout(database: raw, milliseconds: i32) -> i32
  fn sqlite3_exec(database: raw, sql: raw, callback: raw, argument: raw, error_out: raw) -> i32
}

extern "C" link("pq") {
  fn PQfinish(connection: raw)
  fn PQclear(result: raw)
  fn PQexec(connection: raw, command: raw) -> raw
  fn PQcmdStatus(result: raw) -> raw
  fn PQsetnonblocking(connection: raw, enabled: i32) -> i32
  fn PQflush(connection: raw) -> i32
  fn PQconsumeInput(connection: raw) -> i32
  fn PQisBusy(connection: raw) -> i32
  fn PQgetResult(connection: raw) -> raw
  fn PQtransactionStatus(connection: raw) -> i32
  fn PQcancelCreate(connection: raw) -> raw
  fn PQcancelStart(cancel: raw) -> i32
  fn PQcancelPoll(cancel: raw) -> i32
  fn PQcancelSocket(cancel: raw) -> i32
  fn PQcancelErrorMessage(cancel: raw) -> raw
  fn PQcancelFinish(cancel: raw)
  fn PQsocketPoll(socket: i32, for_read: i32, for_write: i32, end_time_us: i64) -> i32
  fn PQgetCurrentTimeUSec() -> i64
}

PQTRANS_IDLE: i32 := 0
PQTRANS_INTRANS: i32 := 2
PQTRANS_INERROR: i32 := 3
PGRES_POLLING_FAILED: i32 := 0
PGRES_POLLING_READING: i32 := 1
PGRES_POLLING_WRITING: i32 := 2
PGRES_POLLING_OK: i32 := 3
POSTGRES_WAIT_SLICE_NS: i64 := 1000000
POSTGRES_DROP_RECOVERY_NS: i64 := 1000000000
CONN_VERSION: u32 := 2
POOL_VERSION: u32 := 1
POOL_OPEN: u8 := 0
POOL_CLOSING: u8 := 1
POOL_MAX_CAPACITY: i64 := 1024

// The state is private to pkg.db descendants. Its fixed Q2 prefix is:
//   0: u32 version (= 2)
//   4: u8  driver (1 = SQLite, 2 = PostgreSQL)
//   5: u8  poisoned/closed
//   6: u16 reserved (= 0)
//   8: raw native connection
//  16: i32 SQLite busy timeout in native milliseconds
//  20: u8  active execution lease
//  21: u8  active transaction owner
//  22: u16 reserved
//  24: i64 next connection-local prepared-statement ordinal
//  32: raw origin pool, null for a direct-driver connection
// The native pointer stays an actual pointer. The package never integer-casts it and the runtime
// owns neither this layout nor either database handle.
pub fn new_conn_state(driver: u8, native: raw, sqlite_busy_ms: i32) -> raw {
  unsafe {
    state := raw.alloc(40)
    version: u32 := CONN_VERSION
    clear: u8 := 0
    reserved: u16 := 0
    raw.store(state, 0, version)
    raw.store(state, 4, driver)
    raw.store(state, 5, clear)
    raw.store(state, 6, reserved)
    raw.store(state, 8, native)
    raw.store(state, 16, sqlite_busy_ms)
    raw.store(state, 20, clear)
    raw.store(state, 21, clear)
    raw.store(state, 22, reserved)
    next_statement: i64 := 0
    raw.store(state, 24, next_statement)
    raw.store(state, 32, raw.null())
    return state
  }
}

// Authenticate the complete scalar connection image in one authority. Native and origin pointers
// remain privileged producer values, but every public/internal consumer reaches those pointers only
// after the version, driver, reserved, state-product, and ordinal fields agree.
pub fn conn_state_valid(state: raw) -> bool {
  unsafe {
    if state.is_null() { return false }
    version: u32 := raw.load(state, 0)
    driver: u8 := raw.load(state, 4)
    closed: u8 := raw.load(state, 5)
    reserved: u16 := raw.load(state, 6)
    native: raw := raw.load(state, 8)
    busy_ms: i32 := raw.load(state, 16)
    lease: u8 := raw.load(state, 20)
    transaction: u8 := raw.load(state, 21)
    tail_reserved: u16 := raw.load(state, 22)
    next_statement: i64 := raw.load(state, 24)
    if version != CONN_VERSION || (driver != 1 && driver != 2) || reserved != 0
      || busy_ms < 0 || (driver == 2 && busy_ms != 0) || lease > 1 || transaction > 1
      || tail_reserved != 0 || next_statement < 0 {
      return false
    }
    if closed == 0 { return !native.is_null() }
    return closed == 1 && native.is_null() && lease == 0 && transaction == 0
  }
}

pub fn conn_driver_tag(state: raw) -> u8 {
  unsafe {
    if !conn_state_valid(state) { return 0 }
    return raw.load(state, 4)
  }
}

pub fn conn_live(state: raw) -> bool {
  unsafe {
    if !conn_state_valid(state) { return false }
    closed: u8 := raw.load(state, 5)
    return closed == 0
  }
}

pub fn conn_live_for_driver(state: raw, driver: u8) -> bool =
  conn_live(state) && conn_driver_tag(state) == driver

fn c_string(value: str) -> raw {
  unsafe {
    bytes := value.bytes()
    output := raw.alloc(bytes.len() + 1)
    mut i := 0
    loop {
      if i >= bytes.len() { break }
      raw.store(output, i, bytes[i])
      i = i + 1
    }
    raw.store(output, bytes.len(), 0 as u8)
    return output
  }
}

fn c_string_equals(pointer: raw, expected: str) -> bool {
  unsafe {
    if pointer.is_null() { return false }
    bytes := expected.bytes()
    mut i := 0
    loop {
      if i >= bytes.len() { break }
      actual: u8 := raw.load(pointer, i)
      if actual != bytes[i] { return false }
      i = i + 1
    }
    terminal: u8 := raw.load(pointer, bytes.len())
    return terminal == 0
  }
}

// Roll back one active transaction and return whether the native effect is proved exactly. The
// wrapper transaction flag is always cleared before the caller decides between pool return and
// close/retirement.
fn rollback_state(state: raw) -> bool {
  unsafe {
    if !conn_live(state) { return false }
    driver: u8 := raw.load(state, 4)
    active: u8 := raw.load(state, 21)
    native: raw := raw.load(state, 8)
    if active == 0 { return false }
    sql := c_string("ROLLBACK")
    mut proved := false
    if driver == 1 {
      status := sqlite3_exec(native, sql, raw.null(), raw.null(), raw.null())
      proved = status == 0 && sqlite3_get_autocommit(native) != 0
    } else {
      if driver == 2 {
        result := PQexec(native, sql)
        if result.is_null() {
          poison_conn_state(state)
        } else {
          status := pkg.db.internal.postgres_status.code(result)
          command_ok := status == 1 && c_string_equals(PQcmdStatus(result), "ROLLBACK")
          PQclear(result)
          proved = command_ok && PQtransactionStatus(native) == PQTRANS_IDLE
          if !proved {
            poison_conn_state(state)
          }
        }
      }
    }
    raw.free(sql)
    raw.store(state, 21, 0 as u8)
    if !proved && conn_live(state) { poison_conn_state(state) }
    return proved
  }
}

fn drop_state(state: raw) {
  unsafe {
    if state.is_null() { return }
    version: u32 := raw.load(state, 0)
    // A malformed private state is still freed, but never dispatched through an untrusted tag.
    // Both native destructors are null-guarded here so partial construction has one cleanup edge.
    if version == CONN_VERSION {
      driver: u8 := raw.load(state, 4)
      closed: u8 := raw.load(state, 5)
      native: raw := raw.load(state, 8)
      if closed == 0 && !native.is_null() {
        if driver == 1 {
          ignored := sqlite3_close_v2(native)
        } else {
          if driver == 2 { PQfinish(native) }
        }
      }
    }
    raw.free(state)
  }
}

pub fn drop_conn(state: raw) {
  unsafe { release_conn_state(state) }
}

pub fn drop_tx(state: raw) {
  unsafe {
    origin: raw := if conn_state_valid(state) { raw.load(state, 32) } else { raw.null() }
    proved := rollback_state(state)
    if !origin.is_null() && proved {
      release_conn_state(state)
    } else {
      if !origin.is_null() { retire_conn_state(state, origin) } else { drop_state(state) }
    }
  }
}

pub fn transaction_active(state: raw) -> bool {
  unsafe {
    if !conn_live(state) { return false }
    active: u8 := raw.load(state, 21)
    return active != 0
  }
}

pub fn set_transaction_active(state: raw, active: bool) {
  unsafe {
    if !conn_live(state) { return }
    raw.store(state, 21, if active { 1 as u8 } else { 0 as u8 })
  }
}

pub fn next_statement_ordinal(state: raw) -> i64 {
  unsafe {
    if !conn_live(state) { return -1 }
    current: i64 := raw.load(state, 24)
    if current < 0 || current == 9223372036854775807 { return -1 }
    raw.store(state, 24, current + 1)
    return current
  }
}

pub fn poison_conn_state(state: raw) {
  unsafe {
    if state.is_null() { return }
    if !conn_state_valid(state) { return }
    driver: u8 := raw.load(state, 4)
    closed: u8 := raw.load(state, 5)
    native: raw := raw.load(state, 8)
    if closed != 0 || native.is_null() { return }
    raw.store(state, 5, 1 as u8)
    raw.store(state, 8, raw.null())
    raw.store(state, 20, 0 as u8)
    raw.store(state, 21, 0 as u8)
    if driver == 1 {
      ignored := sqlite3_close_v2(native)
    } else {
      if driver == 2 { PQfinish(native) }
    }
  }
}

// The private fixed-capacity pool image is:
//   0: u32 version (= 1)
//   4: u8  driver (1 = SQLite, 2 = PostgreSQL)
//   5: u8  lifecycle (0 = open, 1 = closing)
//   6: u16 reserved (= 0)
//   8: i64 capacity
//  16: i64 idle
//  24: i64 checked out
//  32: raw pointer to exactly capacity pointer cells
//  40: u64 reserved (= 0)
fn pool_scalar_valid(pool: raw) -> bool {
  unsafe {
    if pool.is_null() { return false }
    version: u32 := raw.load(pool, 0)
    driver: u8 := raw.load(pool, 4)
    lifecycle: u8 := raw.load(pool, 5)
    reserved: u16 := raw.load(pool, 6)
    capacity: i64 := raw.load(pool, 8)
    idle: i64 := raw.load(pool, 16)
    checked_out: i64 := raw.load(pool, 24)
    slots: raw := raw.load(pool, 32)
    tail_reserved: u64 := raw.load(pool, 40)
    return version == POOL_VERSION && (driver == 1 || driver == 2)
      && (lifecycle == POOL_OPEN || lifecycle == POOL_CLOSING) && reserved == 0
      && capacity >= 1 && capacity <= POOL_MAX_CAPACITY && idle >= 0 && checked_out >= 0
      && idle <= capacity && checked_out <= capacity - idle && !slots.is_null()
      && tail_reserved == 0
  }
}

pub fn pool_state_valid(pool: raw) -> bool {
  unsafe {
    if !pool_scalar_valid(pool) { return false }
    driver: u8 := raw.load(pool, 4)
    capacity: i64 := raw.load(pool, 8)
    idle: i64 := raw.load(pool, 16)
    slots: raw := raw.load(pool, 32)
    mut i: i64 := 0
    loop {
      if i >= capacity { break }
      state: raw := raw.load(slots, i * 8)
      if i < idle {
        if !conn_live_for_driver(state, driver) { return false }
        lease: u8 := raw.load(state, 20)
        transaction: u8 := raw.load(state, 21)
        origin: raw := raw.load(state, 32)
        if lease != 0 || transaction != 0 || origin.is_null() { return false }
      } else {
        if !state.is_null() { return false }
      }
      i = i + 1
    }
    return true
  }
}

pub fn pool_open_valid(pool: raw) -> bool {
  unsafe {
    if !pool_state_valid(pool) { return false }
    lifecycle: u8 := raw.load(pool, 5)
    return lifecycle == POOL_OPEN
  }
}

pub fn new_pool_state(driver: u8, capacity: i64) -> raw {
  unsafe {
    if (driver != 1 && driver != 2) || capacity < 1 || capacity > POOL_MAX_CAPACITY {
      return raw.null()
    }
    slots := raw.alloc(capacity * 8)
    mut i: i64 := 0
    loop {
      if i >= capacity { break }
      raw.store(slots, i * 8, raw.null())
      i = i + 1
    }
    pool := raw.alloc(48)
    raw.store(pool, 0, POOL_VERSION)
    raw.store(pool, 4, driver)
    raw.store(pool, 5, POOL_OPEN)
    raw.store(pool, 6, 0 as u16)
    raw.store(pool, 8, capacity)
    raw.store(pool, 16, 0 as i64)
    raw.store(pool, 24, 0 as i64)
    raw.store(pool, 32, slots)
    raw.store(pool, 40, 0 as u64)
    return pool
  }
}

// Attach one newly opened, unpublished direct connection. Constructors call this in increasing
// physical ordinal, so the ordinary LIFO pop yields the highest successful ordinal first and Pool
// Drop closes a partial construction in reverse order.
pub fn pool_attach_initial(pool: raw, state: raw) -> bool {
  unsafe {
    if !pool_open_valid(pool) || !conn_live(state) { return false }
    driver: u8 := raw.load(pool, 4)
    if conn_driver_tag(state) != driver { return false }
    origin: raw := raw.load(state, 32)
    if !origin.is_null() { return false }
    idle: i64 := raw.load(pool, 16)
    capacity: i64 := raw.load(pool, 8)
    if idle >= capacity { return false }
    slots: raw := raw.load(pool, 32)
    raw.store(state, 32, pool)
    raw.store(slots, idle * 8, state)
    raw.store(pool, 16, idle + 1)
    return true
  }
}

pub fn pool_try_acquire(pool: raw) -> raw {
  unsafe {
    if !pool_open_valid(pool) { return raw.null() }
    idle: i64 := raw.load(pool, 16)
    if idle == 0 { return raw.null() }
    checked_out: i64 := raw.load(pool, 24)
    slots: raw := raw.load(pool, 32)
    index := idle - 1
    state: raw := raw.load(slots, index * 8)
    raw.store(slots, index * 8, raw.null())
    raw.store(pool, 16, index)
    raw.store(pool, 24, checked_out + 1)
    return state
  }
}

pub fn pool_driver(pool: raw) -> u8 {
  unsafe { return if pool_open_valid(pool) { raw.load(pool, 4) } else { 0 as u8 } }
}

pub fn pool_capacity(pool: raw) -> i64 {
  unsafe { return if pool_open_valid(pool) { raw.load(pool, 8) } else { -1 } }
}

pub fn pool_idle(pool: raw) -> i64 {
  unsafe { return if pool_open_valid(pool) { raw.load(pool, 16) } else { -1 } }
}

pub fn pool_checked_out(pool: raw) -> i64 {
  unsafe { return if pool_open_valid(pool) { raw.load(pool, 24) } else { -1 } }
}

fn conn_native_idle(state: raw) -> bool {
  unsafe {
    if !conn_live(state) { return false }
    lease: u8 := raw.load(state, 20)
    transaction: u8 := raw.load(state, 21)
    if lease != 0 || transaction != 0 { return false }
    driver: u8 := raw.load(state, 4)
    native: raw := raw.load(state, 8)
    if driver == 1 { return sqlite3_get_autocommit(native) != 0 }
    return driver == 2 && PQtransactionStatus(native) == PQTRANS_IDLE
  }
}

fn free_pool_bookkeeping(pool: raw) {
  unsafe {
    slots: raw := raw.load(pool, 32)
    raw.store(pool, 32, raw.null())
    if !slots.is_null() { raw.free(slots) }
    raw.free(pool)
  }
}

fn retire_conn_state(state: raw, pool: raw) {
  unsafe {
    mut free_pool := false
    if pool_scalar_valid(pool) {
      checked_out: i64 := raw.load(pool, 24)
      lifecycle: u8 := raw.load(pool, 5)
      if checked_out > 0 {
        raw.store(pool, 24, checked_out - 1)
        free_pool = lifecycle == POOL_CLOSING && checked_out == 1
      }
    }
    if conn_state_valid(state) { raw.store(state, 32, raw.null()) }
    drop_state(state)
    if free_pool { free_pool_bookkeeping(pool) }
  }
}

fn release_conn_state(state: raw) {
  unsafe {
    if !conn_state_valid(state) {
      drop_state(state)
      return
    }
    pool: raw := raw.load(state, 32)
    if pool.is_null() {
      drop_state(state)
      return
    }
    if !pool_state_valid(pool) {
      drop_state(state)
      return
    }
    lifecycle: u8 := raw.load(pool, 5)
    if lifecycle == POOL_CLOSING {
      retire_conn_state(state, pool)
      return
    }
    checked_out: i64 := raw.load(pool, 24)
    idle: i64 := raw.load(pool, 16)
    capacity: i64 := raw.load(pool, 8)
    if checked_out <= 0 || idle >= capacity || !conn_native_idle(state) {
      if conn_live(state) { poison_conn_state(state) }
      retire_conn_state(state, pool)
      return
    }
    slots: raw := raw.load(pool, 32)
    slot: raw := raw.load(slots, idle * 8)
    if !slot.is_null() {
      poison_conn_state(state)
      retire_conn_state(state, pool)
      return
    }
    raw.store(slots, idle * 8, state)
    raw.store(pool, 16, idle + 1)
    raw.store(pool, 24, checked_out - 1)
  }
}

pub fn drop_pool_state(pool: raw) {
  unsafe {
    if !pool_open_valid(pool) {
      if !pool.is_null() { raw.free(pool) }
      return
    }
    raw.store(pool, 5, POOL_CLOSING)
    mut idle: i64 := raw.load(pool, 16)
    slots: raw := raw.load(pool, 32)
    loop {
      if idle == 0 { break }
      idle = idle - 1
      state: raw := raw.load(slots, idle * 8)
      raw.store(slots, idle * 8, raw.null())
      raw.store(pool, 16, idle)
      if conn_state_valid(state) { raw.store(state, 32, raw.null()) }
      drop_state(state)
    }
    checked_out: i64 := raw.load(pool, 24)
    if checked_out == 0 { free_pool_bookkeeping(pool) }
  }
}

// A prepared statement wrapper is dependent on the conn/tx resource generation that created it.
//   0: u32 version (= 4)
//   4: u8  driver
//   5: u8  closed
//   6: u16 reserved
//   8: raw sqlite3_stmt / PostgreSQL prepared-name C string
//  16: raw connection state
//  24: raw generated Params binder
//  32: raw owned Query-ID bytes with a trailing NUL
//  40: i64 Query-ID byte length
//  48: raw PostgreSQL DEALLOCATE command C string, null for SQLite
//  56: raw generated Row validator
//  64: raw generated streaming Row decoder
//  72: raw generated batch plan
//  80: raw generated parameter-name resolver
//  88: raw PostgreSQL byte-per-parameter Binary eligibility vector, null for SQLite/zero count
//  96: raw producer-owned parameter-count thunk
// 104: u32 trusted parameter count
// 108: u32 reserved
pub fn new_stmt_state(
  driver: u8,
  native: raw,
  connection_state: raw,
  binder: raw,
  query_id: raw,
  query_id_len: i64,
  deallocate_sql: raw,
  row_validator: raw,
  stream_decoder: raw,
  batch_plan: raw,
  parameter_resolver: raw,
  binary_eligibility: raw,
  parameter_count_thunk: raw,
  parameter_count: u32,
) -> raw {
  unsafe {
    statement := raw.alloc(112)
    raw.store(statement, 0, 4 as u32)
    raw.store(statement, 4, driver)
    raw.store(statement, 5, 0 as u8)
    raw.store(statement, 6, 0 as u16)
    raw.store(statement, 8, native)
    raw.store(statement, 16, connection_state)
    raw.store(statement, 24, binder)
    raw.store(statement, 32, query_id)
    raw.store(statement, 40, query_id_len)
    raw.store(statement, 48, deallocate_sql)
    raw.store(statement, 56, row_validator)
    raw.store(statement, 64, stream_decoder)
    raw.store(statement, 72, batch_plan)
    raw.store(statement, 80, parameter_resolver)
    raw.store(statement, 88, binary_eligibility)
    raw.store(statement, 96, parameter_count_thunk)
    raw.store(statement, 104, parameter_count)
    raw.store(statement, 108, 0 as u32)
    return statement
  }
}

// Establish every fixed v4 field needed to invoke the retained count thunk, but do not scan the
// eligibility vector until the thunk has authenticated its bound.
pub fn stmt_header_shape_valid(statement: raw) -> bool {
  unsafe {
    if statement.is_null() { return false }
    version: u32 := raw.load(statement, 0)
    if version != 4 { return false }
    driver: u8 := raw.load(statement, 4)
    closed: u8 := raw.load(statement, 5)
    reserved: u16 := raw.load(statement, 6)
    if (driver != 1 && driver != 2) || closed != 0 || reserved != 0 { return false }
    native: raw := raw.load(statement, 8)
    connection_state: raw := raw.load(statement, 16)
    binder: raw := raw.load(statement, 24)
    query_id: raw := raw.load(statement, 32)
    query_id_len: i64 := raw.load(statement, 40)
    deallocate_sql: raw := raw.load(statement, 48)
    row_validator: raw := raw.load(statement, 56)
    stream_decoder: raw := raw.load(statement, 64)
    batch_plan: raw := raw.load(statement, 72)
    parameter_resolver: raw := raw.load(statement, 80)
    binary_eligibility: raw := raw.load(statement, 88)
    parameter_count_thunk: raw := raw.load(statement, 96)
    parameter_count: u32 := raw.load(statement, 104)
    tail_reserved: u32 := raw.load(statement, 108)
    if native.is_null() || connection_state.is_null() || binder.is_null()
      || query_id.is_null() || query_id_len <= 0 || row_validator.is_null()
      || stream_decoder.is_null() || !batch_plan_valid(batch_plan)
      || parameter_resolver.is_null() || parameter_count_thunk.is_null()
      || parameter_count > 65535 || tail_reserved != 0 {
      return false
    }
    if driver == 1 { return deallocate_sql.is_null() && binary_eligibility.is_null() }
    if deallocate_sql.is_null() { return false }
    return if parameter_count == 0 {
      binary_eligibility.is_null()
    } else { !binary_eligibility.is_null() }
  }
}

// The one complete statement-v4 validator. Every accessor, indirect prepared bridge, and execution
// path enters through this authority so the resolver, count thunk, eligibility vector, and existing
// statement fields cannot drift across an ABI bump. Cleanup first tries this complete validation,
// then falls back to the fixed shape so a malformed eligibility byte or count result cannot strand
// otherwise authenticated direct owners; that fallback invokes no callback and performs no scan.
pub fn stmt_header_valid(statement: raw) -> bool {
  unsafe {
    if !stmt_header_shape_valid(statement) { return false }
    parameter_count: u32 := raw.load(statement, 104)
    trusted_count := pkg.db.internal.descriptor.prepared_parameter_count(statement)
    if trusted_count > 65535 || trusted_count != parameter_count { return false }
    driver: u8 := raw.load(statement, 4)
    if driver == 1 || parameter_count == 0 { return true }
    binary_eligibility: raw := raw.load(statement, 88)
    mut i: u32 := 0
    loop {
      if i >= parameter_count { break }
      eligible: u8 := raw.load(binary_eligibility, i as i64)
      if eligible > 1 { return false }
      i = i + 1
    }
    return true
  }
}

pub fn stmt_driver(statement: raw) -> u8 {
  unsafe {
    if !stmt_header_valid(statement) { return 0 }
    return raw.load(statement, 4)
  }
}

pub fn stmt_native(statement: raw) -> raw {
  unsafe {
    if stmt_driver(statement) == 0 { return raw.null() }
    return raw.load(statement, 8)
  }
}

pub fn stmt_connection_state(statement: raw) -> raw {
  unsafe {
    if stmt_driver(statement) == 0 { return raw.null() }
    return raw.load(statement, 16)
  }
}

pub fn stmt_query_id_pointer(statement: raw) -> raw {
  unsafe {
    if stmt_driver(statement) == 0 { return raw.null() }
    return raw.load(statement, 32)
  }
}

pub fn stmt_query_id_length(statement: raw) -> i64 {
  unsafe {
    if stmt_driver(statement) == 0 { return -1 }
    return raw.load(statement, 40)
  }
}

pub fn stmt_row_validator(statement: raw) -> raw {
  unsafe {
    if stmt_driver(statement) == 0 { return raw.null() }
    return raw.load(statement, 56)
  }
}

pub fn stmt_stream_decoder(statement: raw) -> raw {
  unsafe {
    if stmt_driver(statement) == 0 { return raw.null() }
    return raw.load(statement, 64)
  }
}

pub fn stmt_batch_plan(statement: raw) -> raw {
  unsafe {
    if stmt_driver(statement) == 0 { return raw.null() }
    return raw.load(statement, 72)
  }
}

pub fn stmt_parameter_resolver(statement: raw) -> raw {
  unsafe {
    if stmt_driver(statement) == 0 { return raw.null() }
    return raw.load(statement, 80)
  }
}

pub fn stmt_parameter_count(statement: raw) -> u32 {
  unsafe {
    if stmt_driver(statement) == 0 { return 0 }
    return raw.load(statement, 104)
  }
}

pub fn stmt_binary_ordinal(statement: raw, resolver_ordinal: i32) -> i32 {
  unsafe {
    if !stmt_header_valid(statement) || resolver_ordinal >= 0
      || resolver_ordinal == -2147483648 { return 0 }
    ordinal := -resolver_ordinal
    count: u32 := raw.load(statement, 104)
    if ordinal <= 0 || (ordinal as u32) > count { return 0 }
    eligibility: raw := raw.load(statement, 88)
    if eligibility.is_null() { return 0 }
    value: u8 := raw.load(eligibility, (ordinal as i64) - 1)
    return if value == 1 { ordinal } else { 0 }
  }
}

pub fn close_stmt(statement: raw) -> i32 {
  unsafe {
    complete := stmt_header_valid(statement)
    if !complete && !stmt_header_shape_valid(statement) { return 0 }
    driver: u8 := raw.load(statement, 4)
    native: raw := raw.load(statement, 8)
    connection_state: raw := raw.load(statement, 16)
    query_id: raw := raw.load(statement, 32)
    deallocate_sql: raw := raw.load(statement, 48)
    binary_eligibility: raw := raw.load(statement, 88)
    // Publish the closed state and null every owned/borrowed pointer before invoking native or raw
    // destructors. Re-entry can therefore neither reuse the resolver nor free an owner twice.
    raw.store(statement, 5, 1 as u8)
    raw.store(statement, 8, raw.null())
    raw.store(statement, 16, raw.null())
    raw.store(statement, 24, raw.null())
    raw.store(statement, 32, raw.null())
    raw.store(statement, 40, 0 as i64)
    raw.store(statement, 48, raw.null())
    raw.store(statement, 56, raw.null())
    raw.store(statement, 64, raw.null())
    raw.store(statement, 72, raw.null())
    raw.store(statement, 80, raw.null())
    raw.store(statement, 88, raw.null())
    raw.store(statement, 96, raw.null())
    raw.store(statement, 104, 0 as u32)
    raw.store(statement, 108, 0 as u32)
    mut status: i32 := 0
    if driver == 1 {
      if !native.is_null() { status = sqlite3_finalize(native) }
      if status != 0 { poison_conn_state(connection_state) }
    } else {
      if driver == 2 && !connection_state.is_null() {
        closed: u8 := raw.load(connection_state, 5)
        active: u8 := raw.load(connection_state, 20)
        connection: raw := raw.load(connection_state, 8)
        // Drop cannot report a lease conflict.  If another rows resource owns the connection,
        // leave the server-side statement to connection teardown instead of overlapping libpq.
        if closed == 0 && active == 0 && !connection.is_null() && !deallocate_sql.is_null() {
          result := PQexec(connection, deallocate_sql)
          if result.is_null() {
            poison_conn_state(connection_state)
          } else {
            result_status := pkg.db.internal.postgres_status.code(result)
            PQclear(result)
            if pkg.db.internal.postgres_status.must_close(result_status) {
              poison_conn_state(connection_state)
            }
          }
        }
      }
      if !native.is_null() { raw.free(native) }
    }
    if !query_id.is_null() { raw.free(query_id) }
    if !deallocate_sql.is_null() { raw.free(deallocate_sql) }
    if !binary_eligibility.is_null() { raw.free(binary_eligibility) }
    return status
  }
}

pub fn drop_stmt(statement: raw) {
  unsafe {
    if statement.is_null() { return }
    ignored := close_stmt(statement)
    raw.free(statement)
  }
}

fn free_bind_context(driver: u8, context: raw) {
  unsafe {
    if context.is_null() { return }
    if !pkg.db.internal.context_valid_v4(context, driver) {
      raw.free(context)
      return
    }
    pkg.db.internal.release_row_cache_v2(context)
    if driver == 1 {
      values: raw := raw.load(context, 40)
      count: u32 := raw.load(context, 48)
      if !values.is_null() {
        mut i: u32 := 0
        loop {
          if i >= count { break }
          value: raw := raw.load(values, (i as i64) * 8)
          if !value.is_null() { raw.free(value) }
          i = i + 1
        }
        raw.free(values)
      }
    } else {
      if driver == 2 {
        values: raw := raw.load(context, 40)
        types: raw := raw.load(context, 48)
        lengths: raw := raw.load(context, 56)
        formats: raw := raw.load(context, 64)
        count: u32 := raw.load(context, 72)
        if !values.is_null() {
          mut i: u32 := 0
          loop {
            if i >= count { break }
            value: raw := raw.load(values, (i as i64) * 8)
            if !value.is_null() { raw.free(value) }
            i = i + 1
          }
          raw.free(values)
        }
        if !types.is_null() { raw.free(types) }
        if !lengths.is_null() { raw.free(lengths) }
        if !formats.is_null() { raw.free(formats) }
      }
    }
    raw.free(context)
  }
}

// One streamed execution. SQLite borrows a prepared stmt handle or owns a direct stmt;
// PostgreSQL owns either one buffered PGresult or one in-progress libpq result sequence. A
// prepared stream remains dependent on the statement generation; a direct stream is dependent on
// the conn/tx generation.
//   0: u32 version (= 4), 4: driver, 5: terminal (0 active, 1 exhausted, 2 failed), 6: reserved
//   8: sqlite3_stmt / PGresult
//  16: prepared stmt wrapper, null for direct execution
//  24: bind/decode context
//  32: conn state
//  40: generated Row validator
//  48: generated streaming Row decoder
//  56: Query-ID bytes (borrowed from stmt or owned by this wrapper)
//  64: i64 Query-ID byte length
//  72: u8 Query-ID ownership (0 borrowed, 1 owned)
//  73: u8 SQLite statement ownership (0 prepared, 1 direct)
//  74: u16 reserved
//  76: i32 saved SQLite busy timeout in native milliseconds
//  80: u8 restore saved SQLite busy timeout (0 no, 1 yes)
//  81: u8[7] reserved
//  88: raw generated batch plan
//  96: u8 delivery (0 PG buffered, 1 PG single row, 2 PG portal batch, 3 SQLite step)
//  97: u8 PostgreSQL protocol pending (0 no, 1 yes)
//  98: u16 reserved
// 100: i32 PostgreSQL portal maximum rows (positive only for delivery 2)
// 104: i64 absolute monotonic deadline (-1 when absent)
// 112: i64 original timeout duration (-1 when absent)
pub fn new_rows_state(
  driver: u8,
  native: raw,
  statement: raw,
  context: raw,
  connection_state: raw,
  row_validator: raw,
  stream_decoder: raw,
  query_id: raw,
  query_id_len: i64,
  owns_query_id: bool,
  owns_statement: bool,
  restore_timeout: bool,
  prior_timeout: i32,
  batch_plan: raw,
  delivery: u8,
  protocol_pending: bool,
  portal_max_rows: i32,
  deadline_ns: i64,
  timeout_duration_ns: i64,
) -> raw {
  unsafe {
    rows := raw.alloc(120)
    raw.store(rows, 0, 4 as u32)
    raw.store(rows, 4, driver)
    raw.store(rows, 5, 0 as u8)
    raw.store(rows, 6, 0 as u16)
    raw.store(rows, 8, native)
    raw.store(rows, 16, statement)
    raw.store(rows, 24, context)
    raw.store(rows, 32, connection_state)
    raw.store(rows, 40, row_validator)
    raw.store(rows, 48, stream_decoder)
    raw.store(rows, 56, query_id)
    raw.store(rows, 64, query_id_len)
    raw.store(rows, 72, if owns_query_id { 1 as u8 } else { 0 as u8 })
    raw.store(rows, 73, if owns_statement { 1 as u8 } else { 0 as u8 })
    raw.store(rows, 74, 0 as u16)
    raw.store(rows, 76, prior_timeout)
    raw.store(rows, 80, if restore_timeout { 1 as u8 } else { 0 as u8 })
    raw.store(rows, 81, 0 as u8)
    raw.store(rows, 82, 0 as u16)
    raw.store(rows, 84, 0 as u32)
    raw.store(rows, 88, batch_plan)
    raw.store(rows, 96, delivery)
    raw.store(rows, 97, if protocol_pending { 1 as u8 } else { 0 as u8 })
    raw.store(rows, 98, 0 as u16)
    raw.store(rows, 100, portal_max_rows)
    raw.store(rows, 104, deadline_ns)
    raw.store(rows, 112, timeout_duration_ns)
    return rows
  }
}

// The one complete rows-v4 validator. All accessors and cleanup enter through this authority so a
// later ABI bump cannot leave a sibling validator accepting an older or partially checked record.
pub fn rows_header_valid(rows: raw) -> bool {
  unsafe {
    if rows.is_null() { return false }
    version: u32 := raw.load(rows, 0)
    driver: u8 := raw.load(rows, 4)
    terminal: u8 := raw.load(rows, 5)
    reserved: u16 := raw.load(rows, 6)
    native: raw := raw.load(rows, 8)
    statement: raw := raw.load(rows, 16)
    context: raw := raw.load(rows, 24)
    connection_state: raw := raw.load(rows, 32)
    row_validator: raw := raw.load(rows, 40)
    stream_decoder: raw := raw.load(rows, 48)
    query_id: raw := raw.load(rows, 56)
    query_id_len: i64 := raw.load(rows, 64)
    owns_query_id: u8 := raw.load(rows, 72)
    owns_statement: u8 := raw.load(rows, 73)
    tail_reserved: u16 := raw.load(rows, 74)
    prior_timeout: i32 := raw.load(rows, 76)
    restore_timeout: u8 := raw.load(rows, 80)
    timeout_reserved: u8 := raw.load(rows, 81)
    timeout_reserved16: u16 := raw.load(rows, 82)
    timeout_reserved32: u32 := raw.load(rows, 84)
    batch_plan: raw := raw.load(rows, 88)
    delivery: u8 := raw.load(rows, 96)
    protocol_pending: u8 := raw.load(rows, 97)
    delivery_reserved: u16 := raw.load(rows, 98)
    portal_max_rows: i32 := raw.load(rows, 100)
    deadline_ns: i64 := raw.load(rows, 104)
    timeout_duration_ns: i64 := raw.load(rows, 112)
    if version != 4 || (driver != 1 && driver != 2) || terminal > 2 || reserved != 0
      || owns_query_id > 1 || owns_statement > 1 || tail_reserved != 0 || restore_timeout > 1
      || timeout_reserved != 0 || timeout_reserved16 != 0 || timeout_reserved32 != 0
      || delivery > 3 || protocol_pending > 1 || delivery_reserved != 0
      || query_id.is_null() || query_id_len <= 0 || !batch_plan_valid(batch_plan) {
      return false
    }
    if terminal != 0 {
      return native.is_null() && statement.is_null() && context.is_null()
        && connection_state.is_null() && row_validator.is_null() && stream_decoder.is_null()
        && owns_statement == 0 && restore_timeout == 0 && delivery == 0
        && protocol_pending == 0 && portal_max_rows == 0 && deadline_ns == -1
        && timeout_duration_ns == -1 && prior_timeout == 0
    }
    if native.is_null() && driver == 1 { return false }
    if context.is_null() || connection_state.is_null() || row_validator.is_null()
      || stream_decoder.is_null() {
      return false
    }
    context_native_bits: u64 := raw.load(context, 8)
    native_bits: u64 := raw.load(rows, 8)
    if context_native_bits != native_bits { return false }
    if driver == 1 {
      if prior_timeout < 0 { return false }
      prepared_shape := if owns_statement == 0 {
        !statement.is_null() && owns_query_id == 0
      } else { statement.is_null() && owns_query_id == 1 }
      return delivery == 3 && protocol_pending == 0 && portal_max_rows == 0
        && deadline_ns == -1 && timeout_duration_ns == -1 && prepared_shape
    }
    if owns_statement != 0 || restore_timeout != 0 || prior_timeout != 0 { return false }
    prepared_shape := if statement.is_null() { owns_query_id == 1 } else { owns_query_id == 0 }
    if !prepared_shape { return false }
    if delivery == 0 {
      return !native.is_null() && protocol_pending == 0 && portal_max_rows == 0
        && deadline_ns == -1 && timeout_duration_ns == -1
    }
    if delivery != 1 && delivery != 2 { return false }
    if protocol_pending == 0 { return false }
    if delivery == 1 && portal_max_rows != 0 { return false }
    if delivery == 2 && portal_max_rows <= 0 { return false }
    return (deadline_ns == -1 && timeout_duration_ns == -1)
      || (deadline_ns >= 0 && timeout_duration_ns > 0)
  }
}

pub fn rows_driver(rows: raw) -> u8 {
  unsafe {
    if !rows_header_valid(rows) { return 0 }
    return raw.load(rows, 4)
  }
}

pub fn rows_terminal(rows: raw) -> u8 {
  unsafe {
    if rows_driver(rows) == 0 { return 2 }
    return raw.load(rows, 5)
  }
}

pub fn rows_native(rows: raw) -> raw {
  unsafe {
    if rows_driver(rows) == 0 { return raw.null() }
    return raw.load(rows, 8)
  }
}

pub fn rows_context(rows: raw) -> raw {
  unsafe {
    if rows_driver(rows) == 0 { return raw.null() }
    return raw.load(rows, 24)
  }
}

pub fn rows_connection_state(rows: raw) -> raw {
  unsafe {
    if rows_driver(rows) == 0 { return raw.null() }
    return raw.load(rows, 32)
  }
}

pub fn rows_query_id_pointer(rows: raw) -> raw {
  unsafe {
    if rows_driver(rows) == 0 { return raw.null() }
    return raw.load(rows, 56)
  }
}

pub fn rows_query_id_length(rows: raw) -> i64 {
  unsafe {
    if rows_driver(rows) == 0 { return -1 }
    return raw.load(rows, 64)
  }
}

pub fn rows_batch_plan(rows: raw) -> raw {
  unsafe {
    if rows_driver(rows) == 0 { return raw.null() }
    return raw.load(rows, 88)
  }
}

pub fn rows_delivery(rows: raw) -> u8 {
  unsafe {
    if !rows_header_valid(rows) { return 255 }
    return raw.load(rows, 96)
  }
}

pub fn rows_protocol_pending(rows: raw) -> bool {
  unsafe {
    if !rows_header_valid(rows) { return false }
    pending: u8 := raw.load(rows, 97)
    return pending != 0
  }
}

pub fn rows_portal_max_rows(rows: raw) -> i32 {
  unsafe {
    if !rows_header_valid(rows) { return -1 }
    return raw.load(rows, 100)
  }
}

pub fn rows_deadline(rows: raw) -> i64 {
  unsafe {
    if !rows_header_valid(rows) { return -2 }
    return raw.load(rows, 104)
  }
}

pub fn rows_timeout_duration(rows: raw) -> i64 {
  unsafe {
    if !rows_header_valid(rows) { return -2 }
    return raw.load(rows, 112)
  }
}

pub fn set_rows_native(rows: raw, result: raw) -> bool {
  unsafe {
    terminal: u8 := if rows.is_null() { 255 } else { raw.load(rows, 5) }
    if !rows_header_valid(rows) || terminal != 0 { return false }
    context: raw := raw.load(rows, 24)
    if context.is_null() { return false }
    if !pkg.db.internal.set_native_generation_v1(context, result) { return false }
    raw.store(rows, 8, result)
    return true
  }
}

pub fn set_rows_protocol_pending(rows: raw, pending: bool) -> bool {
  unsafe {
    terminal: u8 := if rows.is_null() { 255 } else { raw.load(rows, 5) }
    if !rows_header_valid(rows) || terminal != 0 { return false }
    raw.store(rows, 97, if pending { 1 as u8 } else { 0 as u8 })
    return true
  }
}

// The complete structural header accepted by batch advancement. Active rows retain every native
// and generated callback pointer; terminal rows retain only their immutable Query identity and
// batch plan. Query-ID UTF-8 is validated by the caller through its resource reference.
pub fn rows_batch_header_valid(rows: raw) -> bool {
  unsafe {
    return rows_header_valid(rows)
  }
}

fn postgres_wait_ready(connection: raw, deadline_ns: i64) -> i32 {
  loop {
    flush := unsafe { PQflush(connection) }
    if flush < 0 { return 2 }
    if unsafe { PQconsumeInput(connection) } == 0 { return 2 }
    if flush == 0 && unsafe { PQisBusy(connection) } == 0 { return 0 }
    now := time.instant()
    if deadline_ns >= 0 && now >= deadline_ns { return 1 }
    remaining := if deadline_ns < 0 { POSTGRES_WAIT_SLICE_NS } else { deadline_ns - now }
    time.sleep(if remaining < POSTGRES_WAIT_SLICE_NS { remaining } else {
      POSTGRES_WAIT_SLICE_NS
    })
  }
}

fn recovery_deadline(budget_ns: i64) -> i64 {
  now := time.instant()
  if now < 0 || budget_ns <= 0 || now > 9223372036854775807 - budget_ns {
    return 9223372036854775807
  }
  return now + budget_ns
}

fn observe_cancel_error(cancel: raw) {
  unsafe {
    message := PQcancelErrorMessage(cancel)
    if !message.is_null() {
      // The bytes are owned by PGcancelConn and become invalid at PQcancelFinish. Reading the
      // first byte here pins the required before-Finish observation without publishing a view.
      ignored: u8 := raw.load(message, 0)
    }
  }
}

fn dispatch_postgres_cancel(connection: raw, budget_ns: i64) -> bool {
  unsafe {
    cancel := PQcancelCreate(connection)
    if cancel.is_null() { return false }
    if PQcancelStart(cancel) == 0 {
      observe_cancel_error(cancel)
      PQcancelFinish(cancel)
      return false
    }
    deadline := recovery_deadline(budget_ns)
    mut previous_poll := PGRES_POLLING_WRITING
    loop {
      socket := PQcancelSocket(cancel)
      now := time.instant()
      if socket < 0 || now < 0 || now >= deadline {
        observe_cancel_error(cancel)
        PQcancelFinish(cancel)
        return false
      }
      remaining := deadline - now
      wait_ns := if remaining < POSTGRES_WAIT_SLICE_NS {
        remaining
      } else { POSTGRES_WAIT_SLICE_NS }
      wait_us := (wait_ns + 999) / 1000
      wall_now := PQgetCurrentTimeUSec()
      if wall_now < 0 || wall_now > 9223372036854775807 - wait_us {
        observe_cancel_error(cancel)
        PQcancelFinish(cancel)
        return false
      }
      for_read := if previous_poll == PGRES_POLLING_READING { 1 } else { 0 }
      for_write := if previous_poll == PGRES_POLLING_WRITING { 1 } else { 0 }
      if for_read == 0 && for_write == 0 {
        observe_cancel_error(cancel)
        PQcancelFinish(cancel)
        return false
      }
      ready := PQsocketPoll(socket, for_read, for_write, wall_now + wait_us)
      if ready < 0 {
        observe_cancel_error(cancel)
        PQcancelFinish(cancel)
        return false
      }
      if ready != 0 {
        poll_status := PQcancelPoll(cancel)
        if poll_status == PGRES_POLLING_OK {
          observe_cancel_error(cancel)
          PQcancelFinish(cancel)
          return true
        }
        if poll_status == PGRES_POLLING_FAILED {
          observe_cancel_error(cancel)
          PQcancelFinish(cancel)
          return false
        }
        if poll_status != PGRES_POLLING_READING && poll_status != PGRES_POLLING_WRITING {
          observe_cancel_error(cancel)
          PQcancelFinish(cancel)
          return false
        }
        previous_poll = poll_status
      }
    }
  }
}

pub fn cancel_postgres(connection: raw, budget_ns: i64) -> bool {
  return dispatch_postgres_cancel(connection, budget_ns)
}

fn postgres_stream_synchronized(
  state: raw,
  connection: raw,
  clean_completion: bool,
) -> bool {
  unsafe {
    status := PQtransactionStatus(connection)
    transaction: u8 := raw.load(state, 21)
    if transaction == 0 { return status == PQTRANS_IDLE }
    if clean_completion { return status == PQTRANS_INTRANS }
    return status == PQTRANS_INTRANS || status == PQTRANS_INERROR
  }
}

// Finish one explicit PostgreSQL sequence. This is the one low-level cleanup authority used by
// ordinary error drain, deadline recovery, mode failure, and silent early Drop. It owns no public
// error value: callers preserve their already-copied first error and use the status only to decide
// whether a clean terminal can be published.
fn finish_postgres_stream(
  rows: raw,
  cancel_now: bool,
  already_drained: bool,
  cancel_budget_ns: i64,
) -> i32 {
  unsafe {
    state: raw := raw.load(rows, 32)
    connection: raw := if state.is_null() { raw.null() } else { raw.load(state, 8) }
    context: raw := raw.load(rows, 24)
    if connection.is_null() || context.is_null() { return 1 }
    mut cancelled := false
    mut wait_deadline: i64 := raw.load(rows, 104)
    if cancel_now {
      if !dispatch_postgres_cancel(connection, cancel_budget_ns) {
        poison_conn_state(state)
        return 1
      }
      cancelled = true
      wait_deadline = recovery_deadline(cancel_budget_ns)
    }
    mut current: raw := raw.load(rows, 8)
    if already_drained {
      if !current.is_null() { return 1 }
    } else {
      loop {
        if !current.is_null() {
          status := pkg.db.internal.postgres_status.code(current)
          PQclear(current)
          raw.store(rows, 8, raw.null())
          if !pkg.db.internal.set_native_generation_v1(context, raw.null()) {
            poison_conn_state(state)
            return 1
          }
          current = raw.null()
          if pkg.db.internal.postgres_status.must_close(status) {
            poison_conn_state(state)
            return 1
          }
        }
        ready := postgres_wait_ready(connection, wait_deadline)
        if ready == 2 {
          poison_conn_state(state)
          return 1
        }
        if ready == 1 {
          if cancelled {
            poison_conn_state(state)
            return 1
          }
          duration: i64 := raw.load(rows, 112)
          budget := if duration < POSTGRES_WAIT_SLICE_NS {
            POSTGRES_WAIT_SLICE_NS
          } else { duration }
          if !dispatch_postgres_cancel(connection, budget) {
            poison_conn_state(state)
            return 1
          }
          cancelled = true
          wait_deadline = recovery_deadline(budget)
        } else {
          current = PQgetResult(connection)
          if current.is_null() { break }
          if !pkg.db.internal.set_native_generation_v1(context, current) {
            PQclear(current)
            poison_conn_state(state)
            return 1
          }
          raw.store(rows, 8, current)
        }
      }
    }
    if !postgres_stream_synchronized(state, connection, already_drained) {
      poison_conn_state(state)
      return 1
    }
    if PQsetnonblocking(connection, 0) != 0 {
      poison_conn_state(state)
      return 1
    }
    return 0
  }
}

fn close_rows_with_policy(rows: raw, terminal: u8, policy: u8, budget_ns: i64) -> i32 {
  unsafe {
    driver := rows_driver(rows)
    if driver == 0 { return 1 }
    current: u8 := raw.load(rows, 5)
    if current != 0 { return 0 }
    if terminal != 1 && terminal != 2 { return 1 }
      native: raw := raw.load(rows, 8)
      context: raw := raw.load(rows, 24)
      connection_state: raw := raw.load(rows, 32)
      mut cleanup_status: i32 := 0
      if driver == 1 {
        mut reset_status: i32 := 0
        mut clear_status: i32 := 0
        if !native.is_null() {
          owns_statement: u8 := raw.load(rows, 73)
          if owns_statement != 0 {
            reset_status = sqlite3_finalize(native)
          } else {
            reset_status = sqlite3_reset(native)
            clear_status = sqlite3_clear_bindings(native)
          }
        }
        restore_timeout: u8 := raw.load(rows, 80)
        if restore_timeout != 0 && reset_status == 0 && clear_status == 0 {
          database: raw := if connection_state.is_null() { raw.null() } else {
            raw.load(connection_state, 8)
          }
          prior_timeout: i32 := raw.load(rows, 76)
          if database.is_null() || sqlite3_busy_timeout(database, prior_timeout) != 0 {
            cleanup_status = 1
          }
        }
        free_bind_context(driver, context)
        if reset_status != 0 || clear_status != 0 {
          cleanup_status = if reset_status != 0 { reset_status } else { clear_status }
          poison_conn_state(connection_state)
        } else {
          if cleanup_status != 0 { poison_conn_state(connection_state) } else {
            if !connection_state.is_null() { raw.store(connection_state, 20, 0 as u8) }
          }
        }
      } else {
        if driver == 2 {
          mut close_connection := false
          delivery: u8 := raw.load(rows, 96)
          if delivery == 1 || delivery == 2 {
            cleanup_status = finish_postgres_stream(
              rows, policy == 2, policy == 3, budget_ns,
            )
            close_connection = cleanup_status != 0
          } else {
            if !native.is_null() {
              result_status := pkg.db.internal.postgres_status.code(native)
              PQclear(native)
              close_connection = pkg.db.internal.postgres_status.must_close(result_status)
              if close_connection { poison_conn_state(connection_state) }
            }
          }
          free_bind_context(driver, context)
          if !close_connection && !connection_state.is_null() {
            raw.store(connection_state, 20, 0 as u8)
          }
        }
      }
      // A failed cleanup can never publish an exhausted generation. The caller returns the
      // cleanup error for this advance; retaining terminal=failed also makes every later advance
      // report the failed-state error instead of silently returning end-of-stream.
      published_terminal: u8 := if cleanup_status == 0 { terminal } else { 2 as u8 }
      raw.store(rows, 5, published_terminal)
      raw.store(rows, 8, raw.null())
      raw.store(rows, 16, raw.null())
      raw.store(rows, 24, raw.null())
      raw.store(rows, 32, raw.null())
      raw.store(rows, 40, raw.null())
      raw.store(rows, 48, raw.null())
      raw.store(rows, 73, 0 as u8)
      raw.store(rows, 76, 0 as i32)
      raw.store(rows, 80, 0 as u8)
      raw.store(rows, 96, 0 as u8)
      raw.store(rows, 97, 0 as u8)
      raw.store(rows, 98, 0 as u16)
      raw.store(rows, 100, 0 as i32)
      raw.store(rows, 104, -1 as i64)
      raw.store(rows, 112, -1 as i64)
      return cleanup_status
  }
}

pub fn close_rows(rows: raw, terminal: u8) -> i32 {
  unsafe {
    delivery: u8 := if rows_header_valid(rows) { raw.load(rows, 96) } else { 255 }
    policy: u8 := if terminal == 2 && (delivery == 1 || delivery == 2) { 2 } else { 0 }
    return close_rows_with_policy(rows, terminal, policy, POSTGRES_DROP_RECOVERY_NS)
  }
}

pub fn drain_rows(rows: raw, terminal: u8) -> i32 {
  return close_rows_with_policy(rows, terminal, 1, 0)
}

pub fn cancel_rows(rows: raw, terminal: u8, budget_ns: i64) -> i32 {
  return close_rows_with_policy(rows, terminal, 2, budget_ns)
}

pub fn complete_rows(rows: raw, terminal: u8) -> i32 {
  return close_rows_with_policy(rows, terminal, 3, 0)
}

// Release an unpublished explicit direct rows wrapper before a query was accepted by libpq. The
// current result must still be null, so this path performs no cancel, drain, or result access.
pub fn discard_unpublished_rows(rows: raw) -> bool {
  unsafe {
    native: raw := if rows.is_null() { raw.null() } else { raw.load(rows, 8) }
    terminal: u8 := if rows.is_null() { 255 } else { raw.load(rows, 5) }
    driver: u8 := if rows.is_null() { 0 } else { raw.load(rows, 4) }
    if !rows_header_valid(rows) || terminal != 0 || driver != 2 || !native.is_null() {
      return false
    }
    delivery: u8 := raw.load(rows, 96)
    if delivery != 1 && delivery != 2 { return false }
    context: raw := raw.load(rows, 24)
    state: raw := raw.load(rows, 32)
    free_bind_context(2, context)
    if !state.is_null() { raw.store(state, 20, 0 as u8) }
    owns_query_id: u8 := raw.load(rows, 72)
    query_id: raw := raw.load(rows, 56)
    if owns_query_id != 0 && !query_id.is_null() { raw.free(query_id) }
    raw.free(rows)
    return true
  }
}

// A producer-owned v1 batch plan. The public wrapper, prepared statement, and rows state all
// validate this complete record before loading a thunk from it.
pub fn batch_plan_valid(plan: raw) -> bool {
  unsafe {
    if plan.is_null() { return false }
    version: u32 := raw.load(plan, 0)
    flags: u8 := raw.load(plan, 4)
    reserved8: u8 := raw.load(plan, 5)
    reserved16: u16 := raw.load(plan, 6)
    field_count: u32 := raw.load(plan, 8)
    reserved32: u32 := raw.load(plan, 12)
    create: raw := raw.load(plan, 16)
    append: raw := raw.load(plan, 24)
    finish: raw := raw.load(plan, 32)
    row: raw := raw.load(plan, 40)
    soa: raw := raw.load(plan, 48)
    drop_payload: raw := raw.load(plan, 56)
    tail_reserved: i64 := raw.load(plan, 64)
    soa_valid := if flags & 1 == 0 {
      soa.is_null()
    } else {
      field_count > 0 && !soa.is_null()
    }
    return version == 1 && flags & 254 == 0 && reserved8 == 0 && reserved16 == 0
      && reserved32 == 0 && !create.is_null() && !append.is_null()
      && !finish.is_null() && !row.is_null() && soa_valid && !drop_payload.is_null()
      && tail_reserved == 0
  }
}

// One independently owned published batch generation.
//   0: u32 version (= 1)
//   4: u8 state (0 live, 1 closed)
//   5: u8 copied plan flags
//   6: u16 reserved (= 0)
//   8: raw batch plan
//  16: raw producer payload
//  24: i64 nonzero row count
//  32: i64 requested maximum row count
//  40: i64 reserved (= 0)
pub fn new_batch_state(plan: raw, payload: raw, len: i64, max_rows: i64) -> raw {
  unsafe {
    wrapper := raw.alloc(48)
    flags: u8 := raw.load(plan, 4)
    raw.store(wrapper, 0, 1 as u32)
    raw.store(wrapper, 4, 0 as u8)
    raw.store(wrapper, 5, flags)
    raw.store(wrapper, 6, 0 as u16)
    raw.store(wrapper, 8, plan)
    raw.store(wrapper, 16, payload)
    raw.store(wrapper, 24, len)
    raw.store(wrapper, 32, max_rows)
    raw.store(wrapper, 40, 0 as i64)
    return wrapper
  }
}

pub fn batch_live(wrapper: raw) -> bool {
  unsafe {
    if wrapper.is_null() { return false }
    version: u32 := raw.load(wrapper, 0)
    state: u8 := raw.load(wrapper, 4)
    flags: u8 := raw.load(wrapper, 5)
    reserved: u16 := raw.load(wrapper, 6)
    plan: raw := raw.load(wrapper, 8)
    payload: raw := raw.load(wrapper, 16)
    len: i64 := raw.load(wrapper, 24)
    max_rows: i64 := raw.load(wrapper, 32)
    tail_reserved: i64 := raw.load(wrapper, 40)
    if version != 1 || state != 0 || reserved != 0 || !batch_plan_valid(plan)
      || payload.is_null() || len <= 0 || max_rows <= 0 || max_rows > 2147483647
      || len > max_rows || tail_reserved != 0 {
      return false
    }
    plan_flags: u8 := raw.load(plan, 4)
    return flags == plan_flags
  }
}

pub fn batch_plan(wrapper: raw) -> raw {
  unsafe {
    if !batch_live(wrapper) { return raw.null() }
    return raw.load(wrapper, 8)
  }
}

pub fn batch_payload(wrapper: raw) -> raw {
  unsafe {
    if !batch_live(wrapper) { return raw.null() }
    return raw.load(wrapper, 16)
  }
}

pub fn batch_length(wrapper: raw) -> i64 {
  unsafe {
    if !batch_live(wrapper) { return -1 }
    return raw.load(wrapper, 24)
  }
}

pub fn batch_soa_capable(wrapper: raw) -> bool {
  unsafe {
    if !batch_live(wrapper) { return false }
    flags: u8 := raw.load(wrapper, 5)
    return flags & 1 != 0
  }
}

pub fn drop_batch(wrapper: raw) {
  unsafe {
    if wrapper.is_null() { return }
    if batch_live(wrapper) {
      plan: raw := raw.load(wrapper, 8)
      payload: raw := raw.load(wrapper, 16)
      raw.store(wrapper, 4, 1 as u8)
      raw.store(wrapper, 16, raw.null())
      pkg.db.internal.descriptor.drop_batch_payload(plan, payload)
    }
    raw.free(wrapper)
  }
}

pub fn drop_rows(rows: raw) {
  unsafe {
    if rows.is_null() { return }
    ignored := close_rows(rows, 2)
    owns_query_id: u8 := raw.load(rows, 72)
    query_id: raw := raw.load(rows, 56)
    if owns_query_id != 0 && !query_id.is_null() { raw.free(query_id) }
    raw.free(rows)
  }
}

// A synchronous D12 catalog cursor owns one SQLite statement or PostgreSQL result while returned
// text is validated and copied into the caller's region.  Both drivers own the connection-wide
// execution lease.  Bound SQLite text is SQLITE_STATIC, so its two optional C buffers remain in
// this wrapper until statement finalization.
//   0: u32 version (= 1)
//   4: u8  driver (1 SQLite, 2 PostgreSQL)
//   5: u8  closed
//   6: u16 reserved (= 0)
//   8: raw sqlite3_stmt / PGresult
//  16: raw connection state (lease owner)
//  24: raw first retained SQLite bind buffer
//  32: raw second retained SQLite bind buffer
pub fn new_catalog_cursor(
  driver: u8,
  native: raw,
  state: raw,
  first_bind: raw,
  second_bind: raw,
) -> raw {
  unsafe {
    cursor := raw.alloc(40)
    version: u32 := 1
    clear: u8 := 0
    reserved: u16 := 0
    raw.store(cursor, 0, version)
    raw.store(cursor, 4, driver)
    raw.store(cursor, 5, clear)
    raw.store(cursor, 6, reserved)
    raw.store(cursor, 8, native)
    raw.store(cursor, 16, state)
    raw.store(cursor, 24, first_bind)
    raw.store(cursor, 32, second_bind)
    return cursor
  }
}

pub fn catalog_native(cursor: raw) -> raw {
  unsafe {
    if cursor.is_null() { return raw.null() }
    version: u32 := raw.load(cursor, 0)
    closed: u8 := raw.load(cursor, 5)
    reserved: u16 := raw.load(cursor, 6)
    if version != 1 || closed != 0 || reserved != 0 { return raw.null() }
    return raw.load(cursor, 8)
  }
}

pub fn close_catalog_cursor(cursor: raw) -> i32 {
  unsafe {
    if cursor.is_null() { return 0 }
    version: u32 := raw.load(cursor, 0)
    driver: u8 := raw.load(cursor, 4)
    closed: u8 := raw.load(cursor, 5)
    reserved: u16 := raw.load(cursor, 6)
    if version != 1 || reserved != 0 || closed != 0 { return 0 }

    native: raw := raw.load(cursor, 8)
    state: raw := raw.load(cursor, 16)
    mut status: i32 := 0
    mut close_connection := false
    if !native.is_null() {
      if driver == 1 {
        status = sqlite3_finalize(native)
      } else {
        if driver == 2 {
          result_status := pkg.db.internal.postgres_status.code(native)
          PQclear(native)
          close_connection = pkg.db.internal.postgres_status.must_close(result_status)
          if close_connection { poison_conn_state(state) }
        }
      }
    }
    first_bind: raw := raw.load(cursor, 24)
    second_bind: raw := raw.load(cursor, 32)
    if !first_bind.is_null() { raw.free(first_bind) }
    if !second_bind.is_null() { raw.free(second_bind) }
    if (driver == 1 || driver == 2) && !close_connection && !state.is_null() {
      inactive: u8 := 0
      raw.store(state, 20, inactive)
    }
    one: u8 := 1
    raw.store(cursor, 5, one)
    raw.store(cursor, 8, raw.null())
    raw.store(cursor, 16, raw.null())
    raw.store(cursor, 24, raw.null())
    raw.store(cursor, 32, raw.null())
    return status
  }
}

pub fn drop_catalog_cursor(cursor: raw) {
  unsafe {
    if cursor.is_null() { return }
    ignored := close_catalog_cursor(cursor)
    raw.free(cursor)
  }
}
