module pkg.db.internal.resource

extern "C" link("sqlite3") {
  fn sqlite3_close_v2(database: raw) -> i32
  fn sqlite3_finalize(statement: raw) -> i32
  fn sqlite3_reset(statement: raw) -> i32
  fn sqlite3_clear_bindings(statement: raw) -> i32
  fn sqlite3_busy_timeout(database: raw, milliseconds: i32) -> i32
  fn sqlite3_exec(database: raw, sql: raw, callback: raw, argument: raw, error_out: raw) -> i32
}

extern "C" link("pq") {
  fn PQfinish(connection: raw)
  fn PQclear(result: raw)
  fn PQexec(connection: raw, command: raw) -> raw
}

// The state is private to pkg.db descendants. Its fixed Q2 prefix is:
//   0: u32 version (= 1)
//   4: u8  driver (1 = SQLite, 2 = PostgreSQL)
//   5: u8  poisoned/closed
//   6: u16 reserved (= 0)
//   8: raw native connection
//  16: i32 SQLite busy timeout in native milliseconds
//  20: u8  active execution lease
//  21: u8  active transaction owner
//  22: u16 reserved
//  24: i64 next connection-local prepared-statement ordinal
// The native pointer stays an actual pointer. The package never integer-casts it and the runtime
// owns neither this layout nor either database handle.
pub fn new_conn_state(driver: u8, native: raw, sqlite_busy_ms: i32) -> raw {
  unsafe {
    state := raw.alloc(32)
    version: u32 := 1
    clear: u8 := 0
    reserved: u16 := 0
    raw.store(state, 0, version)
    raw.store(state, 4, driver)
    raw.store(state, 5, clear)
    raw.store(state, 6, reserved)
    raw.store(state, 8, native)
    raw.store(state, 16, sqlite_busy_ms)
    raw.store(state, 20, clear)
    raw.store(state, 21, clear)
    raw.store(state, 22, reserved)
    next_statement: i64 := 0
    raw.store(state, 24, next_statement)
    return state
  }
}

fn c_string(value: str) -> raw {
  unsafe {
    bytes := value.bytes()
    output := raw.alloc(bytes.len() + 1)
    mut i := 0
    loop {
      if i >= bytes.len() { break }
      raw.store(output, i, bytes[i])
      i = i + 1
    }
    raw.store(output, bytes.len(), 0 as u8)
    return output
  }
}

fn rollback_state(state: raw) {
  unsafe {
    if state.is_null() { return }
    version: u32 := raw.load(state, 0)
    driver: u8 := raw.load(state, 4)
    closed: u8 := raw.load(state, 5)
    active: u8 := raw.load(state, 21)
    native: raw := raw.load(state, 8)
    if version != 1 || closed != 0 || active == 0 || native.is_null() { return }
    sql := c_string("ROLLBACK")
    if driver == 1 {
      ignored := sqlite3_exec(native, sql, raw.null(), raw.null(), raw.null())
    } else {
      if driver == 2 {
        result := PQexec(native, sql)
        if !result.is_null() { PQclear(result) }
      }
    }
    raw.free(sql)
    raw.store(state, 21, 0 as u8)
  }
}

fn drop_state(state: raw) {
  unsafe {
    if state.is_null() { return }
    version: u32 := raw.load(state, 0)
    driver: u8 := raw.load(state, 4)
    native: raw := raw.load(state, 8)
    // A malformed private state is still freed, but never dispatched through an untrusted tag.
    // Both native destructors are null-guarded here so partial construction has one cleanup edge.
    if version == 1 && !native.is_null() {
      if driver == 1 {
        ignored := sqlite3_close_v2(native)
      } else {
        if driver == 2 { PQfinish(native) }
      }
    }
    raw.free(state)
  }
}

pub fn drop_conn(state: raw) {
  unsafe { drop_state(state) }
}

pub fn drop_tx(state: raw) {
  unsafe {
    rollback_state(state)
    drop_state(state)
  }
}

pub fn transaction_active(state: raw) -> bool {
  unsafe {
    if state.is_null() { return false }
    version: u32 := raw.load(state, 0)
    closed: u8 := raw.load(state, 5)
    active: u8 := raw.load(state, 21)
    native: raw := raw.load(state, 8)
    return version == 1 && closed == 0 && active != 0 && !native.is_null()
  }
}

pub fn set_transaction_active(state: raw, active: bool) {
  unsafe {
    if state.is_null() { return }
    raw.store(state, 21, if active { 1 as u8 } else { 0 as u8 })
  }
}

pub fn next_statement_ordinal(state: raw) -> i64 {
  unsafe {
    if state.is_null() { return -1 }
    current: i64 := raw.load(state, 24)
    if current < 0 || current == 9223372036854775807 { return -1 }
    raw.store(state, 24, current + 1)
    return current
  }
}

pub fn poison_conn_state(state: raw) {
  unsafe {
    if state.is_null() { return }
    version: u32 := raw.load(state, 0)
    driver: u8 := raw.load(state, 4)
    closed: u8 := raw.load(state, 5)
    native: raw := raw.load(state, 8)
    if version != 1 || closed != 0 || native.is_null() { return }
    raw.store(state, 5, 1 as u8)
    raw.store(state, 8, raw.null())
    raw.store(state, 20, 0 as u8)
    raw.store(state, 21, 0 as u8)
    if driver == 1 {
      ignored := sqlite3_close_v2(native)
    } else {
      if driver == 2 { PQfinish(native) }
    }
  }
}

// A prepared statement wrapper is dependent on the conn/tx resource generation that created it.
//   0: u32 version (= 1)
//   4: u8  driver
//   5: u8  closed
//   6: u16 reserved
//   8: raw sqlite3_stmt / PostgreSQL prepared-name C string
//  16: raw connection state
//  24: raw generated Params binder
//  32: raw owned Query-ID bytes with a trailing NUL
//  40: i64 Query-ID byte length
//  48: raw PostgreSQL DEALLOCATE command C string, null for SQLite
//  56: raw generated Row validator
//  64: raw generated streaming Row decoder
pub fn new_stmt_state(
  driver: u8,
  native: raw,
  connection_state: raw,
  binder: raw,
  query_id: raw,
  query_id_len: i64,
  deallocate_sql: raw,
  row_validator: raw,
  stream_decoder: raw,
) -> raw {
  unsafe {
    statement := raw.alloc(72)
    raw.store(statement, 0, 1 as u32)
    raw.store(statement, 4, driver)
    raw.store(statement, 5, 0 as u8)
    raw.store(statement, 6, 0 as u16)
    raw.store(statement, 8, native)
    raw.store(statement, 16, connection_state)
    raw.store(statement, 24, binder)
    raw.store(statement, 32, query_id)
    raw.store(statement, 40, query_id_len)
    raw.store(statement, 48, deallocate_sql)
    raw.store(statement, 56, row_validator)
    raw.store(statement, 64, stream_decoder)
    return statement
  }
}

pub fn stmt_driver(statement: raw) -> u8 {
  unsafe {
    if statement.is_null() { return 0 }
    version: u32 := raw.load(statement, 0)
    driver: u8 := raw.load(statement, 4)
    closed: u8 := raw.load(statement, 5)
    reserved: u16 := raw.load(statement, 6)
    if version != 1 || (driver != 1 && driver != 2) || closed != 0 || reserved != 0 {
      return 0
    }
    return driver
  }
}

pub fn stmt_native(statement: raw) -> raw {
  unsafe {
    if stmt_driver(statement) == 0 { return raw.null() }
    return raw.load(statement, 8)
  }
}

pub fn stmt_connection_state(statement: raw) -> raw {
  unsafe {
    if stmt_driver(statement) == 0 { return raw.null() }
    return raw.load(statement, 16)
  }
}

pub fn stmt_query_id_pointer(statement: raw) -> raw {
  unsafe {
    if stmt_driver(statement) == 0 { return raw.null() }
    return raw.load(statement, 32)
  }
}

pub fn stmt_query_id_length(statement: raw) -> i64 {
  unsafe {
    if stmt_driver(statement) == 0 { return -1 }
    return raw.load(statement, 40)
  }
}

pub fn stmt_row_validator(statement: raw) -> raw {
  unsafe {
    if stmt_driver(statement) == 0 { return raw.null() }
    return raw.load(statement, 56)
  }
}

pub fn stmt_stream_decoder(statement: raw) -> raw {
  unsafe {
    if stmt_driver(statement) == 0 { return raw.null() }
    return raw.load(statement, 64)
  }
}

pub fn close_stmt(statement: raw) -> i32 {
  unsafe {
    driver := stmt_driver(statement)
    if driver == 0 { return 0 }
    native: raw := raw.load(statement, 8)
    connection_state: raw := raw.load(statement, 16)
    mut status: i32 := 0
    if driver == 1 {
      if !native.is_null() { status = sqlite3_finalize(native) }
      if status != 0 { poison_conn_state(connection_state) }
    } else {
      if driver == 2 && !connection_state.is_null() {
        closed: u8 := raw.load(connection_state, 5)
        active: u8 := raw.load(connection_state, 20)
        connection: raw := raw.load(connection_state, 8)
        deallocate_sql: raw := raw.load(statement, 48)
        // Drop cannot report a lease conflict.  If another rows resource owns the connection,
        // leave the server-side statement to connection teardown instead of overlapping libpq.
        if closed == 0 && active == 0 && !connection.is_null() && !deallocate_sql.is_null() {
          result := PQexec(connection, deallocate_sql)
          if !result.is_null() { PQclear(result) }
        }
      }
      if !native.is_null() { raw.free(native) }
    }
    query_id: raw := raw.load(statement, 32)
    deallocate_sql: raw := raw.load(statement, 48)
    if !query_id.is_null() { raw.free(query_id) }
    if !deallocate_sql.is_null() { raw.free(deallocate_sql) }
    raw.store(statement, 5, 1 as u8)
    raw.store(statement, 8, raw.null())
    raw.store(statement, 16, raw.null())
    raw.store(statement, 24, raw.null())
    raw.store(statement, 32, raw.null())
    raw.store(statement, 40, 0 as i64)
    raw.store(statement, 48, raw.null())
    raw.store(statement, 56, raw.null())
    raw.store(statement, 64, raw.null())
    return status
  }
}

pub fn drop_stmt(statement: raw) {
  unsafe {
    if statement.is_null() { return }
    ignored := close_stmt(statement)
    raw.free(statement)
  }
}

fn free_bind_context(driver: u8, context: raw) {
  unsafe {
    if context.is_null() { return }
    cache: raw := raw.load(context, 24)
    if !cache.is_null() { raw.free(cache) }
    if driver == 1 {
      values: raw := raw.load(context, 40)
      count: u32 := raw.load(context, 48)
      if !values.is_null() {
        mut i: u32 := 0
        loop {
          if i >= count { break }
          value: raw := raw.load(values, (i as i64) * 8)
          if !value.is_null() { raw.free(value) }
          i = i + 1
        }
        raw.free(values)
      }
    } else {
      if driver == 2 {
        values: raw := raw.load(context, 40)
        types: raw := raw.load(context, 48)
        lengths: raw := raw.load(context, 56)
        formats: raw := raw.load(context, 64)
        count: u32 := raw.load(context, 72)
        if !values.is_null() {
          mut i: u32 := 0
          loop {
            if i >= count { break }
            value: raw := raw.load(values, (i as i64) * 8)
            if !value.is_null() { raw.free(value) }
            i = i + 1
          }
          raw.free(values)
        }
        if !types.is_null() { raw.free(types) }
        if !lengths.is_null() { raw.free(lengths) }
        if !formats.is_null() { raw.free(formats) }
      }
    }
    raw.free(context)
  }
}

// One streamed execution. SQLite borrows a prepared stmt handle or owns a direct stmt;
// PostgreSQL owns one buffered PGresult. A prepared stream remains dependent on the statement
// generation; a direct stream is dependent on the conn/tx generation.
//   0: u32 version (= 1), 4: driver, 5: terminal (0 active, 1 exhausted, 2 failed), 6: reserved
//   8: sqlite3_stmt / PGresult
//  16: prepared stmt wrapper, null for direct execution
//  24: bind/decode context
//  32: conn state
//  40: generated Row validator
//  48: generated streaming Row decoder
//  56: Query-ID bytes (borrowed from stmt or owned by this wrapper)
//  64: i64 Query-ID byte length
//  72: u8 Query-ID ownership (0 borrowed, 1 owned)
//  73: u8 SQLite statement ownership (0 prepared, 1 direct)
//  74: u16 reserved
//  76: i32 saved SQLite busy timeout in native milliseconds
//  80: u8 restore saved SQLite busy timeout (0 no, 1 yes)
//  81: u8[7] reserved
pub fn new_rows_state(
  driver: u8,
  native: raw,
  statement: raw,
  context: raw,
  connection_state: raw,
  row_validator: raw,
  stream_decoder: raw,
  query_id: raw,
  query_id_len: i64,
  owns_query_id: bool,
  owns_statement: bool,
  restore_timeout: bool,
  prior_timeout: i32,
) -> raw {
  unsafe {
    rows := raw.alloc(88)
    raw.store(rows, 0, 1 as u32)
    raw.store(rows, 4, driver)
    raw.store(rows, 5, 0 as u8)
    raw.store(rows, 6, 0 as u16)
    raw.store(rows, 8, native)
    raw.store(rows, 16, statement)
    raw.store(rows, 24, context)
    raw.store(rows, 32, connection_state)
    raw.store(rows, 40, row_validator)
    raw.store(rows, 48, stream_decoder)
    raw.store(rows, 56, query_id)
    raw.store(rows, 64, query_id_len)
    raw.store(rows, 72, if owns_query_id { 1 as u8 } else { 0 as u8 })
    raw.store(rows, 73, if owns_statement { 1 as u8 } else { 0 as u8 })
    raw.store(rows, 74, 0 as u16)
    raw.store(rows, 76, prior_timeout)
    raw.store(rows, 80, if restore_timeout { 1 as u8 } else { 0 as u8 })
    raw.store(rows, 81, 0 as u8)
    raw.store(rows, 82, 0 as u16)
    raw.store(rows, 84, 0 as u32)
    return rows
  }
}

pub fn rows_driver(rows: raw) -> u8 {
  unsafe {
    if rows.is_null() { return 0 }
    version: u32 := raw.load(rows, 0)
    driver: u8 := raw.load(rows, 4)
    reserved: u16 := raw.load(rows, 6)
    tail_reserved: u16 := raw.load(rows, 74)
    timeout_reserved: u8 := raw.load(rows, 81)
    timeout_reserved16: u16 := raw.load(rows, 82)
    timeout_reserved32: u32 := raw.load(rows, 84)
    if version != 1 || (driver != 1 && driver != 2) || reserved != 0 || tail_reserved != 0
      || timeout_reserved != 0 || timeout_reserved16 != 0 || timeout_reserved32 != 0 {
      return 0
    }
    return driver
  }
}

pub fn rows_terminal(rows: raw) -> u8 {
  unsafe {
    if rows_driver(rows) == 0 { return 2 }
    return raw.load(rows, 5)
  }
}

pub fn rows_native(rows: raw) -> raw {
  unsafe {
    if rows_driver(rows) == 0 { return raw.null() }
    return raw.load(rows, 8)
  }
}

pub fn rows_context(rows: raw) -> raw {
  unsafe {
    if rows_driver(rows) == 0 { return raw.null() }
    return raw.load(rows, 24)
  }
}

pub fn rows_connection_state(rows: raw) -> raw {
  unsafe {
    if rows_driver(rows) == 0 { return raw.null() }
    return raw.load(rows, 32)
  }
}

pub fn rows_query_id_pointer(rows: raw) -> raw {
  unsafe {
    if rows_driver(rows) == 0 { return raw.null() }
    return raw.load(rows, 56)
  }
}

pub fn rows_query_id_length(rows: raw) -> i64 {
  unsafe {
    if rows_driver(rows) == 0 { return -1 }
    return raw.load(rows, 64)
  }
}

pub fn close_rows(rows: raw, terminal: u8) -> i32 {
  unsafe {
    driver := rows_driver(rows)
    if driver == 0 { return 1 }
    current: u8 := raw.load(rows, 5)
    if current != 0 { return 0 }
    if terminal != 1 && terminal != 2 { return 1 }
      native: raw := raw.load(rows, 8)
      context: raw := raw.load(rows, 24)
      connection_state: raw := raw.load(rows, 32)
      mut cleanup_status: i32 := 0
      if driver == 1 {
        mut reset_status: i32 := 0
        mut clear_status: i32 := 0
        if !native.is_null() {
          owns_statement: u8 := raw.load(rows, 73)
          if owns_statement != 0 {
            reset_status = sqlite3_finalize(native)
          } else {
            reset_status = sqlite3_reset(native)
            clear_status = sqlite3_clear_bindings(native)
          }
        }
        restore_timeout: u8 := raw.load(rows, 80)
        if restore_timeout != 0 && reset_status == 0 && clear_status == 0 {
          database: raw := if connection_state.is_null() { raw.null() } else {
            raw.load(connection_state, 8)
          }
          prior_timeout: i32 := raw.load(rows, 76)
          if database.is_null() || sqlite3_busy_timeout(database, prior_timeout) != 0 {
            cleanup_status = 1
          }
        }
        free_bind_context(driver, context)
        if reset_status != 0 || clear_status != 0 {
          cleanup_status = if reset_status != 0 { reset_status } else { clear_status }
          poison_conn_state(connection_state)
        } else {
          if cleanup_status != 0 { poison_conn_state(connection_state) } else {
            if !connection_state.is_null() { raw.store(connection_state, 20, 0 as u8) }
          }
        }
      } else {
        if driver == 2 {
          if !native.is_null() { PQclear(native) }
          free_bind_context(driver, context)
          if !connection_state.is_null() { raw.store(connection_state, 20, 0 as u8) }
        }
      }
      raw.store(rows, 5, terminal)
      raw.store(rows, 8, raw.null())
      raw.store(rows, 16, raw.null())
      raw.store(rows, 24, raw.null())
      raw.store(rows, 32, raw.null())
      raw.store(rows, 40, raw.null())
      raw.store(rows, 48, raw.null())
      raw.store(rows, 73, 0 as u8)
      raw.store(rows, 76, 0 as i32)
      raw.store(rows, 80, 0 as u8)
      return cleanup_status
  }
}

pub fn drop_rows(rows: raw) {
  unsafe {
    if rows.is_null() { return }
    ignored := close_rows(rows, 2)
    owns_query_id: u8 := raw.load(rows, 72)
    query_id: raw := raw.load(rows, 56)
    if owns_query_id != 0 && !query_id.is_null() { raw.free(query_id) }
    raw.free(rows)
  }
}

// A synchronous D12 catalog/EXPLAIN cursor owns one SQLite statement or PostgreSQL result while
// returned text is validated and copied into the caller's region.  SQLite additionally owns the
// connection-wide execution lease.  Bound SQLite text is SQLITE_STATIC, so its two optional C
// buffers remain in this wrapper until statement finalization.
//   0: u32 version (= 1)
//   4: u8  driver (1 SQLite, 2 PostgreSQL)
//   5: u8  closed
//   6: u16 reserved (= 0)
//   8: raw sqlite3_stmt / PGresult
//  16: raw connection state (SQLite lease owner; null for PostgreSQL)
//  24: raw first retained SQLite bind buffer
//  32: raw second retained SQLite bind buffer
pub fn new_catalog_cursor(
  driver: u8,
  native: raw,
  state: raw,
  first_bind: raw,
  second_bind: raw,
) -> raw {
  unsafe {
    cursor := raw.alloc(40)
    version: u32 := 1
    clear: u8 := 0
    reserved: u16 := 0
    raw.store(cursor, 0, version)
    raw.store(cursor, 4, driver)
    raw.store(cursor, 5, clear)
    raw.store(cursor, 6, reserved)
    raw.store(cursor, 8, native)
    raw.store(cursor, 16, state)
    raw.store(cursor, 24, first_bind)
    raw.store(cursor, 32, second_bind)
    return cursor
  }
}

pub fn catalog_native(cursor: raw) -> raw {
  unsafe {
    if cursor.is_null() { return raw.null() }
    version: u32 := raw.load(cursor, 0)
    closed: u8 := raw.load(cursor, 5)
    reserved: u16 := raw.load(cursor, 6)
    if version != 1 || closed != 0 || reserved != 0 { return raw.null() }
    return raw.load(cursor, 8)
  }
}

pub fn close_catalog_cursor(cursor: raw) -> i32 {
  unsafe {
    if cursor.is_null() { return 0 }
    version: u32 := raw.load(cursor, 0)
    driver: u8 := raw.load(cursor, 4)
    closed: u8 := raw.load(cursor, 5)
    reserved: u16 := raw.load(cursor, 6)
    if version != 1 || reserved != 0 || closed != 0 { return 0 }

    native: raw := raw.load(cursor, 8)
    state: raw := raw.load(cursor, 16)
    mut status: i32 := 0
    if !native.is_null() {
      if driver == 1 {
        status = sqlite3_finalize(native)
      } else {
        if driver == 2 { PQclear(native) }
      }
    }
    first_bind: raw := raw.load(cursor, 24)
    second_bind: raw := raw.load(cursor, 32)
    if !first_bind.is_null() { raw.free(first_bind) }
    if !second_bind.is_null() { raw.free(second_bind) }
    if driver == 1 && !state.is_null() {
      inactive: u8 := 0
      raw.store(state, 20, inactive)
    }
    one: u8 := 1
    raw.store(cursor, 5, one)
    raw.store(cursor, 8, raw.null())
    raw.store(cursor, 16, raw.null())
    raw.store(cursor, 24, raw.null())
    raw.store(cursor, 32, raw.null())
    return status
  }
}

pub fn drop_catalog_cursor(cursor: raw) {
  unsafe {
    if cursor.is_null() { return }
    ignored := close_catalog_cursor(cursor)
    raw.free(cursor)
  }
}
