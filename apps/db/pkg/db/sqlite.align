pub fn explain_native<P, R>(
  target: pkg.db.exec,
  statement: pkg.db.query<P, R>,
  params: P,
  out: region,
  options: slice<pkg.db.ExplainOption>,
  native: slice<ExplainOption>,
) -> Result<pkg.db.QueryPlan, pkg.db.Error> {
  if !pkg.db.internal.sqlite.query_header_valid(statement) {
    return Err(pkg.db.internal.sqlite.invalid_descriptor_error())
  }
  unsafe {
    query_id := pkg.db.internal.descriptor.descriptor_id(statement)
    mut saw_timeout := false
    mut common_index := 0
    loop {
      if common_index >= options.len() { break }
      match options[common_index] {
        TimeoutNs(ns) => {
          if ns <= 0 {
            return Err(pkg.db.internal.sqlite.descriptor_error(
              query_id,
              "db.explain.timeout_ns",
              "database EXPLAIN timeout must be positive",
            ))
          }
          if saw_timeout {
            return Err(pkg.db.internal.sqlite.descriptor_error(
              query_id,
              "db.explain.timeout_ns",
              "duplicate database EXPLAIN timeout",
            ))
          }
          saw_timeout = true
        }
      }
      common_index = common_index + 1
    }
    if saw_timeout {
      return Err(pkg.db.internal.sqlite.descriptor_error(
        query_id,
        "db.explain.timeout_ns",
        "SQLite does not support common EXPLAIN deadlines",
      ))
    }
    mut saw_mode := false
    mut mode: u8 := 0
    mut native_index := 0
    loop {
      if native_index >= native.len() { break }
      if saw_mode {
        return Err(pkg.db.internal.sqlite.descriptor_error(
          query_id,
          "sqlite.explain.mode",
          "duplicate SQLite EXPLAIN mode",
        ))
      }
      match native[native_index] {
        QueryPlan => { mode = 0 }
        Bytecode => { mode = 1 }
      }
      saw_mode = true
      native_index = native_index + 1
    }
    result: Result<pkg.db.QueryPlan, pkg.db.Error> :=
      pkg.db.internal.descriptor.explain_sqlite_native(
      statement, target, params, out, query_id, mode,
    )
    return result
  }
}
