module pkg.db.sqlite

import std.process
import pkg.db
import pkg.db.internal
import pkg.db.internal.resource
import pkg.db.internal.descriptor
import pkg.db.internal.sqlite

extern "C" {
  fn memcpy(destination: raw, source: str, count: i64) -> raw
  fn align_pkg_db_sqlite_register_v2(
    database: raw,
    name: str,
    name_length: i64,
    arity: i32,
    flags: i32,
    trampoline: raw,
  ) -> raw
}

extern "C" link("sqlite3") {
  fn sqlite3_open_v2(filename: raw, database_out: raw, flags: i32, vfs: raw) -> i32
  fn sqlite3_close_v2(database: raw) -> i32
  fn sqlite3_busy_timeout(database: raw, milliseconds: i32) -> i32
  fn sqlite3_extended_result_codes(database: raw, enabled: i32) -> i32
  fn sqlite3_exec(database: raw, sql: raw, callback: raw, argument: raw, error_out: raw) -> i32
  fn sqlite3_errcode(database: raw) -> i32
  fn sqlite3_extended_errcode(database: raw) -> i32
  fn sqlite3_errmsg(database: raw) -> raw
  fn sqlite3_libversion_number() -> i32
  fn sqlite3_get_autocommit(database: raw) -> i32
  fn sqlite3_create_function_v2(
    database: raw,
    name: raw,
    arity: i32,
    flags: i32,
    application: raw,
    scalar: raw,
    step: raw,
    finalizer: raw,
    destroy: raw,
  ) -> i32
  fn sqlite3_context_db_handle(context: raw) -> raw
  fn sqlite3_value_type(value: raw) -> i32
  fn sqlite3_value_int64(value: raw) -> i64
  fn sqlite3_value_double(value: raw) -> f64
  fn sqlite3_value_bytes(value: raw) -> i32
  fn sqlite3_value_text(value: raw) -> raw
  fn sqlite3_value_blob(value: raw) -> raw
  fn sqlite3_result_null(context: raw)
  fn sqlite3_result_int64(context: raw, value: i64)
  fn sqlite3_result_double(context: raw, value: f64)
  fn sqlite3_result_text(context: raw, value: raw, bytes: i32, destroy: raw)
  fn sqlite3_result_blob(context: raw, value: raw, bytes: i32, destroy: raw)
  fn sqlite3_result_error(context: raw, message: raw, bytes: i32)
  fn sqlite3_result_error_nomem(context: raw)
}

SQLITE_OK: i32 := 0
SQLITE_OPEN_READONLY: i32 := 1
SQLITE_OPEN_READWRITE: i32 := 2
SQLITE_OPEN_CREATE: i32 := 4
SQLITE_OPEN_URI: i32 := 64
SQLITE_OPEN_NOMUTEX: i32 := 32768
SQLITE_OPEN_FULLMUTEX: i32 := 65536
SQLITE_OPEN_SHAREDCACHE: i32 := 131072
SQLITE_OPEN_PRIVATECACHE: i32 := 262144
SQLITE_BUSY_DEFAULT_MS: i32 := 0
SQLITE_TIMEOUT_MAX_MS: i64 := 2147483647
SQLITE_UTF8: i32 := 1
SQLITE_DETERMINISTIC: i32 := 2048
SQLITE_DIRECTONLY: i32 := 524288
SQLITE_CALLBACK_MIN_VERSION: i32 := 3030000

pub QueryOption {
  RequireVersionAtLeast(u32, u32, u32)
}

pub CommandOption {
  RequireVersionAtLeast(u32, u32, u32)
}

pub ConnectOption {
  OpenReadOnly
  OpenReadWrite
  Create
  Uri
  PrivateCache
  SharedCache
  NoMutex
  FullMutex
  BusyTimeoutNs(i64)
  Pragma(str, str)
}

pub ExecuteOption {
  BusyTimeoutNs(i64)
}

pub PrepareOption {
  Persistent
  Normalize
}

pub TxOption {
  Deferred
  Immediate
  Exclusive
}

pub MetaOption {
  IncludeInternalObjects
  IncludeHiddenColumns
}

pub ExplainOption {
  QueryPlan
  Bytecode
}

pub function_args {
  values: slice<pkg.db.value>,
}

pub scalar_function {}

pub FunctionOption {
  Deterministic
}

fn contract_error(item: str, message: str) -> pkg.db.Error = pkg.db.Error.Unsupported(
  pkg.db.ContractError {
    query_id: None,
    item: item.clone(),
    message: message.clone(),
  },
)

fn contains_nul(value: str) -> bool {
  bytes := value.bytes()
  mut i := 0
  loop {
    if i >= bytes.len() { break false }
    if bytes[i] == 0 { break true }
    i = i + 1
  }
}

fn c_string(value: str) -> raw {
  unsafe {
    output := raw.alloc(value.len() + 1)
    memcpy(output, value, value.len())
    nul: u8 := 0
    raw.store(output, value.len(), nul)
    return output
  }
}

fn copy_c_string(pointer: raw) -> string {
  unsafe {
    if pointer.is_null() { return "".clone() }
    mut output := buffer(64)
    mut i := 0
    loop {
      byte: u8 := raw.load(pointer, i)
      if byte == 0 { break }
      output.put_u8(byte)
      i = i + 1
    }
    text := output.bytes().as_str() else "invalid UTF-8 in SQLite error"
    return text.clone()
  }
}

fn sqlite_error(database: raw) -> pkg.db.Error {
  unsafe {
    primary := sqlite3_errcode(database)
    extended := sqlite3_extended_errcode(database)
    mut code_builder := builder()
    code_builder.write_int(primary)
    code := code_builder.to_string()
    message := copy_c_string(sqlite3_errmsg(database))
    return pkg.db.Error.Connection(pkg.db.NativeError {
      driver: pkg.db.Driver.SQLite,
      code: Some(code),
      extended_code: Some(extended as i64),
      sqlstate: None,
      message: message,
      detail: None,
      constraint: None,
      table: None,
      column: None,
    })
  }
}

fn sqlite_callback_snapshot_error(snapshot: raw) -> pkg.db.Error {
  unsafe {
    primary: i32 := raw.load(snapshot, 0)
    extended: i32 := raw.load(snapshot, 4)
    message_length: i64 := raw.load(snapshot, 8)
    mut output := buffer(message_length)
    mut i := 0
    loop {
      if i >= message_length { break }
      byte: u8 := raw.load(snapshot, 16 + i)
      output.put_u8(byte)
      i = i + 1
    }
    text := output.bytes().as_str() else "invalid UTF-8 in SQLite error"
    message := text.clone()
    raw.free(snapshot)
    mut code_builder := builder()
    code_builder.write_int(primary)
    code := code_builder.to_string()
    return pkg.db.Error.Connection(pkg.db.NativeError {
      driver: pkg.db.Driver.SQLite,
      code: Some(code),
      extended_code: Some(extended as i64),
      sqlstate: None,
      message: message,
      detail: None,
      constraint: None,
      table: None,
      column: None,
    })
  }
}

fn timeout_ms(ns: i64) -> Result<i32, pkg.db.Error> {
  if ns <= 0 {
    return Err(contract_error(
      "sqlite.connect.busy_timeout_ns",
      "SQLite busy timeout must be positive",
    ))
  }
  mut milliseconds := ns / 1000000
  if ns % 1000000 != 0 { milliseconds = milliseconds + 1 }
  if milliseconds > SQLITE_TIMEOUT_MAX_MS {
    return Err(contract_error(
      "sqlite.connect.busy_timeout_ns",
      "SQLite busy timeout exceeds the native i32 millisecond range",
    ))
  }
  return Ok(milliseconds as i32)
}

fn pragma_name_valid(name: str) -> bool {
  bytes := name.bytes()
  if bytes.len() == 0 { return false }
  first := bytes[0]
  first_alpha := (first >= 65 && first <= 90) || (first >= 97 && first <= 122)
  if !first_alpha && first != 95 { return false }
  mut i := 1
  loop {
    if i >= bytes.len() { break true }
    byte := bytes[i]
    alpha := (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)
    digit := byte >= 48 && byte <= 57
    if !alpha && !digit && byte != 95 { break false }
    i = i + 1
  }
}

fn pragma_sql(name: str, value: str) -> string {
  mut output := builder()
  output.write("PRAGMA ")
  output.write(name)
  output.write(" = '")
  bytes := value.bytes()
  mut start := 0
  mut i := 0
  loop {
    if i >= bytes.len() { break }
    if bytes[i] == 39 {
      output.write(value[start..i])
      output.write("''")
      start = i + 1
    }
    i = i + 1
  }
  output.write(value[start..value.len()])
  output.write("'")
  return output.to_string()
}

pub fn query_file<P, R>(
  options: slice<pkg.db.QueryOption>,
  native: slice<QueryOption>,
) -> pkg.db.query<P, R> = process.abort()

pub fn query<P, R>(
  sql: str,
  options: slice<pkg.db.QueryOption>,
  native: slice<QueryOption>,
) -> pkg.db.query<P, R> = process.abort()

pub fn command_file<P>(
  options: slice<pkg.db.CommandOption>,
  native: slice<CommandOption>,
) -> pkg.db.command<P> = process.abort()

pub fn command<P>(
  sql: str,
  options: slice<pkg.db.CommandOption>,
  native: slice<CommandOption>,
) -> pkg.db.command<P> = process.abort()

pub fn function(
  callback: fn(function_args) -> Result<pkg.db.value, str>,
) -> scalar_function = process.abort()

fn callback_driver_error() -> pkg.db.Error = pkg.db.Error.DriverMismatch(
  pkg.db.ContractError {
    query_id: None,
    item: "sqlite.callback.driver".clone(),
    message: "SQLite callbacks require a SQLite connection".clone(),
  },
)

fn callback_connection_error() -> pkg.db.Error = contract_error(
  "sqlite.callback.connection",
  "SQLite callbacks require an idle direct connection",
)

fn callback_name_valid(name: str) -> Result<(), pkg.db.Error> {
  if name.len() < 1 || name.len() > 255 {
    return Err(contract_error(
      "sqlite.callback.name",
      "SQLite callback name must contain 1 to 255 UTF-8 bytes",
    ))
  }
  if contains_nul(name) {
    return Err(pkg.db.Error.Encode(pkg.db.ContractError {
      query_id: None,
      item: "sqlite.callback.name".clone(),
      message: "SQLite callback name contains U+0000".clone(),
    }))
  }
  return Ok(())
}

fn callback_connection_valid(
  borrow mut connection: pkg.db.conn,
) -> Result<(), pkg.db.Error> {
  unsafe {
    candidate := resource.raw(resource.borrow(connection))
    if !pkg.db.internal.resource.conn_state_valid(candidate) {
      return Err(callback_connection_error())
    }
    if pkg.db.internal.resource.conn_driver_tag(candidate) != 1 {
      return Err(callback_driver_error())
    }
    origin: raw := raw.load(candidate, 32)
    lease: u8 := raw.load(candidate, 20)
    if !pkg.db.internal.resource.conn_live_for_driver(candidate, 1)
      || !origin.is_null()
      || lease != 0
      || pkg.db.internal.resource.transaction_active(candidate) {
      return Err(callback_connection_error())
    }
    database: raw := raw.load(candidate, 8)
    if database.is_null() || sqlite3_get_autocommit(database) != 1 {
      return Err(callback_connection_error())
    }
    if sqlite3_libversion_number() < SQLITE_CALLBACK_MIN_VERSION {
      return Err(contract_error(
        "sqlite.callback.version",
        "SQLite callbacks require SQLite 3.30.0 or newer",
      ))
    }
    return Ok(())
  }
}

fn callback_descriptor_valid(
  callback: scalar_function,
) -> Result<(), pkg.db.Error> {
  unsafe {
    candidate := pkg.db.internal.descriptor.sqlite_callback_data(callback)
    if candidate.is_null() { return Err(contract_error(
      "sqlite.callback.descriptor",
      "SQLite callback descriptor is invalid",
    )) }
    version: u32 := raw.load(candidate, 0)
    kind: u8 := raw.load(candidate, 4)
    effect: u8 := raw.load(candidate, 5)
    reserved: u16 := raw.load(candidate, 6)
    trampoline: raw := raw.load(candidate, 8)
    identity: raw := raw.load(candidate, 16)
    identity_length: i64 := raw.load(candidate, 24)
    if version != 1 || kind != 0 || effect > 1 || reserved != 0
      || trampoline.is_null() || identity.is_null()
      || identity_length <= 0 || identity_length > 4294967295 {
      return Err(contract_error(
        "sqlite.callback.descriptor",
        "SQLite callback descriptor is invalid",
      ))
    }
    mut i := 0
    loop {
      if i >= identity_length { break }
      byte: u8 := raw.load(identity, i)
      if byte == 0 {
        return Err(contract_error(
          "sqlite.callback.descriptor",
          "SQLite callback descriptor is invalid",
        ))
      }
      i = i + 1
    }
    terminator: u8 := raw.load(identity, identity_length)
    if terminator != 0 {
      return Err(contract_error(
        "sqlite.callback.descriptor",
        "SQLite callback descriptor is invalid",
      ))
    }
    return Ok(())
  }
}

fn callback_post_call_valid(state: raw, database: raw) -> bool {
  unsafe {
    if !pkg.db.internal.resource.conn_live_for_driver(state, 1) { return false }
    origin: raw := raw.load(state, 32)
    lease: u8 := raw.load(state, 20)
    return origin.is_null() && lease == 0
      && !pkg.db.internal.resource.transaction_active(state)
      && sqlite3_get_autocommit(database) == 1
  }
}

pub fn register_function(
  borrow mut connection: pkg.db.conn,
  name: str,
  arity: i32,
  callback: scalar_function,
  options: slice<FunctionOption>,
) -> Result<(), pkg.db.Error> {
  callback_connection_valid(connection)?
  callback_name_valid(name)?
  if arity < 0 || arity > 127 {
    return Err(contract_error(
      "sqlite.function.arity",
      "SQLite scalar function arity must be between 0 and 127",
    ))
  }
  mut deterministic := false
  mut i := 0
  loop {
    if i >= options.len() { break }
    match options[i] {
      Deterministic => {
        if deterministic {
          return Err(contract_error(
            "sqlite.function.option",
            "SQLite scalar function options are invalid",
          ))
        }
        deterministic = true
      }
    }
    i = i + 1
  }
  callback_descriptor_valid(callback)?
  unsafe {
    cb_state := resource.raw(resource.borrow(connection))
    cb_data := pkg.db.internal.descriptor.sqlite_callback_data(callback)
    effect: u8 := raw.load(cb_data, 5)
    if deterministic && effect != 0 {
      return Err(contract_error(
        "sqlite.function.deterministic",
        "SQLite deterministic functions require a Pure callback",
      ))
    }
    cb_database: raw := raw.load(cb_state, 8)
    cb_trampoline: raw := raw.load(cb_data, 8)
    cb_flags := SQLITE_UTF8 | SQLITE_DIRECTONLY
      | if deterministic { SQLITE_DETERMINISTIC } else { 0 }
    cb_snapshot := align_pkg_db_sqlite_register_v2(
      cb_database, name, name.len(), arity, cb_flags, cb_trampoline,
    )
    if !cb_snapshot.is_null() {
      pkg.db.internal.resource.poison_conn_state(cb_state)
      first := sqlite_callback_snapshot_error(cb_snapshot)
      return Err(first)
    }
    if !callback_post_call_valid(cb_state, cb_database) {
      pkg.db.internal.resource.poison_conn_state(cb_state)
      return Err(contract_error(
        "sqlite.callback.cleanup",
        "SQLite callback registration left the connection unusable",
      ))
    }
    return Ok(())
  }
}

pub fn remove_function(
  borrow mut connection: pkg.db.conn,
  name: str,
  arity: i32,
) -> Result<(), pkg.db.Error> {
  callback_connection_valid(connection)?
  callback_name_valid(name)?
  if arity < 0 || arity > 127 {
    return Err(contract_error(
      "sqlite.function.arity",
      "SQLite scalar function arity must be between 0 and 127",
    ))
  }
  unsafe {
    cb_state := resource.raw(resource.borrow(connection))
    cb_database: raw := raw.load(cb_state, 8)
    cb_snapshot := align_pkg_db_sqlite_register_v2(
      cb_database, name, name.len(), arity, SQLITE_UTF8 | SQLITE_DIRECTONLY, raw.null(),
    )
    if !cb_snapshot.is_null() {
      pkg.db.internal.resource.poison_conn_state(cb_state)
      first := sqlite_callback_snapshot_error(cb_snapshot)
      return Err(first)
    }
    if !callback_post_call_valid(cb_state, cb_database) {
      pkg.db.internal.resource.poison_conn_state(cb_state)
      return Err(contract_error(
        "sqlite.callback.cleanup",
        "SQLite callback registration left the connection unusable",
      ))
    }
    return Ok(())
  }
}

pub fn connect(path: str, options: slice<ConnectOption>) -> Result<pkg.db.conn, pkg.db.Error> {
  if contains_nul(path) {
    return Err(contract_error("sqlite.connect.path", "SQLite path contains U+0000"))
  }

  mut flags: i32 := SQLITE_OPEN_READWRITE
  mut saw_read_only := false
  mut saw_read_write := false
  mut saw_create := false
  mut saw_private_cache := false
  mut saw_shared_cache := false
  mut saw_no_mutex := false
  mut saw_full_mutex := false
  mut saw_busy_timeout := false
  mut busy_ms: i32 := SQLITE_BUSY_DEFAULT_MS
  mut i := 0
  loop {
    if i >= options.len() { break }
    match options[i] {
      OpenReadOnly => {
        if saw_read_only || saw_read_write || saw_create {
          return Err(contract_error(
            "sqlite.connect.open_mode",
            "SQLite read-only conflicts with read-write or create",
          ))
        }
        saw_read_only = true
        flags = (flags & ~SQLITE_OPEN_READWRITE) | SQLITE_OPEN_READONLY
      }
      OpenReadWrite => {
        if saw_read_write || saw_read_only {
          return Err(contract_error(
            "sqlite.connect.open_mode",
            "SQLite read-write conflicts with another open mode",
          ))
        }
        saw_read_write = true
      }
      Create => {
        if saw_create || saw_read_only {
          return Err(contract_error(
            "sqlite.connect.create",
            "SQLite create conflicts with read-only or another create option",
          ))
        }
        saw_create = true
        flags = flags | SQLITE_OPEN_CREATE
      }
      Uri => {
        if flags & SQLITE_OPEN_URI != 0 {
          return Err(contract_error("sqlite.connect.uri", "duplicate SQLite URI option"))
        }
        flags = flags | SQLITE_OPEN_URI
      }
      PrivateCache => {
        if saw_private_cache || saw_shared_cache {
          return Err(contract_error(
            "sqlite.connect.cache",
            "SQLite private cache conflicts with shared cache or a duplicate option",
          ))
        }
        saw_private_cache = true
        flags = flags | SQLITE_OPEN_PRIVATECACHE
      }
      SharedCache => {
        if saw_shared_cache || saw_private_cache {
          return Err(contract_error(
            "sqlite.connect.cache",
            "SQLite shared cache conflicts with private cache or a duplicate option",
          ))
        }
        saw_shared_cache = true
        flags = flags | SQLITE_OPEN_SHAREDCACHE
      }
      NoMutex => {
        if saw_no_mutex || saw_full_mutex {
          return Err(contract_error(
            "sqlite.connect.mutex",
            "SQLite no-mutex conflicts with full-mutex or a duplicate option",
          ))
        }
        saw_no_mutex = true
        flags = flags | SQLITE_OPEN_NOMUTEX
      }
      FullMutex => {
        if saw_full_mutex || saw_no_mutex {
          return Err(contract_error(
            "sqlite.connect.mutex",
            "SQLite full-mutex conflicts with no-mutex or a duplicate option",
          ))
        }
        saw_full_mutex = true
        flags = flags | SQLITE_OPEN_FULLMUTEX
      }
      BusyTimeoutNs(ns) => {
        if saw_busy_timeout {
          return Err(contract_error(
            "sqlite.connect.busy_timeout_ns",
            "duplicate SQLite busy timeout",
          ))
        }
        saw_busy_timeout = true
        busy_ms = timeout_ms(ns)?
      }
      Pragma(name, value) => {
        if !pragma_name_valid(name) {
          return Err(contract_error(
            "sqlite.connect.pragma.name",
            "SQLite PRAGMA name must match [A-Za-z_][A-Za-z0-9_]*",
          ))
        }
        if contains_nul(value) {
          return Err(contract_error(
            "sqlite.connect.pragma.value",
            "SQLite PRAGMA value contains U+0000",
          ))
        }
        mut earlier := 0
        loop {
          if earlier >= i { break }
          match options[earlier] {
            Pragma(previous, _) => {
              if previous.eq_ignore_ascii_case(name) {
                return Err(contract_error(
                  "sqlite.connect.pragma.name",
                  "duplicate SQLite PRAGMA name",
                ))
              }
            }
            _ => {}
          }
          earlier = earlier + 1
        }
      }
    }
    i = i + 1
  }

  unsafe {
    filename := c_string(path)
    database_out := raw.alloc(8)
    raw.store(database_out, 0, raw.null())
    status := sqlite3_open_v2(filename, database_out, flags, raw.null())
    raw.free(filename)
    database: raw := raw.load(database_out, 0)
    raw.free(database_out)
    if status != SQLITE_OK || database.is_null() {
      if database.is_null() {
        return Err(contract_error("sqlite.connect.open", "SQLite returned a null connection"))
      }
      failure := sqlite_error(database)
      closed := sqlite3_close_v2(database)
      return Err(failure)
    }

    extended_status := sqlite3_extended_result_codes(database, 1)
    if extended_status != SQLITE_OK {
      failure := sqlite_error(database)
      closed := sqlite3_close_v2(database)
      return Err(failure)
    }
    if saw_busy_timeout {
      timeout_status := sqlite3_busy_timeout(database, busy_ms)
      if timeout_status != SQLITE_OK {
        failure := sqlite_error(database)
        closed := sqlite3_close_v2(database)
        return Err(failure)
      }
    }

    mut pragma_index := 0
    loop {
      if pragma_index >= options.len() { break }
      match options[pragma_index] {
        Pragma(name, value) => {
          sql := pragma_sql(name, value)
          sql_c := c_string(sql)
          pragma_status := sqlite3_exec(
            database,
            sql_c,
            raw.null(),
            raw.null(),
            raw.null(),
          )
          raw.free(sql_c)
          if pragma_status != SQLITE_OK {
            failure := sqlite_error(database)
            closed := sqlite3_close_v2(database)
            return Err(failure)
          }
        }
        _ => {}
      }
      pragma_index = pragma_index + 1
    }

    state := pkg.db.internal.resource.new_conn_state(1, database, busy_ms)
    connection: pkg.db.conn := resource.from_raw(state)
    return Ok(connection)
  }
}

fn common_tx_options_valid(options: slice<pkg.db.TxOption>) -> Result<(), pkg.db.Error> {
  mut saw_timeout := false
  mut i := 0
  loop {
    if i >= options.len() { break }
    match options[i] {
      BeginTimeoutNs(ns) => {
        if ns <= 0 {
          return Err(contract_error(
            "db.transaction.begin_timeout_ns",
            "database transaction begin timeout must be positive",
          ))
        }
        if saw_timeout {
          return Err(contract_error(
            "db.transaction.begin_timeout_ns",
            "duplicate database transaction begin timeout",
          ))
        }
        saw_timeout = true
      }
    }
    i = i + 1
  }
  if saw_timeout {
    return Err(contract_error(
      "db.transaction.begin_timeout_ns",
      "SQLite does not support common transaction begin deadlines",
    ))
  }
  return Ok(())
}

pub fn prepare_native<P, R>(
  target: pkg.db.exec,
  statement: pkg.db.query<P, R>,
  options: slice<pkg.db.PrepareOption>,
  native: slice<PrepareOption>,
) -> Result<pkg.db.stmt<P, R>, pkg.db.Error> {
  if !pkg.db.internal.sqlite.query_header_valid(statement) {
    return Err(pkg.db.internal.sqlite.invalid_descriptor_error())
  }
  unsafe {
    query_id := pkg.db.internal.descriptor.descriptor_id(statement)
    mut saw_common_timeout := false
    mut common_index := 0
    loop {
      if common_index >= options.len() { break }
      match options[common_index] {
        TimeoutNs(ns) => {
          if ns <= 0 {
            return Err(pkg.db.internal.sqlite.descriptor_error(
              query_id,
              "db.prepare.timeout_ns",
              "database prepare timeout must be positive",
            ))
          }
          if saw_common_timeout {
            return Err(pkg.db.internal.sqlite.descriptor_error(
              query_id,
              "db.prepare.timeout_ns",
              "duplicate database prepare timeout",
            ))
          }
          saw_common_timeout = true
        }
      }
      common_index = common_index + 1
    }
    if saw_common_timeout {
      return Err(pkg.db.internal.sqlite.descriptor_error(
        query_id,
        "db.prepare.timeout_ns",
        "SQLite does not support common prepare deadlines",
      ))
    }
    mut flags: u32 := 0
    mut i := 0
    loop {
      if i >= native.len() { break }
      bit := match native[i] {
        Persistent => 1 as u32
        Normalize => 2 as u32
      }
      if flags & bit != 0 {
        return Err(pkg.db.internal.sqlite.descriptor_error(
          query_id,
          "sqlite.prepare.option",
          "duplicate SQLite prepare option",
        ))
      }
      flags = flags | bit
      i = i + 1
    }
    return pkg.db.internal.descriptor.prepare_sqlite(statement, target, query_id, flags)
  }
}

pub fn begin_native(
  connection: pkg.db.conn,
  options: slice<pkg.db.TxOption>,
  native: slice<TxOption>,
) -> Result<pkg.db.tx, pkg.db.Error> {
  common_tx_options_valid(options)?
  mut mode: i32 := 0
  mut i := 0
  loop {
    if i >= native.len() { break }
    selected := match native[i] { Deferred => 0, Immediate => 1, Exclusive => 2 }
    if mode != 0 || (i > 0 && selected == 0) {
      return Err(contract_error(
        "sqlite.transaction.mode",
        "SQLite transaction mode conflicts with another mode",
      ))
    }
    mode = selected + 1
    i = i + 1
  }
  unsafe {
    state := resource.raw(resource.borrow(connection))
    if state.is_null() || pkg.db.internal.resource.transaction_active(state) {
      return Err(contract_error(
        "sqlite.transaction.connection",
        "SQLite transaction requires an idle live connection",
      ))
    }
    if !pkg.db.internal.resource.conn_live_for_driver(state, 1) {
      return Err(contract_error(
        "sqlite.transaction.connection",
        "SQLite transaction requires an idle live SQLite connection",
      ))
    }
    database: raw := raw.load(state, 8)
    lease: u8 := raw.load(state, 20)
    if lease != 0 {
      return Err(contract_error(
        "sqlite.transaction.connection",
        "SQLite transaction requires an idle live SQLite connection",
      ))
    }
    sql := if mode == 2 { "BEGIN IMMEDIATE" } else {
      if mode == 3 { "BEGIN EXCLUSIVE" } else { "BEGIN DEFERRED" }
    }
    command := c_string(sql)
    status := sqlite3_exec(database, command, raw.null(), raw.null(), raw.null())
    raw.free(command)
    if status != SQLITE_OK { return Err(sqlite_error(database)) }
    pkg.db.internal.resource.set_transaction_active(state, true)
    transferred := resource.into_raw(connection)
    transaction: pkg.db.tx := resource.from_raw(transferred)
    return Ok(transaction)
  }
}

pub fn execute_native<P>(
  target: pkg.db.exec,
  statement: pkg.db.command<P>,
  params: P,
  options: slice<pkg.db.ExecuteOption>,
  native: slice<ExecuteOption>,
) -> Result<pkg.db.exec_result, pkg.db.Error> {
  if !pkg.db.internal.sqlite.command_header_valid(statement) {
    return Err(pkg.db.internal.sqlite.invalid_descriptor_error())
  }
  unsafe {
    query_id := pkg.db.internal.descriptor.descriptor_id(statement)
    pkg.db.internal.sqlite.common_options_valid(options, query_id)?
    mut timeout: Option<i32> := None
    mut i := 0
    loop {
      if i >= native.len() { break }
      match native[i] {
        BusyTimeoutNs(ns) => {
          converted := pkg.db.internal.sqlite.execution_timeout_ms(ns, query_id)?
          match timeout {
            Some(_) => {
              return Err(pkg.db.internal.sqlite.descriptor_error(
                query_id,
                "sqlite.execute.busy_timeout_ns",
                "duplicate SQLite busy timeout",
              ))
            }
            None => { timeout = Some(converted) }
          }
        }
      }
      i = i + 1
    }
    return pkg.db.internal.sqlite.execute_prevalidated(
      target, params, statement, query_id, timeout,
    )
  }
}

pub fn one_native<P, R: RegionPlain>(
  target: pkg.db.exec,
  statement: pkg.db.query<P, R>,
  params: P,
  out: region,
  options: slice<pkg.db.ExecuteOption>,
  native: slice<ExecuteOption>,
) -> Result<R, pkg.db.Error> {
  mut stream := rows_native(target, statement, params, options, native)?
  first := pkg.db.next(stream)?
  row := first else {
    return Err(pkg.db.Error.Cardinality(pkg.db.CardinalityError {
      expected_min: 1,
      expected_max: 1,
      observed_at_least: 0,
    }))
  }
  result := row.clone_in(out)
  has_second := unsafe { pkg.db.internal.descriptor.has_next_sqlite(stream) }?
  if has_second {
    return Err(pkg.db.Error.Cardinality(pkg.db.CardinalityError {
      expected_min: 1,
      expected_max: 1,
      observed_at_least: 2,
    }))
  }
  return Ok(result)
}

pub fn rows_native<P, R>(
  target: pkg.db.exec,
  statement: pkg.db.query<P, R>,
  params: P,
  options: slice<pkg.db.ExecuteOption>,
  native: slice<ExecuteOption>,
) -> Result<pkg.db.rows<R>, pkg.db.Error> {
  if !pkg.db.internal.sqlite.query_header_valid(statement) {
    return Err(pkg.db.internal.sqlite.invalid_descriptor_error())
  }
  unsafe {
    query_id := pkg.db.internal.descriptor.descriptor_id(statement)
    pkg.db.internal.sqlite.common_options_valid(options, query_id)?
    mut timeout: Option<i32> := None
    mut i := 0
    loop {
      if i >= native.len() { break }
      match native[i] {
        BusyTimeoutNs(ns) => {
          converted := pkg.db.internal.sqlite.execution_timeout_ms(ns, query_id)?
          match timeout {
            Some(_) => {
              return Err(pkg.db.internal.sqlite.descriptor_error(
                query_id,
                "sqlite.execute.busy_timeout_ns",
                "duplicate SQLite busy timeout",
              ))
            }
            None => { timeout = Some(converted) }
          }
        }
      }
      i = i + 1
    }
    return pkg.db.internal.sqlite.rows_prevalidated(
      target, params, statement, query_id, timeout,
    )
  }
}

SqliteMetaControls {
  include_system: bool,
  include_internal: bool,
  include_hidden: bool,
}

fn metadata_controls(
  options: slice<pkg.db.MetaOption>,
  native: slice<MetaOption>,
) -> Result<SqliteMetaControls, pkg.db.Error> {
  mut saw_timeout := false
  mut include_system := false
  mut common_index := 0
  loop {
    if common_index >= options.len() { break }
    match options[common_index] {
      TimeoutNs(ns) => {
        if ns <= 0 {
          return Err(contract_error(
            "db.meta.timeout_ns",
            "database metadata timeout must be positive",
          ))
        }
        if saw_timeout {
          return Err(contract_error(
            "db.meta.timeout_ns",
            "duplicate database metadata timeout",
          ))
        }
        saw_timeout = true
      }
      IncludeSystem => {
        if include_system {
          return Err(contract_error(
            "db.meta.include_system",
            "duplicate include-system metadata option",
          ))
        }
        include_system = true
      }
    }
    common_index = common_index + 1
  }
  if saw_timeout {
    return Err(contract_error(
      "db.meta.timeout_ns",
      "SQLite does not support common metadata deadlines",
    ))
  }

  mut include_internal := false
  mut include_hidden := false
  mut native_index := 0
  loop {
    if native_index >= native.len() { break }
    match native[native_index] {
      IncludeInternalObjects => {
        if include_internal {
          return Err(contract_error(
            "sqlite.meta.include_internal_objects",
            "duplicate SQLite internal-object metadata option",
          ))
        }
        include_internal = true
      }
      IncludeHiddenColumns => {
        if include_hidden {
          return Err(contract_error(
            "sqlite.meta.include_hidden_columns",
            "duplicate SQLite hidden-column metadata option",
          ))
        }
        include_hidden = true
      }
    }
    native_index = native_index + 1
  }
  return Ok(SqliteMetaControls {
    include_system: include_system,
    include_internal: include_internal,
    include_hidden: include_hidden,
  })
}

fn metadata_schema_valid(reference: pkg.db.SchemaRef) -> Result<(), pkg.db.Error> {
  if contains_nul(reference.name) {
    return Err(pkg.db.Error.Encode(pkg.db.ContractError {
      query_id: None,
      item: "metadata.schema".clone(),
      message: "metadata identifier contains U+0000".clone(),
    }))
  }
  return Ok(())
}

fn metadata_table_valid(reference: pkg.db.TableRef) -> Result<(), pkg.db.Error> {
  if contains_nul(reference.schema) {
    return Err(pkg.db.Error.Encode(pkg.db.ContractError {
      query_id: None,
      item: "metadata.table.schema".clone(),
      message: "metadata identifier contains U+0000".clone(),
    }))
  }
  if contains_nul(reference.name) {
    return Err(pkg.db.Error.Encode(pkg.db.ContractError {
      query_id: None,
      item: "metadata.table.name".clone(),
      message: "metadata identifier contains U+0000".clone(),
    }))
  }
  return Ok(())
}

fn metadata_live(target: pkg.db.exec) -> Result<(), pkg.db.Error> {
  unsafe {
    state := pkg.db.internal.sqlite.state_for(target)
    if state.is_null() {
      return Err(contract_error(
        "db.meta.exec",
        "database metadata requires a live SQLite connection",
      ))
    }
    driver := pkg.db.internal.resource.conn_driver_tag(state)
    if driver != 1 {
      return Err(pkg.db.Error.DriverMismatch(pkg.db.ContractError {
        query_id: None,
        item: "db.meta.driver".clone(),
        message: "SQLite metadata requires a SQLite connection".clone(),
      }))
    }
    if !pkg.db.internal.resource.conn_live_for_driver(state, 1) {
      return Err(contract_error(
        "db.meta.exec",
        "database metadata requires a live SQLite connection",
      ))
    }
    return Ok(())
  }
}

fn seal_metadata_controls(controls: SqliteMetaControls) -> pkg.db.internal.SqliteCatalogControls {
  return pkg.db.internal.SqliteCatalogControls {
    include_system: controls.include_system,
    include_internal: controls.include_internal,
    include_hidden: controls.include_hidden,
  }
}

pub fn meta_database_native(
  target: pkg.db.exec,
  detail: pkg.db.MetaDetail,
  out: region,
  options: slice<pkg.db.MetaOption>,
  native: slice<MetaOption>,
) -> Result<pkg.db.DatabaseMeta, pkg.db.Error> {
  controls := metadata_controls(options, native)?
  metadata_live(target)?
  return pkg.db.meta_database(target, detail, out, options)
}

pub fn meta_schemas_native(
  target: pkg.db.exec,
  detail: pkg.db.MetaDetail,
  out: region,
  options: slice<pkg.db.MetaOption>,
  native: slice<MetaOption>,
) -> Result<array<pkg.db.SchemaMeta>, pkg.db.Error> {
  controls := metadata_controls(options, native)?
  metadata_live(target)?
  return pkg.db.catalog_sqlite_schemas(
    target, detail, out, seal_metadata_controls(controls),
  )
}

pub fn meta_tables_native(
  target: pkg.db.exec,
  schema_filter: Option<pkg.db.SchemaRef>,
  detail: pkg.db.MetaDetail,
  out: region,
  options: slice<pkg.db.MetaOption>,
  native: slice<MetaOption>,
) -> Result<array<pkg.db.TableMeta>, pkg.db.Error> {
  controls := metadata_controls(options, native)?
  match schema_filter { Some(reference) => { metadata_schema_valid(reference)? } None => {} }
  metadata_live(target)?
  return pkg.db.catalog_sqlite_tables(
    target,
    schema_filter,
    detail,
    out,
    seal_metadata_controls(controls),
  )
}

pub fn meta_table_native(
  target: pkg.db.exec,
  table_ref: pkg.db.TableRef,
  detail: pkg.db.MetaDetail,
