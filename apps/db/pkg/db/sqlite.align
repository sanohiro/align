  native: slice<MetaOption>,
) -> Result<pkg.db.TableMeta, pkg.db.Error> {
  controls := metadata_controls(options, native)?
  metadata_table_valid(table_ref)?
  metadata_live(target)?
  return pkg.db.catalog_sqlite_table(
    target,
    table_ref,
    detail,
    out,
    seal_metadata_controls(controls),
  )
}

pub fn meta_columns_native(
